# agent-relay environment dispatcher.
#
# This file is committed to the repo and shared between host and remote
# (since the project is mounted via sshfs). It picks up a per-host file
# `.envrc.<hostname>` that is gitignored — each machine maintains its own
# without touching the shared dispatcher.
#
# Works in two modes:
#   1) direnv installed:  `direnv allow` once; auto-loads on cd.
#   2) no direnv:         `source .envrc` manually.
#
# Setup:
#   relay init --role same-host
#   # or, for explicit per-side config:
#   relay init --author <name> --peer <name> --sync <none|rsync>
#   source .envrc

LOCAL_ENVRC=".envrc.$(hostname -s)"

# direnv-only: tell it to also watch the per-host file so edits trigger reload.
# `watch_file` is a function direnv defines when sourcing .envrc; under plain
# `source .envrc` it's undefined and we skip gracefully.
if type watch_file >/dev/null 2>&1; then
  watch_file "$LOCAL_ENVRC"
fi

if [ -f "$LOCAL_ENVRC" ]; then
  # shellcheck disable=SC1090
  source "$LOCAL_ENVRC"
else
  echo "warning: no $LOCAL_ENVRC found." >&2
  echo "  Create one via: relay init --role same-host" >&2
  echo "  Or: relay init --author <name> --peer <name> --sync <none|rsync>" >&2
fi
