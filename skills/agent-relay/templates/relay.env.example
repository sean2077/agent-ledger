# agent-relay environment variables
#
# Copy this file to .relay.env at your project root, fill in values, then:
#   source .relay.env
# Or, if you have direnv installed, copy to .envrc and `direnv allow`.

# Role of this machine in the relay.
# host = local machine running Codex CLI (initiates sync)
# remote = remote machine running Claude Code (cannot sync back)
export RELAY_ROLE=host

# Your agent identity. Used as `author` field in published artifacts.
# Typical values: codex (on host), claude (on remote).
export RELAY_AUTHOR=codex

# Default peer (who you write to). Auto-derived from author if not set.
export RELAY_PEER=claude

# Absolute path to the .shared/ root on this machine.
# On host: the local mount path of the remote .shared directory.
# On remote: the actual .shared directory.
export RELAY_SHARED_ROOT="$PWD/.shared"

# Optional: project slug. If unset, derived from `basename $(git rev-parse --show-toplevel)`.
# export RELAY_PROJECT=myproj

# Required ONLY on host: SSH target and remote project path for `relay sync`.
# RELAY_REMOTE_PATH is the absolute path to the project root on the remote machine,
# NOT the mount path you see locally.
export RELAY_REMOTE_SSH=user@remote.example.com
export RELAY_REMOTE_PATH=/home/user/Workspace/myproj
