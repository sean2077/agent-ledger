# Per-host relay config for the HOST machine (Codex CLI side).
# Copy to .envrc.$(hostname -s) at the project root and source.
# Gitignored — not committed.

export RELAY_ROLE=host
export RELAY_AUTHOR=codex
export RELAY_PEER=claude
export RELAY_SHARED_ROOT="$PWD/.shared"

# --- RELAY_REMOTE_* are only needed for shape B (separate project copies
#     with rsync between them). If PROJECT_ROOT is itself the sshfs mount of
#     the remote project (shape A), leave these commented — `relay sync`
#     will detect the fuse mount and abort, and `relay preflight` skips the
#     check for them.

# Shape B only — uncomment and fill in:
# export RELAY_REMOTE_SSH=user@remote.example.com
# export RELAY_REMOTE_PATH=/home/user/Workspace/agent-ledger
