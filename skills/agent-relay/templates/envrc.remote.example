# Per-host relay config for the REMOTE machine (Claude Code side).
# Copy to .envrc.$(hostname -s) at the project root and source.
# Gitignored — not committed.
#
# NOTE: `RELAY_ROLE=host|remote` is the legacy vocabulary. v0.5+ prefers
# `RELAY_SYNC=none|rsync` (this side owns rsync transport, or doesn't).
# This template still works — RELAY_ROLE=remote maps to RELAY_SYNC=none —
# but it emits a deprecation warn in `relay preflight`. For same-host
# setups, prefer envrc.same-host.example.

export RELAY_ROLE=remote
export RELAY_AUTHOR=claude
export RELAY_PEER=codex
# Future-proof: explicit RELAY_SYNC overrides RELAY_ROLE in v0.5+ preflight.
# export RELAY_SYNC=none
export RELAY_SHARED_ROOT="$PWD/.shared"

# Remote cannot SSH back to host; sync vars not needed.
unset RELAY_REMOTE_SSH RELAY_REMOTE_PATH
