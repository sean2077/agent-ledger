{
  "_comment": "agent-relay managed hooks. Edits between _agent_relay_managed markers are owned by `relay hooks install/uninstall`. The {RELAY_HOOK_COMMAND} token is replaced by the installer with `<python_interpreter> <hook_script>` (both shell-quoted) so the command does not depend on the host's PATH for shebang resolution.",
  "hooks": {
    "SessionStart": [
      {
        "_agent_relay_managed": true,
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_COMMAND}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_agent_relay_managed": true,
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_COMMAND}",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "_agent_relay_managed": true,
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_COMMAND}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
