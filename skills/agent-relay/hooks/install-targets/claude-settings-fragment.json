{
  "_comment": "agent-relay managed hooks. Edits between _agent_relay_managed markers are owned by `relay hooks install/uninstall`. The {RELAY_HOOK_PATH} token is replaced by the installer with the absolute path to relay-hook.py.",
  "hooks": {
    "SessionStart": [
      {
        "_agent_relay_managed": true,
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_PATH}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_agent_relay_managed": true,
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_PATH}",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "_agent_relay_managed": true,
        "hooks": [
          {
            "type": "command",
            "command": "{RELAY_HOOK_PATH}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
