#!/usr/bin/env python3
"""relay — agent-relay file protocol CLI.

Single-file executable, Python 3.10+, stdlib only. See companion spec:
  skills/agent-relay/references/file-protocol.md

Commands:
  init         idempotently create shared root + sentinel; render .envrc
  preflight    env + mount + project + FS probes + POSIX mode + binding health
  whoami       print this instance's identity (author + agent session id) + binding
  bootstrap    create a new pair directory under .shared/ (binds the creator)
  status       list the bound pair's artifacts + readiness + active rule
  pairs        subcommands: list (+ --archived), archive, restore
               (declutter .shared/ by moving terminated pairs into _archive/)
  pair         subcommands: join, leave, ensure (bind this instance to a pair)
  claim        scaffold a new draft under .draft/
  publish      validate draft, atomically promote to published + sha256 + ready
  close        write CLOSED sentinel + update session.json (no edit to prior files)
  sync         rsync wrapper for the RELAY_SYNC=rsync side (push/pull,
               default and strict modes)
  wait         block until peer publishes; exit codes 0/10/11/12/130/2
  doctor       report (and optionally fix) stuck drafts, dead heartbeat
               pidfiles, abandoned sidecars
  heartbeat    subcommands: start, stop, tick (per-draft liveness daemon)
  hooks        subcommands: install, uninstall, status, doctor (Claude Code
               + Codex CLI hook integration)
"""

from __future__ import annotations

import argparse
import contextlib
import dataclasses
import errno
import hashlib
import io
import json
import os
import random
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path
from typing import Callable, Optional


RELAY_PACKAGE_DIR = Path(__file__).resolve().parent.parent

__version__ = "1.1.0"
SCHEMA_VERSION = 3
BINDING_SCHEMA_VERSION = 1

KINDS = {"plan", "review", "fix", "note", "question", "decision", "correction", "addendum"}
# Kinds whose semantics allow a `corrects:` back-reference (file-protocol §3).
# correction REQUIRES it; addendum MAY set it; all other kinds MUST NOT.
CORRECTS_KINDS = {"correction", "addendum"}
STATUSES = {"draft", "ready", "closed", "cancelled", "failed", "timed_out"}
# Terminal = "this artifact no longer requires a peer response": `wait` exits 12,
# discovery/reporting treat the pair as not-active. `timed_out` is terminal in
# THAT sense (the peer stops waiting) but, unlike the hard-terminal trio, it is a
# *pause* (the documented user-blocking escalation: `@user:` + --status
# timed_out), so the write/bind path may RESUME it in-thread once the user
# answers. HARD_TERMINAL_STATUSES end the pair for good — bootstrap a new one.
# See file-protocol.md §5 (session-active rule) and §6 (status semantics).
TERMINAL_STATUSES = {"closed", "cancelled", "failed", "timed_out"}
HARD_TERMINAL_STATUSES = {"closed", "cancelled", "failed"}
RESUMABLE_TERMINAL_STATUSES = TERMINAL_STATUSES - HARD_TERMINAL_STATUSES  # {"timed_out"}
PLACEHOLDER_MARKER = "TODO:"
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,47}$")
# Full pair slug = bootstrap's date prefix + a topic matching SLUG_RE. archive /
# restore compose a directory path from a user-supplied slug, so they validate
# against this stricter form (rejecting '/', '..', absolute paths, and the
# `_archive/<slug>` backdoor) before touching the filesystem.
PAIR_SLUG_RE = re.compile(r"^\d{8}-[a-z0-9][a-z0-9-]{0,47}$")
# Reserved top-level dir holding pairs moved aside by `relay pairs archive`.
# Sibling of `_relay`; iter_pair_dirs skips it so archived pairs leave every scan.
ARCHIVE_DIRNAME = "_archive"
NON_BLOCKING_PREFLIGHT_WARNS = {"fs.mtime_monotonic", "identity.peer"}
OWNER_KINDS = {"agent", "tool-process", "pidfile", "renewal-file", "none"}


class SchemaVersionError(Exception):
    """Raised when a ledger record's schema is invalid or unsupported."""

    def __init__(self, record_type: str, path: Path, found, supported: int, reason: str):
        self.record_type = record_type
        self.path = Path(path)
        self.found = found
        self.supported = supported
        self.reason = reason
        super().__init__(self._message())

    @property
    def code(self) -> str:
        return "unsupported_schema" if self.reason in {"future", "old"} else "invalid_schema"

    def to_dict(self) -> dict:
        return {
            "code": self.code,
            "record_type": self.record_type,
            "path": str(self.path),
            "found": self.found,
            "supported": self.supported,
            "reason": self.reason,
            "message": str(self),
        }

    def _message(self) -> str:
        label = f"{self.record_type} schema_version"
        if self.reason == "future":
            return (
                f"{label} {self.found!r} at {self.path} is newer than this relay "
                f"supports ({self.supported}); upgrade relay before reading this ledger"
            )
        if self.reason == "old":
            return (
                f"{label} {self.found!r} at {self.path} is older than this relay "
                f"supports ({self.supported}) and no compatibility adapter is available"
            )
        return (
            f"{label} at {self.path} is missing or non-integer; expected "
            f"{self.supported}"
        )


# ---------------------------------------------------------------------------
# atomic primitives
# ---------------------------------------------------------------------------

def atomic_write_bytes(target: Path, data: bytes, *, mode: int = 0o600) -> None:
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.parent / f".{target.name}.relay-{os.getpid()}-{uuid.uuid4().hex[:8]}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            raise
        os.replace(tmp, target)
        _fsync_dir(target.parent)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def atomic_write_text(target: Path, text: str, *, mode: int = 0o600) -> None:
    atomic_write_bytes(target, text.encode("utf-8"), mode=mode)


def atomic_reserve_text(target: Path, text: str, *, mode: int = 0o600) -> None:
    """Create `target` exclusively (O_CREAT|O_EXCL) then write+fsync.

    Used by `relay publish` to reserve the final `.md` path against
    truly-concurrent publishers (finding 2). `atomic_write_text` uses
    tmp+`os.replace`, which is atomic but UNCONDITIONAL — two writers
    can both pass an `exists()` check and then clobber each other via
    `os.replace`. This primitive raises `FileExistsError` instead.

    Note: unlike `atomic_write_text`, the final path is briefly visible
    in a partial-content state between create and fsync. The relay
    protocol gates consumer reads on the `.ready` sentinel (written
    last by the same publisher), so partial content is not observable
    to a protocol-compliant reader.
    """
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(text.encode("utf-8"))
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        try:
            target.unlink()
        except OSError:
            pass
        raise
    _fsync_dir(target.parent)


def atomic_write_json(target: Path, obj: dict, *, mode: int = 0o600) -> None:
    atomic_write_text(
        target,
        json.dumps(obj, indent=2, ensure_ascii=False) + "\n",
        mode=mode,
    )


def _fsync_dir(path: Path) -> None:
    try:
        fd = os.open(path, os.O_DIRECTORY)
    except (OSError, AttributeError):
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def sha256_of_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def now_iso() -> str:
    return datetime.now().astimezone().replace(microsecond=0).isoformat()


# ---------------------------------------------------------------------------
# FS behavior probes
# ---------------------------------------------------------------------------

@dataclasses.dataclass
class ProbeResult:
    name: str
    status: str
    detail: str
    elapsed_ms: int


def _probe_tmp_rename(root: Path) -> tuple[str, str]:
    tmp = root / ".relay-probe.tmp"
    target = root / ".relay-probe.target"
    try:
        payload = os.urandom(32)
        tmp.write_bytes(payload)
        os.replace(tmp, target)
        if target.read_bytes() != payload:
            return "fail", "readback mismatch after rename"
        return "pass", "tmp+rename atomic; readback matches"
    finally:
        for p in (tmp, target):
            try:
                p.unlink()
            except FileNotFoundError:
                pass


def _probe_mtime_monotonic(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-mtime"
    try:
        target.write_bytes(b"v1")
        m1 = target.stat().st_mtime_ns
        time.sleep(0.05)
        target.write_bytes(b"v2")
        m2 = target.stat().st_mtime_ns
        if m2 < m1:
            return "fail", f"mtime regressed: {m1} -> {m2}"
        if m2 == m1:
            return "warn", f"mtime unchanged ({m1}); coarse resolution"
        return "pass", f"mtime advanced {m2 - m1}ns"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_symlink_ops(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-symlink-target"
    link = root / ".relay-probe-symlink"
    try:
        target.write_bytes(b"x")
        try:
            os.symlink(target.name, link)
        except OSError as e:
            return "fail", f"symlink create unsupported: {e}"
        if os.readlink(link) != target.name:
            return "fail", "readlink mismatch"
        return "pass", "create / readlink ok"
    finally:
        for p in (link, target):
            try:
                if p.is_symlink() or p.exists():
                    p.unlink()
            except (FileNotFoundError, IsADirectoryError):
                pass


def _probe_sha256_stable(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-sha"
    try:
        payload = os.urandom(8192)
        target.write_bytes(payload)
        h1 = hashlib.sha256(target.read_bytes()).hexdigest()
        h2 = hashlib.sha256(target.read_bytes()).hexdigest()
        if h1 != h2:
            return "fail", "hash mismatch across reopen"
        return "pass", f"sha256 stable ({h1[:16]}..)"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_fsync_readback(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-fsync"
    try:
        payload = os.urandom(1024)
        with open(target, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        if target.read_bytes() != payload:
            return "fail", "fsync readback mismatch"
        return "pass", "fsync ok"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_posix_mode(root: Path, target_mode: int = 0o700) -> tuple[str, str]:
    actual = stat.S_IMODE(root.stat().st_mode)
    if actual == target_mode:
        return "pass", f"mode {actual:04o} matches target {target_mode:04o}"
    if actual & 0o002:
        return "fail", f"mode {actual:04o} world-writable"
    if actual & 0o077:
        return "warn", f"mode {actual:04o} exceeds target {target_mode:04o}"
    return "warn", f"mode {actual:04o} differs from target {target_mode:04o}"


_FS_PROBES: list[tuple[str, Callable[[Path], tuple[str, str]]]] = [
    ("tmp_rename", _probe_tmp_rename),
    ("mtime_monotonic", _probe_mtime_monotonic),
    ("symlink_ops", _probe_symlink_ops),
    ("sha256_stable", _probe_sha256_stable),
    ("fsync_readback", _probe_fsync_readback),
]


def run_probes(root: Path, posix_target: int = 0o700) -> list[ProbeResult]:
    out: list[ProbeResult] = []
    for name, fn in _FS_PROBES:
        t = time.monotonic()
        try:
            s, d = fn(root)
        except Exception as exc:
            s, d = "fail", f"{type(exc).__name__}: {exc}"
        out.append(ProbeResult(name, s, d, int((time.monotonic() - t) * 1000)))
    t = time.monotonic()
    try:
        s, d = _probe_posix_mode(root, posix_target)
    except Exception as exc:
        s, d = "fail", f"{type(exc).__name__}: {exc}"
    out.append(ProbeResult("posix_mode", s, d, int((time.monotonic() - t) * 1000)))
    return out


def _preflight_exit_code(checks: list[dict]) -> int:
    exit_code = 0
    for c in checks:
        status = c["status"]
        if status == "fail":
            return 2
        if (
            status == "warn"
            and c["name"] not in NON_BLOCKING_PREFLIGHT_WARNS
            and exit_code < 1
        ):
            exit_code = 1
    return exit_code


# ---------------------------------------------------------------------------
# Env loading
# ---------------------------------------------------------------------------

@dataclasses.dataclass
class Env:
    author: Optional[str]
    shared_root: Optional[Path]
    shared_root_source: str
    project: Optional[str]
    remote_ssh: Optional[str]
    remote_path: Optional[str]
    # `sync_raw` is the literal value from RELAY_SYNC (or None if unset).
    # Resolution lives in `_resolve_sync`; unset defaults to `none`.
    sync_raw: Optional[str] = None
    # Per-instance identity. `author` and `agent_session_id` are both produced
    # by resolve_identity(): the author is detected from the platform
    # signal (CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID), falling back to
    # RELAY_AUTHOR; the session id is the agent's OWN id, used only by the
    # binding registry to tell parallel pairs apart — NOT by the artifact
    # protocol (filenames / frontmatter still use `author`). See
    # short_instance_id() for the display form and binding_key() for the
    # collision-safe key. Runtime peer is derived from session.json via
    # resolve_peer(); RELAY_PEER is not loaded or consulted.
    agent_session_id: Optional[str] = None
    agent_session_id_source: str = "none"
    instance_id: Optional[str] = None
    # How `author` was determined ("platform-claude" | "platform-codex"
    # | "env-disambiguated" | "env" | "none") plus any identity diagnostics
    # ("author_conflict", "dual_platform"), surfaced by preflight / whoami.
    author_source: str = "none"
    identity_diagnostics: list = dataclasses.field(default_factory=list)


SYNC_VALUES = {"none", "rsync"}


def load_env() -> Env:
    shared = os.environ.get("RELAY_SHARED_ROOT")
    if shared:
        shared_path = Path(shared).expanduser().resolve()
        shared_root_source = "env"
    else:
        shared_path = default_shared_root()
        shared_root_source = "default" if shared_path else "unset"
    ident = resolve_identity()
    env = Env(
        author=ident.author,
        shared_root=shared_path,
        shared_root_source=shared_root_source,
        project=os.environ.get("RELAY_PROJECT") or None,
        remote_ssh=os.environ.get("RELAY_REMOTE_SSH") or None,
        remote_path=os.environ.get("RELAY_REMOTE_PATH") or None,
        sync_raw=os.environ.get("RELAY_SYNC") or None,
    )
    env.agent_session_id = ident.agent_session_id
    env.agent_session_id_source = ident.session_source
    env.instance_id = short_instance_id(ident.author, ident.agent_session_id)
    env.author_source = ident.author_source
    env.identity_diagnostics = list(ident.diagnostics)
    return env


def _short_hash(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()[:16]


def _instance_fallback_dir() -> Path:
    base = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return Path(base) / "relay" / f"u{os.getuid()}"


def _terminal_signal() -> tuple[str, str]:
    """Best-effort per-terminal discriminator for the degraded fallback id.

    Returns (signal, source). A source of 'degraded' means nothing
    distinguishes two same-author windows on this host — callers MUST NOT
    auto-join parallel same-author instances in that case (they'd collide on
    the same fallback id).
    """
    atuin = os.environ.get("ATUIN_SESSION")
    if atuin:
        return _short_hash(atuin), "atuin"
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        try:
            return _short_hash(os.ttyname(stream.fileno())), "tty"
        except (OSError, ValueError, AttributeError):
            continue
    return "shared", "degraded"


def resolve_instance_id(author: Optional[str]) -> tuple[Optional[str], str]:
    """Resolve this instance's agent session id. Never raises.

    Precedence: RELAY_AGENT_SESSION_ID (hook-injected) > CLAUDE_CODE_SESSION_ID
    (Claude Code) > CODEX_THREAD_ID (Codex) > a persisted per-terminal minted
    fallback, so multi-instance never hard-fails. The fallback is keyed by a
    terminal signal (atuin/tty); when no signal distinguishes two same-author
    windows the source is 'fallback-degraded' and auto-join must stay
    conservative.

    Returns (agent_session_id, source). The id is the FULL value — a binding
    key MUST hash the full id (see binding_key), never a truncated prefix, or
    same-author windows with time-prefixed ids (e.g. Codex CODEX_THREAD_ID)
    would collide.
    """
    if not author:
        return None, "none"
    override = os.environ.get("RELAY_AGENT_SESSION_ID")
    if override:
        return override, "env-override"
    claude = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if claude:
        return claude, "platform-claude"
    codex = os.environ.get("CODEX_THREAD_ID")
    if codex:
        return codex, "platform-codex"
    return _resolve_fallback_session_id(author)


def _resolve_fallback_session_id(author: str) -> tuple[str, str]:
    """Mint or look up a per-terminal fallback agent session id when no platform
    signal or RELAY_AGENT_SESSION_ID override is available. Never raises.

    A degraded signal (nothing distinguishes two same-author windows) yields an
    EPHEMERAL id — distinct per process, never persisted — so two windows can't
    collapse onto one binding/pair (same-author invariant). A stable signal
    (atuin/tty) yields a persisted id, so a binding survives across invocations.
    """
    sig, sig_source = _terminal_signal()
    if sig_source == "degraded":
        return uuid.uuid4().hex, "fallback-degraded"
    fdir = _instance_fallback_dir()
    fpath = fdir / f"instance-{author}-{sig}.id"
    try:
        existing = fpath.read_text(encoding="utf-8").strip()
        if existing:
            return existing, f"fallback-{sig_source}"
    except (OSError, ValueError):
        pass
    minted = uuid.uuid4().hex
    try:
        fdir.mkdir(parents=True, exist_ok=True)
        atomic_write_text(fpath, minted + "\n", mode=0o600)
    except OSError:
        pass  # even unpersisted, return the minted id so this run has identity
    return minted, f"fallback-{sig_source}"


def short_instance_id(author: Optional[str],
                      agent_session_id: Optional[str]) -> Optional[str]:
    """Human-facing short id (display / logs only). NEVER a filename or
    uniqueness key — see binding_key() for the collision-safe key."""
    if not author:
        return None
    if not agent_session_id:
        return author
    return f"{author}:{agent_session_id[:8]}"


# Platform session-id env vars that also identify *which* agent is running.
# This is the single source of truth for author auto-detection.
PLATFORM_AUTHOR_ENV = {
    "claude": "CLAUDE_CODE_SESSION_ID",
    "codex": "CODEX_THREAD_ID",
}


@dataclasses.dataclass
class Identity:
    """The resolved identity of the running agent instance.

    `author` is detected from the platform signal first (so RELAY_AUTHOR is no
    longer required for claude/codex), falling back to RELAY_AUTHOR for other
    markdown agents or odd setups. `author_source` and `diagnostics` let
    preflight / whoami explain how author was chosen and flag ambiguity.
    """
    author: Optional[str]
    author_source: str            # platform-claude | platform-codex | env-disambiguated | env | none
    agent_session_id: Optional[str]
    session_source: str           # env-override | platform-claude | platform-codex | fallback-* | none
    diagnostics: list             # subset of {"author_conflict", "dual_platform"}


def resolve_identity() -> Identity:
    """Detect author + agent session id from the environment. Never raises.

    Author precedence: a single platform signal wins (CLAUDE_CODE_SESSION_ID ->
    claude, CODEX_THREAD_ID -> codex); RELAY_AUTHOR is only a fallback for
    agents without a platform signal. If RELAY_AUTHOR disagrees with a single
    detected platform, the platform wins and "author_conflict" is recorded (so
    a stale .envrc can't silently mislabel the agent). If BOTH platform signals
    are present we refuse to guess by precedence: RELAY_AUTHOR may disambiguate
    (env-disambiguated), otherwise author is None ("dual_platform") and the
    fail-closed callers / preflight surface it.

    The session id stays author-aware: RELAY_AGENT_SESSION_ID override >
    the matching platform id > a per-terminal fallback. RELAY_AGENT_SESSION_ID
    only ever overrides the session id, never the author.
    """
    env_author = os.environ.get("RELAY_AUTHOR") or None
    override_sid = os.environ.get("RELAY_AGENT_SESSION_ID") or None
    present = [a for a, var in PLATFORM_AUTHOR_ENV.items() if os.environ.get(var)]
    diagnostics: list = []

    if len(present) == 1:
        author = present[0]
        author_source = f"platform-{author}"
        if env_author and env_author != author:
            diagnostics.append("author_conflict")  # platform wins; surface it
    elif len(present) >= 2:
        diagnostics.append("dual_platform")
        if env_author in present:
            author, author_source = env_author, "env-disambiguated"
        else:
            author, author_source = None, "none"  # refuse to guess
    elif env_author:
        author, author_source = env_author, "env"
    else:
        author, author_source = None, "none"

    if not author:
        return Identity(None, author_source, None, "none", diagnostics)

    # Author-aware session id (do NOT reuse resolve_instance_id's author-blind
    # platform precedence here — it would pick the wrong id under dual_platform).
    platform_var = PLATFORM_AUTHOR_ENV.get(author)
    platform_sid = os.environ.get(platform_var) if platform_var else None
    if override_sid:
        sid, ssrc = override_sid, "env-override"
    elif platform_sid:
        sid, ssrc = platform_sid, f"platform-{author}"
    else:
        sid, ssrc = _resolve_fallback_session_id(author)
    return Identity(author, author_source, sid, ssrc, diagnostics)


# ---------------------------------------------------------------------------
# Instance binding registry (v0.13)
#
# Maps an instance (author + its OWN agent session id) to the pair it is
# working in. Replaces the single global `.active-session` marker so two
# same-host instances can each track their own current pair. One file per
# instance under `.shared/_relay/bindings/` — atomic per-file writes, no
# global write contention, no lock (hence no deadlock).
# ---------------------------------------------------------------------------

_BINDING_UPDATE_MIN_INTERVAL = 60  # seconds; throttle last_seen writes (sshfs)


def binding_key(author: str, agent_session_id: str) -> str:
    """Collision-safe binding filename stem. Hashes the FULL agent session id
    (never a truncated prefix — time-prefixed ids like Codex CODEX_THREAD_ID
    would collide on a short prefix) and is filename-safe (hex + author slug),
    so no fragile char sanitizing is needed."""
    digest = hashlib.sha256(agent_session_id.encode("utf-8")).hexdigest()[:24]
    return f"{author}-{digest}"


def bindings_dir(root: Path) -> Path:
    return root / "_relay" / "bindings"


def binding_path(root: Path, author: str, agent_session_id: str) -> Path:
    return bindings_dir(root) / f"{binding_key(author, agent_session_id)}.json"


def _validate_schema_version(
    record: dict,
    *,
    record_type: str,
    path: Path,
    supported: int,
) -> None:
    found = record.get("schema_version")
    if type(found) is not int:
        raise SchemaVersionError(record_type, path, found, supported, "invalid")
    if found > supported:
        raise SchemaVersionError(record_type, path, found, supported, "future")
    if found < supported:
        raise SchemaVersionError(record_type, path, found, supported, "old")


def read_session_json(session: Path, *, require_supported: bool = True) -> dict:
    path = session / "session.json"
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise SchemaVersionError("session", path, None, SCHEMA_VERSION, "invalid") from exc
    if not isinstance(record, dict):
        raise SchemaVersionError("session", path, None, SCHEMA_VERSION, "invalid")
    if require_supported:
        _validate_schema_version(
            record, record_type="session", path=path, supported=SCHEMA_VERSION
        )
    return record


def read_binding(
    root: Path,
    author: str,
    agent_session_id: str,
    *,
    require_supported: bool = True,
) -> Optional[dict]:
    path = binding_path(root, author, agent_session_id)
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(record, dict):
        return None
    if require_supported:
        _validate_schema_version(
            record,
            record_type="binding",
            path=path,
            supported=BINDING_SCHEMA_VERSION,
        )
    return record


def write_binding(root: Path, binding: dict) -> None:
    p = binding_path(root, binding["author"], binding["agent_session_id"])
    p.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_json(p, binding, mode=0o600)


def delete_binding(root: Path, author: str, agent_session_id: str) -> None:
    """Remove this instance's binding file. Files ONLY — never signals a PID
    (bindings carry no PID; mirrors `_heartbeat_purge_files_only`)."""
    try:
        binding_path(root, author, agent_session_id).unlink(missing_ok=True)
    except OSError:
        pass


def list_bindings(root: Path, *, include_schema_errors: bool = False) -> list[dict]:
    d = bindings_dir(root)
    if not d.is_dir():
        return []
    out: list[dict] = []
    for p in sorted(d.glob("*.json")):
        try:
            record = json.loads(p.read_text(encoding="utf-8"))
            if not isinstance(record, dict):
                continue
            _validate_schema_version(
                record,
                record_type="binding",
                path=p,
                supported=BINDING_SCHEMA_VERSION,
            )
            out.append(record)
        except SchemaVersionError as exc:
            if include_schema_errors:
                out.append({"_schema_error": exc.to_dict(), "_path": str(p)})
        except (OSError, ValueError):
            continue
    return out


def binding_for_pair(root: Path, pair_slug: str) -> list[dict]:
    return [b for b in list_bindings(root) if b.get("pair_slug") == pair_slug]


def _binding_is_stale(binding: dict, *, threshold: Optional[int] = None) -> bool:
    if threshold is None:
        threshold = max(_wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60)
    last_seen = binding.get("last_seen")
    if not last_seen:
        return True
    try:
        age = (datetime.now().astimezone()
               - datetime.fromisoformat(last_seen)).total_seconds()
    except (ValueError, TypeError):
        return True
    return age > threshold


def _write_binding_record(root: Path, env: "Env", pair_slug: str) -> None:
    now = now_iso()
    try:
        prior = read_binding(root, env.author, env.agent_session_id)
    except SchemaVersionError as exc:
        raise SystemExit(f"relay: {exc}") from exc
    write_binding(root, {
        "schema_version": BINDING_SCHEMA_VERSION,
        "instance_id": env.instance_id,
        "author": env.author,
        "agent_session_id": env.agent_session_id,
        "pair_slug": pair_slug,
        "bound_at": (prior or {}).get("bound_at") or now,
        "last_seen": now,
    })


def join_pair(env: "Env", root: Path, pair_slug: str) -> int:
    """Bind this instance to `pair_slug`. Returns 0 (bound / already bound) or
    2 (refused: unknown/inactive pair, same-author conflict, or full).

    Capacity (2 slots) is an advisory soft check on the read path — there is no
    lock, so no deadlock: racing joiners each write their own file and the
    worst case is transient over-capacity, self-corrected on the next check.
    A full pair with a stale slot is reclaimable (delete_binding removes only
    the file). Same-author conflict is hard-refused because artifact routing is
    by agent name (`peer`), so claude+claude in one pair can't be addressed.
    """
    if not env.author or not env.agent_session_id:
        print("relay: cannot bind without a resolvable author identity (platform "
              "signal or RELAY_AUTHOR) and agent session id", file=sys.stderr)
        return 2
    if env.agent_session_id_source == "fallback-degraded":
        print("relay: agent session id is unresolved (degraded — no platform id, "
              "tty, or atuin); cannot hold a stable binding. Pass --pair-id per "
              "command, or export RELAY_AGENT_SESSION_ID to a stable per-window "
              "value.", file=sys.stderr)
        return 2
    if not PAIR_SLUG_RE.match(pair_slug):
        print(f"relay: invalid pair slug {pair_slug!r} (expected YYYYMMDD-topic)",
              file=sys.stderr)
        return 2
    session = root / pair_slug
    if not (session / "session.json").exists():
        print(f"relay: no pair {pair_slug!r} under {root}", file=sys.stderr)
        return 2
    try:
        # session_is_resumable, not session_is_active: an explicit `pair join`
        # may (re)bind to a `timed_out` (paused) pair so the peer can resume the
        # round after the user answers. Hard-terminal/closed pairs still refuse.
        usable = session_is_resumable(session)
    except SchemaVersionError as exc:
        print(f"relay: {exc}", file=sys.stderr)
        return 2
    if not usable:
        print(f"relay: pair {pair_slug!r} is not active", file=sys.stderr)
        return 2
    existing = binding_for_pair(root, pair_slug)
    if any(b.get("author") == env.author
           and b.get("agent_session_id") == env.agent_session_id
           for b in existing):
        _write_binding_record(root, env, pair_slug)  # idempotent refresh
        return 0
    if any(b.get("author") == env.author and not _binding_is_stale(b)
           for b in existing):
        print(f"relay: pair {pair_slug!r} already has a live {env.author!r} "
              f"instance; same-author pairs can't be routed (peer is by agent "
              f"name). Join a different pair; a pair's two members must be "
              f"different agents (e.g. claude + codex).",
              file=sys.stderr)
        return 2
    if len(existing) >= 2:
        stale = [b for b in existing if _binding_is_stale(b)]
        if not stale:
            print(f"relay: pair {pair_slug!r} is full (2 live instances bound)",
                  file=sys.stderr)
            return 2
        for b in stale:
            delete_binding(root, b.get("author", ""), b.get("agent_session_id", ""))
    _write_binding_record(root, env, pair_slug)
    return 0


def _maybe_update_binding_last_seen(env: "Env", root: Path) -> None:
    """Best-effort, throttled refresh of this instance's binding liveness.
    No-op if unbound or identity unresolved. Never raises."""
    if not env.author or not env.agent_session_id:
        return
    try:
        b = read_binding(root, env.author, env.agent_session_id)
        if not b:
            return
        last = b.get("last_seen")
        if last:
            try:
                age = (datetime.now().astimezone()
                       - datetime.fromisoformat(last)).total_seconds()
                if age < _BINDING_UPDATE_MIN_INTERVAL:
                    return
            except (ValueError, TypeError):
                pass
        b["last_seen"] = now_iso()
        write_binding(root, b)
    except (OSError, SchemaVersionError):
        pass


def _resolve_sync(env: Env, *, is_shape_a: bool) -> tuple[Optional[str], str]:
    """Return (effective_sync, source) where source is 'env', 'default',
    or 'env-invalid'. `effective_sync` is in SYNC_VALUES or None.

    Precedence: explicit RELAY_SYNC wins; unset defaults to `none`.
    """
    if env.sync_raw is not None:
        if env.sync_raw in SYNC_VALUES:
            return env.sync_raw, "env"
        return None, "env-invalid"
    return "none", "default"


def git_toplevel(start: Path | None = None) -> Optional[Path]:
    start = start or Path.cwd()
    try:
        res = subprocess.run(
            ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=False,
        )
        if res.returncode != 0:
            return None
        return Path(res.stdout.strip())
    except FileNotFoundError:
        return None


def default_shared_root(start: Path | None = None) -> Optional[Path]:
    """Project-local shared root used when RELAY_SHARED_ROOT is not exported."""
    top = git_toplevel(start)
    if top is None:
        return None
    return (top / ".shared").resolve()


def sanitize_project_slug(raw: str) -> str:
    """Coerce an arbitrary directory name into a SLUG_RE-matching slug.

    git toplevel names legally contain dots, underscores, and capitals
    (`actibot_ego.jy`, `MyProject`); SLUG_RE does not. Lower-case the
    name, fold any run of non-slug chars into a single hyphen, trim
    leading/trailing hyphens, and clip to 48 chars. Explicit user input
    via RELAY_PROJECT bypasses this — callers validate that separately.
    """
    s = raw.lower()
    s = re.sub(r"[^a-z0-9-]+", "-", s)
    s = s.strip("-")
    return s[:48]


def derive_project(env: Env) -> Optional[str]:
    if env.project:
        return env.project
    top = git_toplevel()
    if not top:
        return None
    return sanitize_project_slug(top.name) or None


# ---------------------------------------------------------------------------
# Frontmatter (minimal YAML subset)
# ---------------------------------------------------------------------------

_FM_RE = re.compile(r"^---\n(.*?\n)---\n?(.*)$", re.DOTALL)


def parse_frontmatter(text: str) -> tuple[dict, str]:
    m = _FM_RE.match(text)
    if not m:
        raise ValueError("no frontmatter found (expected --- ... --- at start)")
    return _parse_yaml_subset(m.group(1)), m.group(2)


def _parse_yaml_subset(text: str) -> dict:
    out: dict = {}
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith("#"):
            i += 1
            continue
        if ":" not in line:
            raise ValueError(f"bad frontmatter line: {line!r}")
        key, _, rest = line.partition(":")
        key = key.strip()
        rest = rest.rstrip()
        if rest.strip() == "|":
            block: list[str] = []
            i += 1
            indent: Optional[int] = None
            while i < len(lines):
                ln = lines[i]
                if not ln.strip():
                    block.append("")
                    i += 1
                    continue
                lead = len(ln) - len(ln.lstrip())
                if indent is None:
                    indent = lead
                if lead < indent:
                    break
                block.append(ln[indent:])
                i += 1
            out[key] = "\n".join(block).rstrip() + ("\n" if block else "")
            continue
        if rest.strip() == "[]":
            out[key] = []
            i += 1
            continue
        if rest.strip() == "":
            items: list = []
            i += 1
            while i < len(lines):
                ln = lines[i]
                if not ln.strip():
                    i += 1
                    continue
                stripped = ln.lstrip()
                if stripped.startswith("- "):
                    items.append(_scalar(stripped[2:].strip()))
                    i += 1
                    continue
                break
            out[key] = items
            continue
        out[key] = _scalar(rest.strip())
        i += 1
    return out


def _scalar(s: str):
    if s in ("", "null", "~"):
        return None
    if s == "true":
        return True
    if s == "false":
        return False
    if (s.startswith('"') and s.endswith('"')) or (s.startswith("'") and s.endswith("'")):
        return s[1:-1]
    try:
        return int(s)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return s


def dump_frontmatter(d: dict, body: str = "") -> str:
    lines = ["---"]
    for k, v in d.items():
        if v is None:
            lines.append(f"{k}: null")
        elif v is True:
            lines.append(f"{k}: true")
        elif v is False:
            lines.append(f"{k}: false")
        elif isinstance(v, list):
            if not v:
                lines.append(f"{k}: []")
            else:
                lines.append(f"{k}:")
                for it in v:
                    lines.append(f"  - {it}")
        elif isinstance(v, str) and "\n" in v:
            lines.append(f"{k}: |")
            for ln in v.rstrip("\n").splitlines():
                lines.append(f"  {ln}")
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    if body and not body.startswith("\n"):
        lines.append("")
    return "\n".join(lines) + "\n" + body


# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------

def session_root(env: Env) -> Path:
    if not env.shared_root:
        raise SystemExit("RELAY_SHARED_ROOT not set")
    return env.shared_root


def iter_pair_dirs(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    sessions: list[Path] = []
    for sd in sorted(root.iterdir()):
        if not sd.is_dir() or sd.name.startswith(".") or sd.name in ("_relay", ARCHIVE_DIRNAME):
            continue
        if (sd / "session.json").exists():
            sessions.append(sd)
    return sessions


def active_pair_dirs(root: Path) -> list[Path]:
    sessions: list[Path] = []
    for sd in iter_pair_dirs(root):
        try:
            if session_is_active(sd):
                sessions.append(sd)
        except SchemaVersionError:
            continue
    return sessions


def pair_schema_errors(root: Path) -> list[SchemaVersionError]:
    errors: list[SchemaVersionError] = []
    for sd in iter_pair_dirs(root):
        try:
            read_session_json(sd)
        except SchemaVersionError as exc:
            errors.append(exc)
    return errors


def archive_root(root: Path) -> Path:
    """Top-level archive area `.shared/_archive/` (sibling of `_relay`). Archived
    pair dirs live one level under it; iter_pair_dirs skips the name, so they
    disappear from every pair scan (status / wait / doctor / pairs list /
    active-pair resolution)."""
    return root / ARCHIVE_DIRNAME


def _require_valid_pair_slug(slug: str, cmd: str) -> str:
    """Fail closed unless `slug` is a well-formed full pair slug.

    archive / restore compose a directory path from a user-supplied slug; a value
    containing '/', '..', an absolute path, or the `_archive/<slug>` backdoor must
    be refused before any path is built — never silently resolve to the wrong
    tree. Returns the slug on success; raises SystemExit otherwise."""
    if not PAIR_SLUG_RE.match(slug):
        raise SystemExit(
            f"relay {cmd}: invalid pair slug {slug!r} — expected the bootstrap form "
            "YYYYMMDD-topic (lowercase ascii/digits/'-'). Run `relay pairs list`."
        )
    return slug


def _move_pair_dir(src: Path, dst: Path) -> None:
    """Atomically move a pair directory src -> dst, fail closed.

    Caller pre-checks: src exists, dst does NOT, slug valid. `_archive` is inside
    the same `.shared` mount as live pairs, so this is a same-device rename
    (atomic). We deliberately do NOT fall back to a cross-device copy+rmtree
    (shutil.move): a partial destination would break the "source stays intact on
    failure" recovery model — EXDEV fails closed instead. fsync BOTH parents so
    the created dir entry (dst.parent) and the removed one (src.parent) are
    durable on the sshfs mount."""
    if dst.exists():
        raise FileExistsError(dst)
    try:
        os.rename(src, dst)
    except OSError as exc:
        if exc.errno == errno.EXDEV:
            raise OSError(
                errno.EXDEV,
                f"refuse to move {src.name!r} across devices; {ARCHIVE_DIRNAME} "
                "must sit inside the same .shared mount as live pairs "
                "(check RELAY_SHARED_ROOT / the mount point)",
            )
        raise
    _fsync_dir(src.parent)
    _fsync_dir(dst.parent)


def resolve_pair(env: Env, session_id: str | None = None, *,
                    project: str | None = None, require_active: bool = False,
                    allow_resumable: bool = False) -> Path:
    root = session_root(env)
    if not root.is_dir():
        raise SystemExit(f"no shared root: {root}")
    if session_id:
        _require_valid_pair_slug(session_id, "pair --pair-id")
        candidate = root / session_id
        if not (candidate / "session.json").exists():
            raise SystemExit(f"no pair {session_id!r} under {root}")
        try:
            read_session_json(candidate)
        except SchemaVersionError as exc:
            raise SystemExit(f"relay: {exc}") from exc
        # allow_resumable lets the write/bind path supersede a `timed_out`
        # latest (resume); the hard-terminal trio still fails closed.
        usable = (session_is_resumable(candidate) if allow_resumable
                  else session_is_active(candidate))
        if require_active and not usable:
            raise SystemExit(f"pair is not active: {session_id}")
        return candidate
    if require_active:
        return resolve_active_pair(env, project, allow_resumable=allow_resumable)
    raise SystemExit("pair_id is required unless resolving the active pair")


def resolve_active_pair(env: Env, project: str | None = None,
                           pair_id: str | None = None, *,
                           require_binding: bool = False,
                           allow_resumable: bool = False) -> "Path | None":
    """Resolve which pair a command operates on.

    Order (v0.13): explicit --pair-id > this instance's binding (if it still
    names an active pair) > the sole active pair > else refuse and list
    candidates. Per-instance bindings replace the old single global
    `.active-session` marker, so parallel pairs on one host each resolve to
    their own pair. A stale binding (its pair gone/inactive) is self-healed.

    require_binding=True (passive automation, e.g. the Stop hook) DISABLES the
    sole-active fallback: only an explicit --pair-id or a live binding for this
    (author, agent_session_id) resolves; otherwise return None. This is the
    identity boundary — handing an unbound instance the lone active pair it
    never joined is the cross-talk bug (issue 20260601T182646-2920d5b9). Bare
    interactive `relay status` keeps the fallback (require_binding=False).

    allow_resumable=True (the write/bind path, e.g. `claim`) returns a pair whose
    latest artifact is `timed_out` (resumable pause) as well as a fully active
    one. Independently — and regardless of allow_resumable — the binding is only
    GC'd when its pair is truly dead (gone, or hard-terminal/closed): a paused
    `timed_out` pair KEEPS its binding so the round can be resumed even after a
    plain `status --require-binding` (the Stop hook) resolves it. Deleting the
    binding on a mere pause was the latent half of the timed_out-resume deadlock
    (issue 20260529T190821-0ec54be9).
    """
    root = session_root(env)
    if not root.is_dir():
        raise SystemExit(f"no shared root: {root}")
    _maybe_update_binding_last_seen(env, root)
    if pair_id:
        return resolve_pair(env, pair_id, project=project, require_active=True,
                            allow_resumable=allow_resumable)

    # This instance's binding wins (fast path) when it still names a pair this
    # caller may use. A `timed_out` pair is a pause, not death: keep the binding
    # (so the round survives a status/wait resolve) and return it only when the
    # caller allows resume. Drop the binding only when the pair is truly dead.
    if env.author and env.agent_session_id:
        try:
            b = read_binding(root, env.author, env.agent_session_id)
        except SchemaVersionError as exc:
            raise SystemExit(f"relay: {exc}") from exc
        if b:
            slug = b.get("pair_slug")
            cand = root / slug if slug else None
            resumable = False
            if cand and (cand / "session.json").exists():
                try:
                    resumable = session_is_resumable(cand)
                    usable = resumable if allow_resumable else session_is_active(cand)
                except SchemaVersionError as exc:
                    raise SystemExit(f"relay: {exc}") from exc
                if usable:
                    return cand
            if not resumable:
                delete_binding(root, env.author, env.agent_session_id)

    if require_binding:
        # Strict: no explicit --pair-id and no confirmed binding ⇒ refuse the
        # sole-active fallback rather than guess. The caller emits a
        # non-actionable result; this is the boundary that keeps an unbound
        # session out of a pair it never joined.
        return None

    # session_is_active() honors state, CLOSED sentinel, AND latest artifact
    # status (so stale-active pairs with terminal latest artifacts are excluded).
    try:
        candidates = active_pair_dirs(root)
    except SchemaVersionError as exc:
        raise SystemExit(f"relay: {exc}") from exc
    if not candidates:
        raise SystemExit(f"no active pair under {root}")
    if len(candidates) > 1:
        names = ", ".join(s.name for s in candidates)
        raise SystemExit(
            "multiple active pairs; run `relay pair join <slug>` to bind to one "
            f"(or pass --pair-id): {names}"
        )
    return candidates[0]


def default_peer(author: str) -> Optional[str]:
    """The conventional peer for a canonical agent in a claude<->codex pair.
    Returns None for any other author, which must name its peer explicitly
    (e.g. `relay bootstrap --peer <name>`)."""
    return {"claude": "codex", "codex": "claude"}.get(author)


def resolve_peer(session_dir: Path, author: str) -> Optional[str]:
    """Derive `author`'s peer from the pair's session.json participants.

    A pair has exactly two participants; the peer is the one that isn't us.
    Fail closed (return None) when participants are malformed, not exactly two,
    don't contain `author`, or leave no single other party — callers must
    handle a None peer rather than guess. Runtime peer derivation lives here so
    RELAY_PEER is no longer consulted; session.json is the source of
    truth once a pair exists."""
    try:
        sj = read_session_json(session_dir)
    except SchemaVersionError as exc:
        if exc.code == "invalid_schema":
            return None
        raise
    except (OSError, ValueError):
        return None
    participants = sj.get("participants")
    if not isinstance(participants, list) or len(participants) != 2:
        return None
    others = [p for p in participants if p != author]
    return others[0] if len(others) == 1 else None


def list_published(session: Path) -> list[Path]:
    """Return published artifacts whose sidecars are present AND sha256 matches.

    Sidecar mere existence is not enough — a stale `.sha256` after post-publish
    tampering would otherwise silently pass consumers. We re-hash the .md and
    compare against the sidecar's first field (sha256sum format: '<hex>  <name>').
    """
    out: list[Path] = []
    for f in sorted(session.glob("[0-9][0-9][0-9]-*.md")):
        base = f.name[:-3]  # drop .md → NNN-author-kind
        ready_path = session / f"{base}.ready"
        sha_path = session / f"{f.name}.sha256"
        if not (ready_path.exists() and sha_path.exists()):
            continue
        try:
            expected = sha_path.read_text().split()[0].strip()
            actual = sha256_of_file(f)
        except (OSError, IndexError):
            continue
        if expected.lower() != actual.lower():
            continue  # tampered or partial; treat as not published
        out.append(f)
    return out


def _published_triad_findings(session: Path) -> list[dict]:
    """Return published-position files that are not valid readable triads."""
    findings: list[dict] = []
    bases: set[str] = set()

    for md in sorted(session.glob("[0-9][0-9][0-9]-*.md")):
        base = md.name[:-3]  # drop .md -> NNN-author-kind
        bases.add(base)
        paths = published_paths(session, base)
        problems: list[str] = []

        if not paths["sha256"].exists():
            problems.append("missing_sha256")
        else:
            try:
                expected = paths["sha256"].read_text().split()[0].strip()
                actual = sha256_of_file(md)
            except OSError:
                problems.append("sha256_unreadable")
            except IndexError:
                problems.append("sha256_empty")
            else:
                if expected.lower() != actual.lower():
                    problems.append("sha256_mismatch")

        if not paths["ready"].exists():
            problems.append("missing_ready")

        if problems:
            findings.append(_triad_finding(session, base, problems))

    sidecar_bases: dict[str, set[str]] = {}
    for sha in sorted(session.glob("[0-9][0-9][0-9]-*.md.sha256")):
        base = sha.name[:-len(".md.sha256")]
        if base not in bases and not (session / f"{base}.md").exists():
            sidecar_bases.setdefault(base, set()).add("orphan_sha256")
    for ready in sorted(session.glob("[0-9][0-9][0-9]-*.ready")):
        base = ready.name[:-len(".ready")]
        if base not in bases and not (session / f"{base}.md").exists():
            sidecar_bases.setdefault(base, set()).add("orphan_ready")
    for base in sorted(sidecar_bases):
        findings.append(_triad_finding(session, base, sorted(sidecar_bases[base])))

    return findings


def _triad_finding(session: Path, base: str, problems: list[str]) -> dict:
    paths = published_paths(session, base)
    existing_paths = [p for p in paths.values() if p.exists()]
    mtimes: list[float] = []
    for p in existing_paths:
        try:
            mtimes.append(p.stat().st_mtime)
        except OSError:
            pass
    age_seconds = int(time.time() - max(mtimes)) if mtimes else None
    draft_path = session / ".draft" / f"{base}.md"
    return {
        "base": base,
        "name": f"{base}.md",
        "problems": problems,
        "age_seconds": age_seconds,
        "paths": {k: str(v) for k, v in paths.items() if v.exists()},
        "matching_draft": draft_path.name if draft_path.exists() else None,
    }


def latest_seq(session: Path) -> int:
    """Max seq across published artifacts AND in-flight drafts.

    Used by claim-time reservation so a new draft never overlaps an
    in-flight one. NOT safe as a `relay wait` baseline — see
    `latest_published_seq()` for that case (finding 1).
    """
    seqs: list[int] = []
    for f in session.glob("[0-9][0-9][0-9]-*.md"):
        try:
            seqs.append(int(f.name[:3]))
        except ValueError:
            pass
    draft = session / ".draft"
    if draft.is_dir():
        for f in draft.glob("[0-9][0-9][0-9]-*.md"):
            try:
                seqs.append(int(f.name[:3]))
            except ValueError:
                pass
    return max(seqs) if seqs else 0


def latest_published_seq(session: Path) -> int:
    """Max seq across .ready-published artifacts only (excludes .draft/).

    Used by `relay wait` to compute its baseline. Including drafts
    here would mask the peer publishing the very draft they had open
    when wait entered (finding 1: the published seq equals the draft
    seq, and the old `latest_seq()` baseline filtered it out).
    """
    seqs: list[int] = []
    for p in list_published(session):
        try:
            seqs.append(int(p.name[:3]))
        except ValueError:
            pass
    return max(seqs) if seqs else 0


def published_paths(session: Path, base: str) -> dict[str, Path]:
    """base = 'NNN-author-kind' (no .md). Returns dict of expected paths."""
    return {
        "md": session / f"{base}.md",
        "sha256": session / f"{base}.md.sha256",
        "ready": session / f"{base}.ready",
    }


def _session_open(session: Path, terminal: set[str]) -> bool:
    """Core open-pair predicate (file-protocol.md §5): session.json `state` is
    'active', no CLOSED sentinel, and the latest published artifact's status is
    not in `terminal`. `session_is_active` passes the full TERMINAL_STATUSES;
    `session_is_resumable` passes only HARD_TERMINAL_STATUSES so a `timed_out`
    latest stays writable. Propagates SchemaVersionError to the caller."""
    sj = session / "session.json"
    if not sj.exists():
        return False
    data = read_session_json(session)
    if data.get("state") != "active":
        return False
    if (session / "CLOSED").exists():
        return False
    pub = list_published(session)
    if not pub:
        return True  # bootstrapped, no artifacts yet
    latest = pub[-1]
    try:
        fm, _ = parse_frontmatter(latest.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return True  # malformed; conservatively keep open
    return fm.get("status") not in terminal


def session_is_active(session: Path) -> bool:
    """Implements the session-active rule from file-protocol.md §5. A terminal
    latest — INCLUDING `timed_out` — makes the pair not-active. This is the
    predicate for `wait` (peer stops waiting, exit 12), discovery
    (`active_pair_dirs`), and reporting."""
    return _session_open(session, TERMINAL_STATUSES)


def session_is_resumable(session: Path) -> bool:
    """Like `session_is_active`, but a `timed_out` latest is RESUMABLE rather
    than terminal. The write/bind path (`claim`, `publish`, `pair join`,
    `pair ensure`) uses this so the documented user-blocking pause (`@user:` +
    --status timed_out) can be continued in-thread after the user answers; the
    hard-terminal trio (closed/cancelled/failed) and a CLOSED sentinel stay
    non-resumable. See file-protocol.md §5/§6."""
    return _session_open(session, HARD_TERMINAL_STATUSES)


def latest_artifact_frontmatter(session: Path) -> dict | None:
    pub = list_published(session)
    if not pub:
        return None
    try:
        fm, _ = parse_frontmatter(pub[-1].read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return fm


def session_category(session: Path) -> str:
    try:
        if session_is_active(session):
            return "active"
    except SchemaVersionError as exc:
        return exc.code
    if (session / "CLOSED").exists():
        return "closed"
    try:
        sj = read_session_json(session)
    except SchemaVersionError as exc:
        return exc.code
    except OSError:
        return "invalid"
    if sj.get("state") == "closed":
        return "closed"
    fm = latest_artifact_frontmatter(session)
    if fm and fm.get("status") in TERMINAL_STATUSES:
        return "terminal"
    return "inactive"


def _check_binding_health(root: Path, env: Env) -> dict:
    """Replaces the old `.active-session` marker check. Reports whether THIS
    instance's binding points at a live pair. Having no binding is normal on a
    first turn (before `pair ensure`/`bootstrap`), so it stays non-blocking
    unless multiple active pairs make a choice necessary."""
    name = "pair.binding"
    if not env.author or not env.agent_session_id:
        return {"name": name, "status": "pass",
                "detail": "no instance identity resolved; binding check skipped"}
    try:
        b = read_binding(root, env.author, env.agent_session_id)
    except SchemaVersionError as exc:
        return {"name": name, "status": "warn", "detail": f"{exc.code}: {exc}"}
    if not b:
        try:
            active_names = [sd.name for sd in active_pair_dirs(root)]
        except SchemaVersionError as exc:
            return {"name": name, "status": "warn", "detail": f"{exc.code}: {exc}"}
        if len(active_names) > 1:
            return {
                "name": name, "status": "warn",
                "detail": (
                    f"no binding for this instance and {len(active_names)} active "
                    f"pairs ({', '.join(active_names)}); run `relay pair ensure` "
                    "or `relay pair join <slug>`"
                ),
            }
        return {"name": name, "status": "pass",
                "detail": "no binding for this instance (run `relay pair ensure`)"}
    slug = b.get("pair_slug")
    cand = root / slug if slug else None
    if cand and (cand / "session.json").exists():
        try:
            if session_is_active(cand):
                return {"name": name, "status": "pass", "detail": f"bound to {slug}"}
        except SchemaVersionError as exc:
            return {"name": name, "status": "warn", "detail": f"{exc.code}: {exc}"}
    return {"name": name, "status": "warn",
            "detail": f"bound pair {slug!r} is no longer active; "
                      "run `relay pair ensure` to rebind"}


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def _print_env_template() -> None:
    sys.stderr.write(
        "\nenvironment setup (v0.15):\n"
        "  author auto-detects from the platform signal (CLAUDE_CODE_SESSION_ID\n"
        "  for Claude Code, CODEX_THREAD_ID for Codex) — no RELAY_AUTHOR needed.\n"
        "  peer is derived from the pair. Pick the path that fits your topology:\n\n"
        "    # same-host (two agents on one machine): nothing to configure\n"
        "    relay init --same-host\n\n"
        "    # rsync transport owner (two machines):\n"
        "    relay init --sync rsync\n"
        "    # then $EDITOR \".envrc.$(hostname -s)\" to fill RELAY_REMOTE_SSH/PATH\n"
        "    source .envrc   # or `direnv allow`\n\n"
        "    # a custom (non claude/codex) agent that has no platform signal:\n"
        "    relay init --author <name> [--sync rsync]\n"
    )


def cmd_preflight(args) -> int:
    env = load_env()
    out: dict = {"exit_code": 0, "env": {}, "checks": []}

    # Detect project shape unconditionally so same-host setups still reach the
    # shape-A inference path:
    #   shape A: PROJECT_ROOT is itself a fuse mount → rsync structurally
    #            inapplicable; RELAY_REMOTE_SSH / RELAY_REMOTE_PATH irrelevant.
    #   shape B: PROJECT_ROOT is local; only .shared/ may be mounted.
    is_shape_a = False
    project_root = git_toplevel()
    if project_root is not None:
        is_shape_a = _is_fuse_mount(project_root)

    sync_effective, sync_source = _resolve_sync(env, is_shape_a=is_shape_a)

    # Identity: author is auto-detected from the platform signal
    # (CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID). RELAY_AUTHOR is optional for
    # custom agents, and peer is no longer an env input. Verify author
    # resolved, surface how, and flag ambiguity; peer is derived from
    # session.json (see identity.peer below).
    out["env"]["author"] = bool(env.author)
    if env.author:
        out["checks"].append({
            "name": "identity.author", "status": "pass",
            "detail": f"{env.author} (source: {env.author_source})",
        })
    elif "dual_platform" in env.identity_diagnostics:
        out["checks"].append({
            "name": "identity.author", "status": "fail",
            "detail": "both CLAUDE_CODE_SESSION_ID and CODEX_THREAD_ID are set "
                      "and RELAY_AUTHOR doesn't disambiguate; set RELAY_AUTHOR "
                      "to one of them or clear the stray signal",
        })
    else:
        out["checks"].append({
            "name": "identity.author", "status": "fail",
            "detail": "no platform signal (CLAUDE_CODE_SESSION_ID / "
                      "CODEX_THREAD_ID) and RELAY_AUTHOR unset",
        })

    # Session id (used only by the binding registry). Degraded is a warn — the
    # instance can still operate by passing --pair-id explicitly.
    if env.agent_session_id and env.agent_session_id_source != "fallback-degraded":
        out["checks"].append({
            "name": "identity.session_id", "status": "pass",
            "detail": f"source: {env.agent_session_id_source}",
        })
    elif env.author:
        out["checks"].append({
            "name": "identity.session_id", "status": "warn",
            "detail": "degraded (no platform id / tty / atuin); bindings need "
                      "--pair-id or a stable RELAY_AGENT_SESSION_ID",
        })

    # Author-determination diagnostics are warnings, not blockers: detection
    # still produced a usable author; the user should clean stale config.
    if "author_conflict" in env.identity_diagnostics:
        out["checks"].append({
            "name": "identity.author_conflict", "status": "warn",
            "detail": f"RELAY_AUTHOR disagrees with the platform signal; the "
                      f"platform wins ({env.author}). Remove the stale "
                      f"RELAY_AUTHOR / .envrc line.",
        })
    if "dual_platform" in env.identity_diagnostics and env.author:
        out["checks"].append({
            "name": "identity.dual_platform", "status": "warn",
            "detail": f"both platform signals set; RELAY_AUTHOR disambiguated "
                      f"to {env.author}",
        })

    # rsync transport vars stay required when this side owns the transport.
    if sync_effective == "rsync":
        for var in ("RELAY_REMOTE_SSH", "RELAY_REMOTE_PATH"):
            val = os.environ.get(var)
            out["env"][var] = bool(val)
            out["checks"].append({
                "name": f"env.{var}",
                "status": "pass" if val else "fail",
                "detail": "set" if val else "not set",
            })

    out["env"]["RELAY_SHARED_ROOT"] = bool(env.shared_root)
    if env.shared_root:
        detail = (
            "set"
            if env.shared_root_source == "env"
            else f"default {env.shared_root}"
        )
        out["checks"].append({
            "name": "env.RELAY_SHARED_ROOT",
            "status": "pass",
            "detail": detail,
        })
    else:
        out["checks"].append({
            "name": "env.RELAY_SHARED_ROOT",
            "status": "fail",
            "detail": "not set and no git project default is available",
        })

    # Sync resolution check — surfaces effective sync mode plus fix-it hints.
    if sync_source == "env-invalid":
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "fail",
            "detail": f"RELAY_SYNC={env.sync_raw!r} invalid; expected one of "
                      f"{sorted(SYNC_VALUES)}",
        })
    elif sync_effective is None:
        # Defensive: currently only env-invalid returns None and is handled
        # above. Keep a clear failure path if resolution grows new states.
        hint = (
            "set RELAY_SYNC=rsync (this side owns rsync transport) "
            "or RELAY_SYNC=none (this side does not sync)"
        )
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "fail",
            "detail": f"RELAY_SYNC could not be resolved; {hint}",
        })
    else:
        out["env"]["RELAY_SYNC"] = True
        detail = f"sync={sync_effective} (source: {sync_source})"
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "pass", "detail": detail,
        })

    if project_root is not None:
        if is_shape_a:
            shape_detail = "shape A (PROJECT_ROOT is a fuse mount; rsync structurally inapplicable)"
            if sync_effective == "rsync":
                # Contradiction: caller asserts they own rsync but project root
                # IS the mount, so there is nothing to rsync.
                out["checks"].append({
                    "name": "project.shape", "status": "fail",
                    "detail": shape_detail + " — but RELAY_SYNC=rsync; refuse to run sync",
                })
            else:
                out["checks"].append({
                    "name": "project.shape", "status": "pass",
                    "detail": shape_detail,
                })
        else:
            out["checks"].append({
                "name": "project.shape", "status": "pass",
                "detail": "shape B (PROJECT_ROOT is local; rsync available if SYNC=rsync)",
            })

    if env.shared_root and project_root is not None:
        top = project_root.resolve()
        try:
            env.shared_root.relative_to(top)
            out["checks"].append({
                "name": "shared_root.location",
                "status": "pass",
                "detail": f"{env.shared_root} is under git toplevel {top}",
            })
        except ValueError:
            out["checks"].append({
                "name": "shared_root.location",
                "status": "fail",
                "detail": f"{env.shared_root} is outside git toplevel {top}",
            })

    if env.shared_root:
        sentinel = env.shared_root / "_relay" / ".sentinel"
        out["checks"].append({
            "name": "mount.sentinel",
            "status": "pass" if sentinel.exists() else "fail",
            "detail": str(sentinel) if sentinel.exists() else
                      f"missing {sentinel}; run `relay bootstrap` or check mount",
        })
    else:
        out["checks"].append({"name": "mount.sentinel", "status": "fail",
                               "detail": "RELAY_SHARED_ROOT not set"})

    declared = env.project
    derived = git_toplevel()
    derived_name = derived.name if derived else None
    # Finding 7: compare sanitized forms so an explicit RELAY_PROJECT that
    # matches the *valid slug grammar* of a dotted/underscored repo (e.g.
    # RELAY_PROJECT=actibot-ego-jy in a checkout named actibot_ego.jy)
    # is treated as consistent. Without this both sides differ literally
    # and preflight fails even though they refer to the same project.
    declared_canon = sanitize_project_slug(declared) if declared else None
    derived_canon = sanitize_project_slug(derived_name) if derived_name else None
    if declared and derived_name and declared_canon != derived_canon:
        out["checks"].append({
            "name": "project.consistency", "status": "fail",
            "detail": (
                f"$RELAY_PROJECT={declared!r} (canonical {declared_canon!r}) "
                f"vs git toplevel basename {derived_name!r} "
                f"(canonical {derived_canon!r}); pick one"
            ),
        })
    elif declared or derived_name:
        out["checks"].append({
            "name": "project.consistency", "status": "pass",
            "detail": f"project={declared_canon or derived_canon}",
        })
    else:
        out["checks"].append({
            "name": "project.consistency", "status": "warn",
            "detail": "no $RELAY_PROJECT and not in git repo",
        })

    if env.shared_root and env.shared_root.is_dir():
        out["checks"].append(_check_binding_health(env.shared_root, env))
        for exc in pair_schema_errors(env.shared_root):
            out["checks"].append({
                "name": "pair.schema",
                "status": "warn",
                "detail": f"{exc.code}: {exc}",
            })
        # Peer derivability: only meaningful once this instance is bound
        # to an active pair. Never fatal — a missing/odd participants list is a
        # warn so claim/wait surface it before they actually need the peer.
        if env.author and env.agent_session_id:
            try:
                _b = read_binding(env.shared_root, env.author, env.agent_session_id)
            except SchemaVersionError as exc:
                out["checks"].append({
                    "name": "identity.peer",
                    "status": "warn",
                    "detail": f"{exc.code}: {exc}",
                })
                _b = None
            _slug = _b.get("pair_slug") if _b else None
            _cand = env.shared_root / _slug if _slug else None
            if _cand and (_cand / "session.json").exists():
                try:
                    active = session_is_active(_cand)
                    _peer = resolve_peer(_cand, env.author) if active else None
                    out["checks"].append({
                        "name": "identity.peer",
                        "status": "pass" if _peer else "warn",
                        "detail": (f"derived {_peer} from {_slug}" if _peer
                                   else f"could not derive a peer from {_slug} "
                                        "participants (malformed or not a 2-party pair)"),
                    })
                except SchemaVersionError as exc:
                    out["checks"].append({
                        "name": "identity.peer",
                        "status": "warn",
                        "detail": f"{exc.code}: {exc}",
                    })

    if env.shared_root and env.shared_root.is_dir():
        for r in run_probes(env.shared_root):
            out["checks"].append({
                "name": f"fs.{r.name}", "status": r.status,
                "detail": r.detail, "elapsed_ms": r.elapsed_ms,
            })
    else:
        out["checks"].append({
            "name": "fs.probes", "status": "fail",
            "detail": f"shared_root not accessible: {env.shared_root}",
        })

    out["exit_code"] = _preflight_exit_code(out["checks"])

    if args.json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
    else:
        print(f"relay preflight :: {env.shared_root or '(unset)'}")
        print()
        icon = {"pass": "[ok]  ", "warn": "[warn]", "fail": "[fail]"}
        for c in out["checks"]:
            el = f" ({c.get('elapsed_ms', 0):>4d}ms)" if "elapsed_ms" in c else ""
            print(f"  {icon[c['status']]} {c['name']:24s}{el}  {c['detail']}")
        print()
        cnt = {"pass": 0, "warn": 0, "fail": 0}
        for c in out["checks"]:
            cnt[c["status"]] += 1
        print(f"summary: {cnt['pass']} pass, {cnt['warn']} warn, {cnt['fail']} fail "
              f"(exit {out['exit_code']})")
        failed = {c["name"] for c in out["checks"] if c["status"] == "fail"}
        setup_failed = (
            "identity.author" in failed
            or not env.shared_root
            or "env.RELAY_REMOTE_SSH" in failed
            or "env.RELAY_REMOTE_PATH" in failed
        )
        if out["exit_code"] != 0 and setup_failed:
            _print_env_template()
    return out["exit_code"]


def _ensure_shared_root(root: Path) -> tuple[list[str], list[str]]:
    """Idempotently create RELAY_SHARED_ROOT + _relay/.sentinel. Returns (created, existed)."""
    created: list[str] = []
    existed: list[str] = []

    if not root.exists():
        root.mkdir(mode=0o700, parents=True)
        created.append(str(root))
    else:
        existed.append(str(root))

    relay_meta = root / "_relay"
    if not relay_meta.exists():
        relay_meta.mkdir(mode=0o700)
        created.append(str(relay_meta))
    else:
        existed.append(str(relay_meta))

    sentinel = relay_meta / ".sentinel"
    if not sentinel.exists():
        atomic_write_text(sentinel, f"relay mount sentinel\ncreated_at: {now_iso()}\n", mode=0o600)
        created.append(str(sentinel))
    else:
        existed.append(str(sentinel))

    return created, existed


def _hostname_short() -> str:
    """Match dispatcher .envrc's `$(hostname -s)` short hostname."""
    try:
        res = subprocess.run(["hostname", "-s"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except FileNotFoundError:
        pass
    return os.uname().nodename.split(".")[0]


def _copy_envrc_dispatcher(project_root: Path) -> tuple[Path, bool]:
    """Copy templates/envrc.dispatcher.example to <project>/.envrc.

    The dispatcher is the project-agnostic file that sources `.envrc.<hostname>`.
    It's committed in this repo but needs to be installed when adopting the relay
    skill in other projects. Returns (target, created)."""
    template = RELAY_PACKAGE_DIR / "templates" / "envrc.dispatcher.example"
    if not template.exists():
        raise SystemExit(f"relay init: template not found: {template}")
    target = project_root / ".envrc"
    if target.exists():
        return target, False
    target.write_text(template.read_text(encoding="utf-8"), encoding="utf-8")
    return target, True


def cmd_init(args) -> int:
    env = load_env()
    project_root = git_toplevel()
    root = env.shared_root
    if root is None:
        print("relay init: RELAY_SHARED_ROOT not set; either export it or run inside a git repo",
              file=sys.stderr)
        return 2
    if env.shared_root_source == "default":
        print(f"relay init: RELAY_SHARED_ROOT not set, defaulting to {root}", file=sys.stderr)

    created, existed = _ensure_shared_root(root)
    if created:
        print("relay init: created:")
        for p in created:
            print(f"  {p}")
    elif existed:
        print(f"relay init: shared root already initialized at {root}")

    same_host = getattr(args, "same_host", False)
    author = getattr(args, "author", None)
    sync = getattr(args, "sync", None)

    # --same-host and the explicit flag set are mutually exclusive.
    explicit_flags = any(v is not None for v in (author, sync))
    if same_host and explicit_flags:
        print(
            "relay init: --same-host is mutually exclusive with "
            "--author/--sync. Pick one.",
            file=sys.stderr,
        )
        return 2

    # Author auto-detects from the platform signal (CLAUDE_CODE_SESSION_ID
    # / CODEX_THREAD_ID) and peer is derived from the pair — so the common cases
    # need NO identity env and NO .envrc at all.
    if same_host:
        # Two claude/codex agents on one machine: nothing to configure. Each
        # terminal's platform signal names its author; peer is derived from the
        # pair. No template, no RELAY_AUTHOR, no direnv.
        print()
        print("relay init: same-host claude+codex needs no identity env — author "
              "auto-detects from each terminal's platform signal.")
        print("  Just run the relay skill in each agent; `relay bootstrap "
              "--topic <slug>` starts the pair.")
        return 0

    envrc_just_created = False
    if explicit_flags and project_root:
        # Explicit path: render a minimal per-host .envrc for the rsync transport
        # owner and/or a custom (non claude/codex) agent. Only a custom agent
        # needs --author; runtime peer is derived from the pair, never from env.
        # Finding 8: identity/sync values land verbatim in a sourceable shell
        # file; constrain to the slug grammar so shell metacharacters can't
        # inject into a file the user is about to `source`.
        for label, value in (("--author", author),):
            if value is not None and not SLUG_RE.match(value):
                print(
                    f"relay init: {label}={value!r} is not a valid identity slug. "
                    f"Allowed: lowercase letters, digits, hyphens; must start with "
                    f"a letter or digit; max 48 chars (regex {SLUG_RE.pattern}). "
                    f"Examples: claude, codex, gpt55.",
                    file=sys.stderr,
                )
                return 2
        sync_value = sync if sync is not None else "none"
        if sync_value not in SYNC_VALUES:
            print(f"relay init: --sync={sync_value!r} invalid; expected one of "
                  f"{sorted(SYNC_VALUES)}", file=sys.stderr)
            return 2
        dispatcher_target, dispatcher_just_created = _copy_envrc_dispatcher(project_root)
        if dispatcher_just_created:
            print(f"relay init: created {dispatcher_target} (from envrc.dispatcher.example)")
        else:
            print(f"relay init: {dispatcher_target} already present")
        envrc_target = project_root / f".envrc.{_hostname_short()}"
        if envrc_target.exists():
            print(f"relay init: {envrc_target} already present (not overwriting)")
        else:
            envrc_target.write_text(_render_envrc_body(author, sync_value),
                                     encoding="utf-8")
            envrc_just_created = True
            print(f"relay init: created {envrc_target} from --author/--sync flags")
        if sync_value == "rsync" and (not env.remote_ssh or not env.remote_path):
            print("relay init: note — --sync=rsync was set but RELAY_REMOTE_SSH/PATH "
                  "are not exported. Add them to your shell before `source .envrc` "
                  "or `relay sync` will refuse.", file=sys.stderr)

    if project_root and not explicit_flags and not env.author:
        # First-run hint, only when identity couldn't be auto-detected AND no
        # per-host env file exists. With a platform signal this never fires.
        hostname = _hostname_short()
        if not (project_root / f".envrc.{hostname}").exists():
            print(f"\nhint: author auto-detects from the platform signal "
                  "(claude/codex) — no RELAY_AUTHOR / .envrc needed for same-host.")
            print("  same-host (two agents, one machine):  relay init --same-host")
            print("  rsync owner (two machines):           relay init --sync rsync"
                  "   # then fill RELAY_REMOTE_SSH/PATH")

    if envrc_just_created and project_root:
        has_direnv = shutil.which("direnv") is not None
        print()
        if has_direnv:
            print(f"next: cd {project_root} && direnv allow")
        else:
            print(f"next: cd {project_root} && source .envrc")
            print("  (install direnv for auto-load on cd)")

    return 0


def _render_envrc_body(author: Optional[str], sync: str) -> str:
    """Render a minimal per-host .envrc body for the rsync transport owner
    and/or a custom (non claude/codex) agent.

    v0.15: author auto-detects from the platform signal and runtime peer is
    derived from the pair, so RELAY_AUTHOR is rendered ONLY when a custom
    --author was given (an override), and RELAY_PEER is never written.
    """
    cmd = f"--author {author} --sync {sync}" if author else f"--sync {sync}"
    body = [
        f"# Per-host relay config generated by `relay init {cmd}` (v0.15).",
        "# Gitignored. Edit freely; re-run init to regenerate from scratch.",
        "#",
        "# author auto-detects from the platform signal (CLAUDE_CODE_SESSION_ID",
        "# / CODEX_THREAD_ID); peer is derived from the pair, never from env.",
        "",
        f"export RELAY_SYNC={sync}",
    ]
    if author:
        body.append(f"export RELAY_AUTHOR={author}  # custom (non claude/codex) agent override")
    body += [
        "",
        "# Shared ledger root: normally leave unset. `relay` defaults to the current",
        "# git project's `.shared` (same as `$PWD/.shared` from the project root).",
        "# Uncomment only when you intentionally need a non-project-local ledger.",
        '# export RELAY_SHARED_ROOT="$PWD/.shared"',
        "",
    ]
    if sync == "rsync":
        body += [
            "# RELAY_SYNC=rsync requires the remote-transport vars. Fill these in:",
            "# export RELAY_REMOTE_SSH=user@other-host",
            "# export RELAY_REMOTE_PATH=/path/on/other/agent-ledger",
        ]
    else:
        # Finding C3: explain the unconditional `unset` so users don't
        # wonder why their parent-shell exports were cleared after
        # `source .envrc`. Same-host setups commonly inherit rsync vars
        # from a sibling envrc; clearing them prevents `relay sync` from
        # mis-guessing it should run a real transport.
        body += [
            "# RELAY_SYNC=none: clear stale rsync transport vars so `relay sync`",
            "# refuses cleanly instead of attempting a half-configured push.",
            "unset RELAY_REMOTE_SSH RELAY_REMOTE_PATH",
        ]
    return "\n".join(body) + "\n"


def cmd_bootstrap(args) -> int:
    env = load_env()
    if not env.shared_root:
        print("relay bootstrap: RELAY_SHARED_ROOT not set and no git project default is available",
              file=sys.stderr)
        return 2
    if not SLUG_RE.match(args.topic):
        print(f"relay bootstrap: topic must match {SLUG_RE.pattern}", file=sys.stderr)
        return 2

    proj = derive_project(env)
    if not proj:
        print("relay bootstrap: cannot determine project (set RELAY_PROJECT or run in a git repo)",
              file=sys.stderr)
        return 2
    if not SLUG_RE.match(proj):
        print(
            f"relay bootstrap: project {proj!r} is not a valid slug; "
            "set RELAY_PROJECT to a value matching ^[a-z0-9][a-z0-9-]{0,47}$ "
            "(lowercase + digits + hyphen, ≤48 chars).",
            file=sys.stderr,
        )
        return 2

    _ensure_shared_root(env.shared_root)

    date_prefix = datetime.now().strftime("%Y%m%d")
    session_slug = f"{date_prefix}-{args.topic}"
    session_dir = env.shared_root / session_slug
    if session_dir.exists():
        print(f"relay bootstrap: pair dir already exists: {session_dir}", file=sys.stderr)
        return 2

    my_active = resolve_active_pair(env, require_binding=True)
    if my_active is not None and not getattr(args, "force", False):
        print(
            "relay bootstrap: this instance is already bound to active pair "
            f"{my_active.name}; use --force to start a parallel pair, or run "
            "`relay pair leave` first",
            file=sys.stderr,
        )
        return 2

    # Identity is required to create a pair, and the peer must be known up front
    # (a pair has exactly two participants). Validate BEFORE mkdir so a bad
    # identity never leaves a half-created pair dir. RELAY_PEER is not
    # consulted: claude<->codex auto-derive; other agents pass --peer.
    author = env.author
    if not author:
        print("relay bootstrap: could not determine author identity "
              "(no platform signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2
    peer = getattr(args, "peer", None) or default_peer(author)
    if not peer:
        print(f"relay bootstrap: cannot derive a peer for author {author!r}; "
              "pass --peer <name> (only claude<->codex auto-derive)",
              file=sys.stderr)
        return 2
    if peer == author:
        print(f"relay bootstrap: --peer cannot equal author ({author!r})",
              file=sys.stderr)
        return 2

    # Explicitly 0700 (file-protocol §12): shared/session/.draft owner-only.
    session_dir.mkdir(mode=0o700)
    (session_dir / ".draft").mkdir(mode=0o700)

    participants = [author, peer]

    session_json = {
        "schema_version": SCHEMA_VERSION,
        "project": proj,
        "session_id": session_slug,
        "title": args.title or args.topic,
        "state": "active",
        "created_at": now_iso(),
        "closed_at": None,
        "close_reason": None,
        "participants": participants,
    }
    atomic_write_json(session_dir / "session.json", session_json)
    join_pair(env, env.shared_root, session_slug)  # creator is the pair's first instance

    readme = (
        f"# relay pair: {session_slug}\n\n"
        f"Project: {proj}\n"
        f"Title: {session_json['title']}\n"
        f"Created: {session_json['created_at']}\n"
        f"Participants: {', '.join(participants) or '(none)'}\n\n"
        f"Use `relay status` to see current state, `relay claim` to start an artifact.\n"
    )
    atomic_write_text(session_dir / "README.md", readme, mode=0o600)

    print(f"created pair: {session_dir}")
    print(f"  project:      {proj}")
    print(f"  pair name:    {session_slug}")
    print(f"  participants: {', '.join(participants) or '(none)'}")
    print(f"  you:          {author}  (bound to this pair)")
    print(f"► tell your peer ({peer}) to join THIS exact pair — precise pairing:")
    print(f"      relay pair join {session_slug}")
    print(f"  then run agent-relay on the {peer} side. (`relay pair show` reprints this anytime.)")
    return 0


def cmd_status(args) -> int:
    env = load_env()
    pair_id = getattr(args, "pair_id", None)
    require_binding = bool(getattr(args, "require_binding", False))
    try:
        if pair_id:
            session = resolve_pair(env, pair_id, project=getattr(args, "project", None))
        else:
            # Bare interactive status RESOLVES a bound paused (`timed_out`) pair
            # so it can report it (`is_active: false`, `resumable: true`) — the
            # normal `pair ensure -> status` handoff must not dead-end after a
            # pause. But `--require-binding` (the passive Stop hook) keeps
            # allow_resumable=False: a paused pair resolves to None there, so the
            # hook stays quiet and never wakes the auto-loop (the binding is
            # preserved either way, by resolve_active_pair).
            session = resolve_active_pair(env, getattr(args, "project", None),
                                          require_binding=require_binding,
                                          allow_resumable=not require_binding)
    except SystemExit as exc:
        msg = str(exc)
        if msg.startswith("relay: "):
            raise
        hint = ""
        if "no active pair" in msg:
            hint = " — run `relay bootstrap --topic <slug>` to start a new pair."
        elif "multiple active pairs" in msg:
            hint = " — run `relay pair ensure` / `relay pair join <slug>`, or pass `--pair-id <id>`."
        elif "not active" in msg:
            hint = " — run `relay pairs list` to inspect existing pairs, or `relay bootstrap --topic <slug>` to start a new one."
        print(f"relay status: {msg}{hint}", file=sys.stderr)
        return 2
    if session is None:
        # Strict --require-binding, no --pair-id, no live binding: this instance
        # is not bound to any pair. Emit a non-actionable payload at exit 0 so
        # passive automation (the Stop hook) can cheaply ignore it instead of
        # being handed a pair it never joined (issue 20260601T182646-2920d5b9).
        empty = {
            "session": None,
            "session_dir": None,
            "is_active": False,
            "resumable": False,
            "next_seq": None,
            "published": [],
            "drafts": [],
            "closed_sentinel": False,
            "bound_pair": None,
        }
        if getattr(args, "json", False):
            print(json.dumps(empty, indent=2, ensure_ascii=False))
        else:
            print("not bound to any pair (--require-binding); nothing to report")
        return 0
    _gc_heartbeat_orphans(session, env.author or "")
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    sj = read_session_json(session)

    pub = list_published(session)
    if args.last and args.last > 0:
        pub = pub[-args.last:]

    artifacts = []
    for f in pub:
        try:
            fm, body = parse_frontmatter(f.read_text(encoding="utf-8"))
        except ValueError:
            artifacts.append({"path": str(f.relative_to(session)), "error": "malformed frontmatter"})
            continue
        first_line = next((ln for ln in body.splitlines() if ln.strip()), "")
        artifacts.append({
            "seq": fm.get("seq"),
            "author": fm.get("author"),
            "peer": fm.get("peer"),
            "kind": fm.get("kind"),
            "status": fm.get("status"),
            "created": fm.get("created"),
            "in_reply_to": fm.get("in_reply_to"),
            "sync_needed": fm.get("sync_needed"),
            "corrects": fm.get("corrects"),
            "path": str(f.relative_to(session)),
            "first_line": first_line[:120],
        })

    drafts: list[str] = []
    draft_dir = session / ".draft"
    if draft_dir.is_dir():
        drafts = sorted(p.name for p in draft_dir.glob("*.md"))

    is_active = session_is_active(session)
    # `resumable` is true only for a *paused* pair: not active (latest is
    # `timed_out`) yet still writable — `claim`/`publish` may resume the round.
    # A fully active pair reports resumable=false (it's just active).
    resumable = session_is_resumable(session) and not is_active

    # Binding provenance (consistent with `whoami`): which pair THIS instance is
    # bound to, independent of how `session` was resolved (--pair-id can differ
    # from the binding). null when unbound. Lets any reader tell a real binding
    # from a sole-active resolution.
    bound_pair = None
    if env.author and env.agent_session_id and env.shared_root:
        b = read_binding(env.shared_root, env.author, env.agent_session_id)
        bound_pair = b.get("pair_slug") if b else None

    payload = {
        "session": sj,
        "session_dir": str(session),
        "is_active": is_active,
        "resumable": resumable,
        "next_seq": latest_seq(session) + 1,
        "published": artifacts,
        "drafts": drafts,
        "closed_sentinel": (session / "CLOSED").exists(),
        "bound_pair": bound_pair,
    }

    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return 0

    print(f"session: {sj['session_id']}  project={sj.get('project')}")
    print(f"  title:    {sj.get('title')}")
    print(f"  state:    {sj.get('state')}  (is_active={is_active})")
    if resumable:
        print("  resumable: yes  (latest artifact timed_out — `relay claim "
              "--in-reply-to <seq>` resumes this round)")
    print(f"  created:  {sj.get('created_at')}")
    if sj.get("closed_at"):
        print(f"  closed:   {sj['closed_at']}  reason={sj.get('close_reason')!r}")
    print(f"  next-seq: {payload['next_seq']}")
    print()
    if artifacts:
        print("published artifacts:")
        for a in artifacts:
            if "error" in a:
                print(f"  ! {a['path']}  ({a['error']})")
                continue
            print(f"  {a['seq']:>3}  [{a['status']:<10}]  {a['author']} -> {a['peer']:<8} "
                  f"{a['kind']:<11}  {a['path']}")
            if a["first_line"]:
                print(f"       | {a['first_line']}")
    else:
        print("(no published artifacts yet)")
    if drafts:
        print()
        print("drafts (hidden):")
        for d in drafts:
            print(f"  .draft/{d}")
    return 0


def _scaffold_frontmatter(author: str, peer: str, seq: int, kind: str,
                          in_reply_to: int | None,
                          corrects: int | None = None) -> dict:
    return {
        "seq": seq,
        "author": author,
        "peer": peer,
        "kind": kind,
        "status": "draft",
        "created": now_iso(),
        "in_reply_to": in_reply_to if in_reply_to is not None else (seq - 1 if seq > 1 else None),
        "prompt_for_next": "TODO: write actionable instructions for the peer\n",
        "sync_needed": False,
        "touched_paths": [],
        "corrects": corrects,
    }


# Test seam: the suite flips this to False (via monkeypatch on the module
# attribute, immune to RELAY_* env clearing) so unit tests never spawn a real
# heartbeat daemon. Never changed in production.
_CLAIM_HEARTBEAT_AUTOSTART = True


def _maybe_autostart_claim_heartbeat(draft_path: Path, args) -> Optional[str]:
    """Auto-start a renewal-file heartbeat for a freshly claimed draft (v0.15).

    Returns None on success or when intentionally skipped; returns an error
    string when a genuine start failure should roll the draft back (a claimed
    draft must never sit without liveness coverage — that's what lets the
    auto-loop rely on `wait` exit 11 instead of a blind timeout). Skipped by
    `--no-heartbeat`, `RELAY_CLAIM_NO_HEARTBEAT=1`, or the test seam (tests /
    advanced / debug). Reuses cmd_heartbeat_start (the single liveness code
    path) with its stdout captured so claim's own output stays just the draft
    path. An already-running heartbeat (rc 3) is treated as a FAILURE and rolls
    the draft back: that daemon only refreshes the first draft's sidecar, so a
    second draft would have no liveness coverage of its own.
    """
    if (not _CLAIM_HEARTBEAT_AUTOSTART
            or getattr(args, "no_heartbeat", False)
            or os.environ.get("RELAY_CLAIM_NO_HEARTBEAT")):
        return None
    hb_args = type("HB", (), {
        "draft": str(draft_path),
        "owner_kind": "renewal-file",
        "owner_pid": None,
        "owner_pidfile": None,
        "interval": None,
    })()
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            rc = cmd_heartbeat_start(hb_args)
    except Exception as exc:  # never let a liveness hiccup crash claim
        return (f"failed to auto-start renewal-file heartbeat ({exc}); draft "
                "rolled back. Re-run, or use --no-heartbeat to claim without one.")
    if rc == 0:
        return None
    if rc == 3:
        # Already-running heartbeat is per-author and refreshes only the FIRST
        # draft's sidecar — a second draft would have NO sidecar of its own, so
        # `wait`/GC wouldn't see it as covered. Fail closed: roll the new draft
        # back rather than leave it without liveness coverage (codex seq 9
        # must-fix). The normal one-draft-per-turn flow never hits this (publish
        # stops the heartbeat); rc 3 means a prior draft is still open.
        return ("a heartbeat is already running for this author (a prior "
                "unpublished draft?); the new draft would have no liveness "
                "coverage of its own, so it was rolled back. Run "
                "`relay heartbeat stop` or `relay doctor --fix` to clear the "
                "stale one, then retry — or use --no-heartbeat.")
    return (f"failed to auto-start renewal-file heartbeat (rc={rc}); draft "
            "rolled back so it never lacks liveness coverage. Use --no-heartbeat "
            "to claim without one.")


def cmd_claim(args) -> int:
    env = load_env()
    if args.kind not in KINDS:
        print(f"relay claim: unknown kind {args.kind!r} (known: {sorted(KINDS)})",
              file=sys.stderr)
        return 2
    # Finding 6: --corrects was documented for kind=correction but not
    # actually present on the parser. Enforce it here.
    corrects = getattr(args, "corrects", None)
    if corrects is not None and corrects < 1:
        print(f"relay claim: --corrects must be a positive integer (got {corrects})",
              file=sys.stderr)
        return 2
    # Finding 3 (codex seq 2): reject --corrects on kinds that can't carry it,
    # so the nonsense never reaches a draft. publish re-validates as the hard gate.
    if corrects is not None and args.kind not in CORRECTS_KINDS:
        print(
            f"relay claim: --corrects is only valid for {sorted(CORRECTS_KINDS)}, "
            f"not --kind {args.kind!r}.",
            file=sys.stderr,
        )
        return 2
    if args.kind == "correction" and corrects is None:
        print(
            "relay claim: --corrects <seq> is required when --kind correction; "
            "the field points at the seq this correction supersedes.",
            file=sys.stderr,
        )
        return 2
    try:
        # allow_resumable: claim may continue a `timed_out` (user-blocking)
        # round once the user answers — the documented resume path. Hard-terminal
        # pairs still fail closed. require_binding stays True (no sole-active
        # fallback for this write boundary).
        session = resolve_active_pair(
            env,
            getattr(args, "project", None),
            getattr(args, "pair_id", None),
            require_binding=True,
            allow_resumable=True,
        )
    except SystemExit as exc:
        msg = str(exc)
        hint = ""
        if "no active pair" in msg or "not active" in msg:
            hint = " — run `relay pairs list` to see existing pairs, or `relay bootstrap --topic <slug>` to start a new one."
        elif "multiple active pairs" in msg:
            hint = " — run `relay pair ensure` / `relay pair join <slug>`, or pass `--pair-id <id>`."
        print(f"relay claim: {msg}{hint}", file=sys.stderr)
        return 2
    if session is None:
        print(
            "relay claim: no bound pair for this instance — run `relay pair "
            "ensure` / `relay pair join <slug>`, run `relay bootstrap --topic "
            "<slug>` to start a new pair, or pass `--pair-id <id>`.",
            file=sys.stderr,
        )
        return 2
    # Identity boundary (fail-closed, per decision 004): a draft MUST carry a
    # real author AND a real peer derived from the pair — never scaffold a
    # `peer: unknown` (or `author: unknown`) artifact. Validate BEFORE creating
    # .draft/ or writing anything, so a malformed pair record leaves nothing
    # behind. (resolve_peer is the source of truth; RELAY_PEER is never read.)
    author = env.author
    if not author:
        print("relay claim: could not resolve author identity (no platform "
              "signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2
    peer = resolve_peer(session, author)
    if not peer:
        print(f"relay claim: cannot derive a peer for {author!r} from "
              f"{session.name} participants (malformed, or not a 2-party pair "
              f"containing {author!r}); refusing to scaffold a draft with an "
              f"unknown peer.", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, author)
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    draft_dir = session / ".draft"
    draft_dir.mkdir(exist_ok=True)

    seq = latest_seq(session) + 1
    for attempt in range(10):
        if attempt > 0:
            time.sleep(random.uniform(0.01, 0.05))
        draft_name = f"{seq:03d}-{author}-{args.kind}.md"
        draft_path = draft_dir / draft_name
        if draft_path.exists():
            seq += 1
            continue
        fm = _scaffold_frontmatter(author, peer, seq, args.kind, args.in_reply_to,
                                   corrects=corrects)
        body = (
            f"\n# {args.kind} by {author}, seq {seq}\n\n"
            "<!-- write your substantive content here. delete this comment. -->\n"
        )
        try:
            text = dump_frontmatter(fm, body)
            data = text.encode("utf-8")
            tmp = draft_dir / f".{draft_name}.relay-{os.getpid()}-{uuid.uuid4().hex[:8]}.tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                    f.flush()
                    os.fsync(f.fileno())
            except BaseException:
                try:
                    os.close(fd)
                except OSError:
                    pass
                tmp.unlink(missing_ok=True)
                raise
            try:
                os.link(tmp, draft_path)  # atomic O_EXCL via link
            except FileExistsError:
                tmp.unlink(missing_ok=True)
                seq += 1
                continue
            finally:
                tmp.unlink(missing_ok=True)
            _fsync_dir(draft_dir)
            # v0.15: give the draft liveness coverage immediately (no separate
            # `heartbeat start` step). On genuine failure, roll the draft back.
            hb_err = _maybe_autostart_claim_heartbeat(draft_path, args)
            if hb_err:
                draft_path.unlink(missing_ok=True)
                _fsync_dir(draft_dir)
                print(f"relay claim: {hb_err}", file=sys.stderr)
                return 2
            print(draft_path)
            return 0
        except OSError as exc:
            print(f"relay claim: io error: {exc}", file=sys.stderr)
            return 2
    print(
        "relay claim: could not allocate sequence after 10 attempts; "
        "concurrent activity detected — wait briefly and retry, or run "
        "`relay doctor` to inspect for abandoned drafts.",
        file=sys.stderr,
    )
    return 2


_DRAFT_NAME_RE = re.compile(r"^(\d{3})-([a-z0-9-]+)-([a-z0-9-]+)\.md$")


def _validate_draft(draft_path: Path) -> tuple[dict, str]:
    if not draft_path.exists():
        raise ValueError(f"draft not found: {draft_path}")
    if draft_path.parent.name != ".draft":
        raise ValueError(f"draft not under .draft/: {draft_path}")
    try:
        fm, body = parse_frontmatter(draft_path.read_text(encoding="utf-8"))
    except ValueError as exc:
        raise ValueError(f"frontmatter parse error: {exc}") from exc
    required = ["seq", "author", "peer", "kind", "status", "prompt_for_next", "sync_needed"]
    missing = [k for k in required if k not in fm or fm[k] in (None, "")]
    if missing:
        raise ValueError(f"missing required frontmatter fields: {missing}")
    if fm["status"] != "draft":
        raise ValueError(f"draft status must be 'draft' before publish, got {fm['status']!r}")
    pfn = fm["prompt_for_next"]
    if not isinstance(pfn, str) or not pfn.strip():
        raise ValueError("prompt_for_next is empty or whitespace")
    if PLACEHOLDER_MARKER in pfn:
        raise ValueError(f"prompt_for_next still contains placeholder marker {PLACEHOLDER_MARKER!r}")
    if not body.strip():
        raise ValueError("body is empty or whitespace")
    if fm["kind"] not in KINDS:
        raise ValueError(f"unknown kind: {fm['kind']!r}")
    # filename ↔ frontmatter identity (file-protocol §2/§4): NNN-author-kind.md
    m = _DRAFT_NAME_RE.match(draft_path.name)
    if not m:
        raise ValueError(
            f"draft filename does not match NNN-author-kind.md pattern: {draft_path.name}"
        )
    file_seq, file_author, file_kind = int(m.group(1)), m.group(2), m.group(3)
    fm_seq = fm.get("seq")
    if not isinstance(fm_seq, int) or fm_seq != file_seq:
        raise ValueError(
            f"frontmatter/filename seq mismatch: filename={file_seq:03d} "
            f"frontmatter={fm_seq!r}"
        )
    if fm.get("author") != file_author:
        raise ValueError(
            f"frontmatter/filename author mismatch: filename={file_author!r} "
            f"frontmatter={fm.get('author')!r}"
        )
    if fm.get("kind") != file_kind:
        raise ValueError(
            f"frontmatter/filename kind mismatch: filename={file_kind!r} "
            f"frontmatter={fm.get('kind')!r}"
        )
    # Finding 6 (v0.8) + finding 3 (codex seq 2): validate `corrects` for
    # EVERY artifact, not just corrections.
    #   - correction MUST carry a corrects ref.
    #   - any non-null corrects (correction or addendum) must be a positive
    #     int strictly less than this artifact's seq (no self/future refs).
    #   - kinds outside CORRECTS_KINDS MUST NOT carry corrects at all —
    #     otherwise the correction graph accretes nonsense edges that
    #     consumers may treat as real (e.g. a `plan` with `corrects: 1`).
    kind = fm.get("kind")
    c = fm.get("corrects")
    if kind == "correction" and (not isinstance(c, int) or c < 1):
        raise ValueError(
            "kind=correction requires a positive int 'corrects' field "
            f"pointing at the seq being corrected (got {c!r}). "
            "Re-claim with `--corrects <seq>`."
        )
    if c is not None:
        if kind not in CORRECTS_KINDS:
            raise ValueError(
                f"kind={kind!r} must not set 'corrects' (got {c!r}); only "
                f"{sorted(CORRECTS_KINDS)} may carry a correction reference."
            )
        if not isinstance(c, int) or c < 1:
            raise ValueError(
                f"'corrects' must be a positive int (got {c!r})."
            )
        if c >= fm["seq"]:
            raise ValueError(
                f"corrects={c} must be less than this artifact's seq "
                f"({fm['seq']}); you cannot correct a self/future artifact."
            )
    return fm, body


def cmd_publish(args) -> int:
    draft_path = Path(args.draft_path).resolve()
    try:
        fm, body = _validate_draft(draft_path)
    except ValueError as exc:
        print(f"relay publish: {exc}", file=sys.stderr)
        return 2

    session = draft_path.parent.parent
    _env_pub = load_env()
    # Finding 3 (v0.8 audit) + finding 2 (codex seq 2): prevent author
    # forgery. _validate_draft only checks that filename and frontmatter
    # agree on author; it does NOT check the active RELAY_AUTHOR. Publish
    # is the integrity boundary and must FAIL CLOSED when identity is
    # missing — the earlier `if _env_pub.author and ...` form skipped the
    # guard entirely when RELAY_AUTHOR was unset, letting an env-less
    # publish forge any author.
    if not _env_pub.author:
        print(
            "relay publish: could not resolve author identity (no platform "
            "signal and RELAY_AUTHOR unset); refusing to publish without a "
            "known identity (publish is the authorship boundary).",
            file=sys.stderr,
        )
        return 2
    if fm.get("author") != _env_pub.author:
        print(
            f"relay publish: refusing to publish a draft authored by "
            f"{fm.get('author')!r} as {_env_pub.author!r} — you can only "
            f"publish your own drafts; re-claim under the current author.",
            file=sys.stderr,
        )
        return 2
    try:
        expected_peer = resolve_peer(session, fm["author"])
    except SchemaVersionError as exc:
        print(f"relay publish: {exc}", file=sys.stderr)
        return 2
    if not expected_peer:
        print(
            f"relay publish: cannot derive a peer for {fm['author']!r} from "
            f"{session.name} participants (malformed, or not a 2-party pair "
            f"containing {fm['author']!r}); refusing to publish a draft outside "
            "the pair's participants.",
            file=sys.stderr,
        )
        return 2
    if fm.get("peer") != expected_peer:
        print(
            f"relay publish: draft peer {fm.get('peer')!r} does not match "
            f"{fm['author']!r}'s participant-derived peer {expected_peer!r} "
            f"in {session.name}; re-claim the draft.",
            file=sys.stderr,
        )
        return 2
    _gc_heartbeat_orphans(session, _env_pub.author or "")
    _gc_renewal_orphans(session, _env_pub)
    _maybe_tick_renewal(session, _env_pub)
    base = draft_path.name[:-3]  # strip .md
    final_status = args.status if args.status else "ready"
    if final_status not in STATUSES or final_status == "draft":
        print(f"relay publish: invalid --status: {final_status!r}", file=sys.stderr)
        return 2
    try:
        publish_session_active = session_is_active(session)
        publish_session_resumable = session_is_resumable(session)
    except SchemaVersionError as exc:
        print(f"relay publish: {exc}", file=sys.stderr)
        return 2
    # A `timed_out` latest is RESUMABLE: a normal continuation publish may
    # supersede it (the documented resume path after a `@user:` escalation) with
    # no --force. Only a hard terminal (closed/cancelled/failed) or a CLOSED
    # pair — not active AND not resumable — needs the --force terminal-note
    # escape hatch.
    if not publish_session_active and not publish_session_resumable:
        if not getattr(args, "force", False):
            print(
                f"relay publish: refusing to publish into inactive pair: {session} "
                "— pair is closed/terminal; `relay bootstrap --topic <slug>` to "
                "start a new pair, or pass `--force --force-reason <text> "
                "--status <closed|cancelled|failed|timed_out>` to record a terminal note.",
                file=sys.stderr,
            )
            return 2
        force_reason = getattr(args, "force_reason", None)
        if not force_reason:
            print("relay publish: --force requires --force-reason", file=sys.stderr)
            return 2
        if final_status not in TERMINAL_STATUSES:
            print(
                "relay publish: --force requires terminal --status "
                f"({', '.join(sorted(TERMINAL_STATUSES))})",
                file=sys.stderr,
            )
            return 2
        fm["force_reason"] = force_reason
    fm["status"] = final_status
    fm["created"] = now_iso()

    seq = int(fm["seq"])
    for attempt in range(10):
        if attempt > 0:
            time.sleep(random.uniform(0.05, 0.20))
        paths = published_paths(session, base)
        text = dump_frontmatter(fm, body)
        try:
            # Finding 2: O_CREAT|O_EXCL reserves the final path atomically;
            # truly concurrent publishers cannot both win the same seq.
            atomic_reserve_text(paths["md"], text, mode=0o600)
        except FileExistsError:
            old_seq = seq
            seq += 1
            base = f"{seq:03d}-{fm['author']}-{fm['kind']}"
            fm["seq"] = seq
            # Finding C1: surface the bump so concurrent publishing is
            # observable rather than silent.
            print(
                f"relay publish: seq {old_seq:03d} taken by concurrent "
                f"publisher, retrying as {seq:03d}",
                file=sys.stderr,
            )
            continue
        digest = sha256_of_file(paths["md"])
        atomic_write_text(paths["sha256"], f"{digest}  {paths['md'].name}\n", mode=0o600)
        atomic_write_bytes(paths["ready"], b"", mode=0o600)
        try:
            draft_path.unlink()
        except FileNotFoundError:
            pass
        _fsync_dir(session)
        # Best-effort: tear down any heartbeat the SKILL spawned for this draft.
        env_pub = load_env()
        try:
            cmd_heartbeat_stop(type("A", (), {
                "draft": str(draft_path), "force": True,
                "project": None, "pair_id": None,
            })())
        except Exception as exc:
            print(f"relay publish: heartbeat stop warning: {exc}", file=sys.stderr)
        if final_status in HARD_TERMINAL_STATUSES:
            # Hard-terminal publish ends this pair for good; drop the publisher's
            # binding (the peer self-heals its own dangling binding on its next
            # resolve). A `timed_out` publish is only a pause (resumable) — KEEP
            # the binding so the publisher can resume the round in-thread once
            # the user answers (issue 20260529T190821-0ec54be9).
            if env_pub.shared_root and env_pub.author and env_pub.agent_session_id:
                delete_binding(env_pub.shared_root, env_pub.author,
                               env_pub.agent_session_id)
        print(paths["md"])
        return 0
    print(
        "relay publish: could not allocate published path after 10 attempts; "
        "concurrent activity detected — wait briefly and retry, or run "
        "`relay doctor` to inspect.",
        file=sys.stderr,
    )
    return 2


def _read_field_source(label: str, value: str | None) -> str | None:
    """Resolve --body-file / --prompt-for-next-file value.

    Returns the field's text, or None if the user did not pass the flag.
    Value is either a file path or '-' for stdin. The caller is responsible
    for ensuring at most one source reads stdin per invocation.
    """
    if value is None:
        return None
    if value == "-":
        return sys.stdin.read()
    try:
        return Path(value).read_text(encoding="utf-8")
    except OSError as exc:
        raise ValueError(f"--{label}-file: cannot read {value}: {exc}") from exc


def cmd_draft_set(args) -> int:
    """Fill a draft's body / prompt_for_next / sync_needed / touched_paths /
    corrects without going through the agent's native Write tool (finding 9).

    Preserves seq, author, peer, kind, created, in_reply_to, status. The
    atomic write goes through a tmp+rename within the .draft/ dir.
    """
    draft_path = Path(args.draft_path).resolve()
    if not draft_path.exists():
        print(f"relay draft set: draft not found: {draft_path}", file=sys.stderr)
        return 2
    if draft_path.parent.name != ".draft":
        print(f"relay draft set: not under .draft/: {draft_path}", file=sys.stderr)
        return 2

    # Finding 1 (codex seq 2): draft set is a write boundary just like
    # publish. Without an author-ownership check, a peer who discovers a
    # draft path (e.g. via `relay status`, which lists draft names) can
    # rewrite the other author's draft body/prompt while preserving its
    # author frontmatter — reopening the authorship-forgery class that the
    # publish guard closes. Enforce ownership before any read/parse.
    _env_ds = load_env()
    if not _env_ds.author:
        print(
            "relay draft set: could not resolve author identity (no platform "
            "signal and RELAY_AUTHOR unset); refusing to mutate a draft "
            "without a known identity.",
            file=sys.stderr,
        )
        return 2
    m_ds = _DRAFT_NAME_RE.match(draft_path.name)
    if not m_ds:
        print(
            f"relay draft set: draft filename does not match NNN-author-kind.md "
            f"pattern: {draft_path.name}",
            file=sys.stderr,
        )
        return 2
    draft_author = m_ds.group(2)
    if draft_author != _env_ds.author:
        print(
            f"relay draft set: refusing to mutate a draft authored by "
            f"{draft_author!r} as {_env_ds.author!r} — only the draft's own "
            f"author may fill it.",
            file=sys.stderr,
        )
        return 2

    stdin_sources = sum(1 for v in (args.body_file, args.prompt_for_next_file) if v == "-")
    if stdin_sources > 1:
        print(
            "relay draft set: at most one of --body-file / --prompt-for-next-file "
            "may be '-' per invocation (stdin can only be read once).",
            file=sys.stderr,
        )
        return 2

    try:
        body_new = _read_field_source("body", args.body_file)
        pfn_new = _read_field_source("prompt-for-next", args.prompt_for_next_file)
    except ValueError as exc:
        print(f"relay draft set: {exc}", file=sys.stderr)
        return 2

    try:
        text = draft_path.read_text(encoding="utf-8")
        fm, body = parse_frontmatter(text)
    except (OSError, ValueError) as exc:
        print(f"relay draft set: cannot parse draft: {exc}", file=sys.stderr)
        return 2

    if body_new is not None:
        body = body_new
    if pfn_new is not None:
        fm["prompt_for_next"] = pfn_new
    if args.sync_needed:
        fm["sync_needed"] = True
    if args.touched_path:
        # Append (don't replace) — multiple set invocations should accumulate.
        existing = fm.get("touched_paths") or []
        for tp in args.touched_path:
            if tp not in existing:
                existing.append(tp)
        fm["touched_paths"] = existing
    if args.corrects is not None:
        if args.corrects < 1:
            print(
                f"relay draft set: --corrects must be a positive integer "
                f"(got {args.corrects})",
                file=sys.stderr,
            )
            return 2
        # Finding 3 (codex seq 2): don't let draft set stamp corrects onto a
        # kind that can't carry it. publish re-validates regardless.
        if fm.get("kind") not in CORRECTS_KINDS:
            print(
                f"relay draft set: --corrects is only valid for "
                f"{sorted(CORRECTS_KINDS)}, not kind {fm.get('kind')!r}.",
                file=sys.stderr,
            )
            return 2
        fm["corrects"] = args.corrects

    new_text = dump_frontmatter(fm, body)
    try:
        atomic_write_text(draft_path, new_text, mode=0o600)
    except OSError as exc:
        print(f"relay draft set: write failed: {exc}", file=sys.stderr)
        return 2
    print(draft_path)
    return 0


# ---------------------------------------------------------------------------
# issue ledger — machine-global feedback channel
# ---------------------------------------------------------------------------
#
# A place for agents to record problems they hit *while using the relay tool
# itself*, so a developer can triage them in a later dev cycle. The store is
# user-local machine storage: deliberately NOT under .shared/ (per-session,
# gitignored, ephemeral) and NOT under the repo (issues are about the tool,
# accumulated across every project/session for this user on this machine).
# `relay sync` never moves issues — they stay on the host that filed them.
# Default ~/.agent-ledger/relay-issues/, override via RELAY_ISSUES_DIR.
# Issues are a mutable tracker (resolve edits them), not append-only
# ledger artifacts.

ISSUE_SEVERITIES = {"minor", "major"}
ISSUE_AREAS = {"cli", "hooks", "docs", "protocol", "tests", "build", "other"}
ISSUE_STATUSES = {"open", "resolved"}
# An issue id is `YYYYMMDDThhmmss-<8hex>`; a triage prefix is a leading slice
# of that. The alphabet is digits + letters + hyphen ONLY. This regex is the
# security gate for `show`/`resolve` (codex v0.10 review finding 1): it rejects
# `/`, `\`, `.` (so `..` and absolute/relative paths cannot form) and every
# glob metacharacter, BEFORE the value is ever composed into a path.
_ISSUE_REF_RE = re.compile(r"^[0-9A-Za-z-]+$")


def issues_dir() -> Path:
    override = os.environ.get("RELAY_ISSUES_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".agent-ledger" / "relay-issues"


def _ensure_issues_dir() -> Path:
    d = issues_dir()
    d.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    return d


def _issue_id() -> str:
    stamp = datetime.now().astimezone().strftime("%Y%m%dT%H%M%S")
    return f"{stamp}-{uuid.uuid4().hex[:8]}"


def _read_issue(path: Path) -> Optional[tuple[dict, str]]:
    try:
        fm, body = parse_frontmatter(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return fm, body


def _resolve_issue(d: Path, ref: str) -> tuple[str, object]:
    """Resolve an issue reference (full id or leading prefix) to a file
    that lives DIRECTLY inside `d`.

    Returns one of:
      ("ok", Path)            unique match
      ("none", None)          no match
      ("ambiguous", [stems])  >1 prefix match — caller should disambiguate
      ("invalid", ref)        ref is not a safe id/prefix token

    Security (codex v0.10 finding 1): `ref` is validated against
    `_ISSUE_REF_RE` before any path composition, so `..`, `/`, absolute
    paths, and glob metacharacters can never reach the filesystem. As
    defense in depth we also confirm each candidate's resolved parent is
    exactly `d`, so even a symlink inside the store can't redirect us out.
    """
    if not ref or not _ISSUE_REF_RE.match(ref):
        return ("invalid", ref)
    if not d.is_dir():
        return ("none", None)
    d_resolved = d.resolve()
    matches: list[Path] = []
    for p in sorted(d.glob("*.md")):
        stem = p.stem
        if stem != ref and not stem.startswith(ref):
            continue
        try:
            if p.resolve().parent != d_resolved:
                continue  # symlink or odd entry pointing outside the store
        except OSError:
            continue
        matches.append(p)
    exact = [p for p in matches if p.stem == ref]
    if exact:
        return ("ok", exact[0])
    if len(matches) == 1:
        return ("ok", matches[0])
    if len(matches) > 1:
        return ("ambiguous", sorted(p.stem for p in matches))
    return ("none", None)


def _resolve_issue_or_report(cmd: str, d: Path, ref: str) -> Optional[Path]:
    """Shared show/resolve front-end: resolve `ref`, print the right error
    to stderr for the non-ok cases, and return the Path only on success."""
    status, value = _resolve_issue(d, ref)
    if status == "ok":
        return value  # type: ignore[return-value]
    if status == "invalid":
        print(f"relay issue {cmd}: invalid id {ref!r} — ids are "
              f"[0-9A-Za-z-] only (no path separators, '..', or globs).",
              file=sys.stderr)
    elif status == "ambiguous":
        cands = ", ".join(value)  # type: ignore[arg-type]
        print(f"relay issue {cmd}: ambiguous prefix {ref!r} matches "
              f"{len(value)} issues: {cands}. Use a longer prefix or the full id.",
              file=sys.stderr)
    else:  # none
        print(f"relay issue {cmd}: no issue matching {ref!r} in {d}",
              file=sys.stderr)
    return None


def cmd_issue_add(args) -> int:
    title = (getattr(args, "title", None) or "").strip()
    if not title:
        print("relay issue add: --title is required and must be non-empty",
              file=sys.stderr)
        return 2
    severity = getattr(args, "severity", None) or "minor"
    if severity not in ISSUE_SEVERITIES:
        print(f"relay issue add: --severity must be one of {sorted(ISSUE_SEVERITIES)}",
              file=sys.stderr)
        return 2
    area = getattr(args, "area", None) or "other"
    if area not in ISSUE_AREAS:
        print(f"relay issue add: --area must be one of {sorted(ISSUE_AREAS)}",
              file=sys.stderr)
        return 2

    body_inline = getattr(args, "body", None)
    body_file = getattr(args, "body_file", None)
    if body_inline is not None and body_file is not None:
        print("relay issue add: pass at most one of --body / --body-file",
              file=sys.stderr)
        return 2
    body = ""
    if body_inline is not None:
        body = body_inline
    elif body_file is not None:
        try:
            body = _read_field_source("body", body_file)
        except ValueError as exc:
            print(f"relay issue add: {exc}", file=sys.stderr)
            return 2

    env = load_env()
    # Best-effort pair context — issues can be filed with no active pair.
    session_id = None
    try:
        session_id = resolve_active_pair(env).name
    except SystemExit:
        session_id = None

    d = _ensure_issues_dir()
    body_text = body.strip() or title
    created = now_iso()
    reporter = env.author or "unknown"
    project = derive_project(env) or "unknown"
    # Reserve the file exclusively (codex v0.10 design call): id collision is
    # astronomically unlikely (timestamp + uuid8), but the safe primitive
    # already exists, so use it and regenerate the id on the off chance.
    for _ in range(5):
        issue_id = _issue_id()
        fm = {
            "id": issue_id, "created": created, "reporter": reporter,
            "project": project, "session": session_id,
            "severity": severity, "area": area, "title": title,
            "status": "open", "resolved_at": None, "resolution": None,
        }
        path = d / f"{issue_id}.md"
        try:
            atomic_reserve_text(path, dump_frontmatter(fm, body_text + "\n"),
                                mode=0o600)
        except FileExistsError:
            continue
        print(path)
        return 0
    print("relay issue add: could not allocate a unique issue id after 5 "
          "attempts — retry in a moment.", file=sys.stderr)
    return 2


def _scan_issues(d: Path) -> tuple[list[dict], list[str]]:
    """Return (parsed frontmatters, names of unreadable/unparseable files).

    A feedback ledger must never silently drop entries (codex v0.10
    finding 2): a corrupt or hand-edited file is exactly the kind of thing
    triage needs to SEE, not have hidden.
    """
    rows: list[dict] = []
    bad: list[str] = []
    if not d.is_dir():
        return rows, bad
    for p in sorted(d.glob("*.md")):
        parsed = _read_issue(p)
        if parsed is None:
            bad.append(p.name)
        else:
            rows.append(parsed[0])
    return rows, bad


def cmd_issue_list(args) -> int:
    d = issues_dir()
    status = getattr(args, "status", None) or "open"
    allowed = ISSUE_STATUSES | {"all"}
    if status not in allowed:
        print(f"relay issue list: --status must be one of {sorted(allowed)}",
              file=sys.stderr)
        return 2
    area = getattr(args, "area", None)
    all_fm, unreadable = _scan_issues(d)
    rows = []
    for fm in all_fm:
        if status != "all" and fm.get("status") != status:
            continue
        if area and fm.get("area") != area:
            continue
        rows.append(fm)
    if getattr(args, "json", False):
        # Object (not bare array) so unreadable files are always visible to
        # machine consumers, not silently dropped.
        print(json.dumps({"issues": rows, "unreadable": unreadable},
                         indent=2, ensure_ascii=False))
        return 1 if unreadable else 0
    if rows:
        print(f"{status} issues in {d}:")
        for fm in rows:
            print(f"  [{fm.get('severity','?'):5}] {fm.get('area','?'):8} "
                  f"{fm.get('id')}  {fm.get('title','')}")
            if fm.get("status") == "resolved" and fm.get("resolution"):
                print(f"          resolved: {fm.get('resolution')}")
    else:
        print(f"no {status} issues in {d}")
    if unreadable:
        print(f"relay issue list: WARNING {len(unreadable)} unreadable issue "
              f"file(s) skipped (inspect/fix manually): {', '.join(unreadable)}",
              file=sys.stderr)
        return 1
    return 0


def cmd_issue_show(args) -> int:
    d = issues_dir()
    path = _resolve_issue_or_report("show", d, args.id)
    if path is None:
        return 2
    if getattr(args, "json", False):
        parsed = _read_issue(path)
        if parsed is None:
            print(f"relay issue show: cannot parse {path}", file=sys.stderr)
            return 2
        fm, body = parsed
        print(json.dumps({"path": str(path), "frontmatter": fm, "body": body},
                         indent=2, ensure_ascii=False))
        return 0
    print(path.read_text(encoding="utf-8"))
    return 0


def cmd_issue_resolve(args) -> int:
    d = issues_dir()
    path = _resolve_issue_or_report("resolve", d, args.id)
    if path is None:
        return 2
    parsed = _read_issue(path)
    if parsed is None:
        print(f"relay issue resolve: cannot parse {path}", file=sys.stderr)
        return 2
    fm, body = parsed
    fm["status"] = "resolved"
    fm["resolved_at"] = now_iso()
    if getattr(args, "note", None):
        fm["resolution"] = args.note
    atomic_write_text(path, dump_frontmatter(fm, body), mode=0o600)
    print(path)
    return 0


def cmd_close(args) -> int:
    env = load_env()
    try:
        session = resolve_active_pair(
            env,
            getattr(args, "project", None),
            getattr(args, "pair_id", None),
        )
    except SystemExit as exc:
        msg = str(exc)
        if "multiple active pairs" in msg:
            print(f"relay close: {msg}", file=sys.stderr)
            return 2
        # Surface "already closed" instead of the generic "no active pair"
        # when a pair in the project already has a CLOSED sentinel.
        if "no active pair" in msg:
            try:
                root = session_root(env)
            except SystemExit:
                print(f"relay close: {msg}", file=sys.stderr)
                return 2
            for sd in iter_pair_dirs(root):
                if (sd / "CLOSED").exists():
                    print(
                        f"relay close: already closed (sentinel at {sd / 'CLOSED'})",
                        file=sys.stderr,
                    )
                    return 2
        print(f"relay close: {msg}", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, env.author or "")
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    sentinel = session / "CLOSED"
    if sentinel.exists():
        print(f"relay close: already closed (sentinel exists at {sentinel})", file=sys.stderr)
        return 2
    close_meta = (
        f'reason = {json.dumps(args.reason)}\n'
        f'outcome = {json.dumps(args.outcome or "")}\n'
        f'closed_by = {json.dumps(env.author or "unknown")}\n'
        f'closed_at = {json.dumps(now_iso())}\n'
    )
    atomic_write_text(sentinel, close_meta, mode=0o600)

    sj_path = session / "session.json"
    data = read_session_json(session)
    data["state"] = "closed"
    data["closed_at"] = now_iso()
    data["close_reason"] = args.reason
    atomic_write_json(sj_path, data)
    if env.shared_root and env.author and env.agent_session_id:
        delete_binding(env.shared_root, env.author, env.agent_session_id)

    print(f"closed: {session}")
    print(f"  reason:   {args.reason}")
    print(f"  outcome:  {args.outcome or '(none)'}")
    return 0


def _pair_list_payload(root: Path, *, scan_root: Path | None = None) -> list[dict]:
    # scan_root lets `pairs list --archived` enumerate `.shared/_archive/` while
    # bindings still resolve against the live root (archived pairs hold none) and
    # next_seq stays based on the scanned dir itself.
    scan_root = scan_root or root
    items: list[dict] = []
    for sd in iter_pair_dirs(scan_root):
        schema_error = None
        try:
            sj = read_session_json(sd)
        except SchemaVersionError as exc:
            sj = {}
            schema_error = exc.to_dict()
        except OSError:
            sj = {}
        category = schema_error["code"] if schema_error else session_category(sd)
        is_active = False if schema_error else session_is_active(sd)
        latest = latest_artifact_frontmatter(sd)
        bindings = binding_for_pair(root, sd.name)
        live = [b for b in bindings if not _binding_is_stale(b)]
        item = {
            "session_id": sd.name,
            "project": sj.get("project"),
            "title": sj.get("title"),
            "state": sj.get("state"),
            "category": category,
            "is_active": is_active,
            "bound_instances": [b.get("instance_id") for b in bindings],
            "authors": [b.get("author") for b in live],
            "open_slots": max(0, 2 - len(live)),
            "closed_sentinel": (sd / "CLOSED").exists(),
            "next_seq": latest_seq(sd) + 1,
            "latest": latest,
            "path": str(sd),
            "archived": scan_root != root,
        }
        if schema_error:
            item["schema_error"] = schema_error
        items.append(item)
    return items


def cmd_pairs_list(args) -> int:
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pairs list: {exc}", file=sys.stderr)
        return 2
    archived = bool(getattr(args, "archived", False))
    scan_root = archive_root(root) if archived else root
    payload = {
        "shared_root": str(root),
        "archived": archived,
        "pairs": _pair_list_payload(root, scan_root=scan_root),
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return 0
    label = f"archived pairs under {scan_root}" if archived else f"pairs under {root}"
    print(f"{label}:")
    if not payload["pairs"]:
        print("  (none)")
        return 0
    for item in payload["pairs"]:
        latest = item["latest"] or {}
        latest_desc = ""
        if latest:
            latest_desc = f" latest={latest.get('seq')}:{latest.get('status')}"
        bound = ",".join(i for i in item["bound_instances"] if i) or "-"
        print(
            f"  {item['session_id']}  {item['category']}"
            f" slots={item['open_slots']}/2 bound=[{bound}]{latest_desc}"
        )
    return 0


def cmd_pairs_archive(args) -> int:
    """Move terminated (or, with --force, active) pair dir(s) into `_archive/`.

    Keeps `.shared/` top level uncluttered. `--terminated` sweeps every
    closed/terminal pair (continue-and-report; any failure => exit 2; re-running
    is idempotent since archived pairs leave iter_pair_dirs). The move is atomic
    and bindings are dropped only AFTER a successful move (see _move_pair_dir)."""
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pairs archive: {exc}", file=sys.stderr)
        return 2
    if not root.is_dir():
        print(f"relay pairs archive: no shared root: {root} — run `relay init` first.",
              file=sys.stderr)
        return 2

    slug = getattr(args, "slug", None)
    terminated = bool(getattr(args, "terminated", False))
    force = bool(getattr(args, "force", False))

    if terminated and slug:
        print("relay pairs archive: pass either <slug> or --terminated, not both — "
              "run `relay pairs archive --terminated` to sweep all terminated pairs.",
              file=sys.stderr)
        return 2
    if not terminated and not slug:
        print("relay pairs archive: <slug> required (or --terminated to sweep) — "
              "run `relay pairs list` to see slugs.", file=sys.stderr)
        return 2

    arc = archive_root(root)
    if terminated:
        # --terminated is name-honest: only closed/terminal pairs. inactive/invalid
        # are left for `relay doctor` to inspect, not silently quarantined here.
        targets = [sd for sd in iter_pair_dirs(root)
                   if session_category(sd) in ("closed", "terminal")]
        if not targets:
            print("no terminated pairs to archive")
            return 0
    else:
        if not PAIR_SLUG_RE.match(slug):
            print(f"relay pairs archive: invalid pair slug {slug!r} — expected "
                  f"YYYYMMDD-topic; run `relay pairs list`.", file=sys.stderr)
            return 2
        sd = root / slug
        if not (sd / "session.json").exists():
            if (arc / slug / "session.json").exists():
                print(f"relay pairs archive: {slug!r} is already archived (at "
                      f"{arc / slug}) — run `relay pairs restore {slug}` to bring it "
                      f"back.", file=sys.stderr)
                return 2
            print(f"relay pairs archive: no pair {slug!r} under {root} — "
                  f"run `relay pairs list` to see slugs.", file=sys.stderr)
            return 2
        try:
            archive_active = session_is_active(sd)
        except SchemaVersionError as exc:
            print(f"relay pairs archive: {exc}", file=sys.stderr)
            return 2
        if archive_active and not force:
            print(f"relay pairs archive: {slug!r} is an active pair; run "
                  f"`relay close --pair-id {slug} --reason ...` first, or pass "
                  f"--force to shelve it.", file=sys.stderr)
            return 2
        if archive_active and force:
            draft = sd / ".draft"
            if draft.is_dir() and any(draft.glob("*.heartbeat")):
                print(f"note: {slug!r} has a live heartbeat sidecar; its daemon will "
                      f"self-expire after the move (no PID is signalled).")
        targets = [sd]

    arc.mkdir(mode=0o700, exist_ok=True)

    archived: list[str] = []
    failed: list[tuple[str, str]] = []
    for sd in targets:
        dst = arc / sd.name
        if dst.exists():
            failed.append((sd.name, f"destination already exists at {dst}"))
            continue
        try:
            _move_pair_dir(sd, dst)            # atomic rename + fsync BOTH parents
        except (OSError, FileExistsError) as exc:
            failed.append((sd.name, str(exc)))
            continue
        # Drop bindings only AFTER a successful move (codex review must-fix 2): if
        # the process dies between move and here, the binding points at a now-gone
        # root/<slug> and resolve_active_pair self-heals it as stale — strictly
        # safer than dropping first and then failing the move.
        for b in binding_for_pair(root, sd.name):
            delete_binding(root, b.get("author", ""), b.get("agent_session_id", ""))
        archived.append(sd.name)

    for name in archived:
        print(f"archived: {name} -> {arc / name}")
    for name, why in failed:
        print(f"relay pairs archive: failed to archive {name!r}: {why}",
              file=sys.stderr)
    return 2 if failed else 0


def cmd_pairs_restore(args) -> int:
    """Move an archived pair dir back from `_archive/` to the top level.

    The pair returns exactly as archived: session.json is untouched (closed stays
    closed; a --force-shelved active pair stays active but unbound) and NO binding
    is recreated — re-enter it with `relay pair join <slug>`."""
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pairs restore: {exc}", file=sys.stderr)
        return 2
    slug = args.slug
    if not PAIR_SLUG_RE.match(slug):
        print(f"relay pairs restore: invalid pair slug {slug!r} — expected "
              f"YYYYMMDD-topic; run `relay pairs list --archived`.", file=sys.stderr)
        return 2
    arc = archive_root(root)
    src = arc / slug
    if not (src / "session.json").exists():
        if (root / slug / "session.json").exists():
            print(f"relay pairs restore: {slug!r} is already live at {root / slug} — "
                  f"nothing to restore.", file=sys.stderr)
            return 2
        print(f"relay pairs restore: no archived pair {slug!r} under {arc} — run "
              f"`relay pairs list --archived` to see archived slugs.", file=sys.stderr)
        return 2
    dst = root / slug
    if dst.exists():
        print(f"relay pairs restore: cannot restore {slug!r}; a top-level entry "
              f"already exists at {dst} — rename or remove it first.", file=sys.stderr)
        return 2
    try:
        _move_pair_dir(src, dst)
    except (OSError, FileExistsError) as exc:
        print(f"relay pairs restore: failed to restore {slug!r}: {exc} — "
              f"check {src} and {dst}.", file=sys.stderr)
        return 2
    print(f"restored: {slug} -> {dst}")
    return 0


# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

def _is_fuse_mount(path: Path) -> bool:
    try:
        res = subprocess.run(
            ["stat", "-f", "-c", "%T", str(path)],
            capture_output=True, text=True, check=False,
        )
        if res.returncode == 0:
            t = res.stdout.strip()
            return t.startswith("fuse") or t == "fuseblk"
    except FileNotFoundError:
        pass
    return False


def _gitignore_has_negation(repo: Path) -> bool:
    gi = repo / ".gitignore"
    if not gi.exists():
        return False
    for ln in gi.read_text(errors="replace").splitlines():
        s = ln.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("!"):
            return True
    return False


def cmd_sync(args) -> int:
    env = load_env()
    top = git_toplevel()
    if not top:
        print("relay sync: not in a git repo (need project root)", file=sys.stderr)
        return 2
    project_root = top
    is_shape_a = _is_fuse_mount(project_root)
    sync_effective, sync_source = _resolve_sync(env, is_shape_a=is_shape_a)
    if sync_effective != "rsync":
        # Cover both "explicit none" and "could not resolve". Be specific about which.
        if sync_source == "env":
            reason = f"RELAY_SYNC={env.sync_raw!r}; this side does not own rsync transport"
        elif is_shape_a:
            reason = (f"$PROJECT_ROOT={project_root} is a fuse mount (shape A); "
                      "no sync needed (edits land on the remote directly)")
        else:
            reason = ("RELAY_SYNC defaults to 'none'; "
                      "set RELAY_SYNC=rsync on the side that owns the rsync transport")
        print(f"relay sync: {reason}", file=sys.stderr)
        return 2
    if not env.remote_ssh or not env.remote_path:
        print(
            "relay sync: RELAY_REMOTE_SSH and RELAY_REMOTE_PATH must be set "
            "(only the rsync owner runs sync; same-host or RELAY_SYNC=none "
            "sides skip this step). Run `relay sync push --dry-run` first.",
            file=sys.stderr,
        )
        return 2
    if is_shape_a:
        # Contradiction: RELAY_SYNC=rsync was explicitly set, but the project
        # root is itself the shared mount. Refuse rather than do a destructive
        # rsync over the mount.
        print(f"relay sync: $PROJECT_ROOT={project_root} is a fuse mount but "
              "RELAY_SYNC=rsync; refusing (shape A: nothing to sync)", file=sys.stderr)
        return 2

    direction = args.direction
    rsync_cmd: list[str] = ["rsync", "-avh", "--progress"]
    if args.dry_run:
        rsync_cmd.append("-n")
    if args.delete:
        rsync_cmd.append("--delete")

    if args.strict_gitignore and direction == "pull":
        # v1 only builds the file list from LOCAL git ls-files, which on pull
        # misses remote-only files — exactly what pull must recover. Rather
        # than silently lose data, refuse. v1.1 backlog: run ls-files on the
        # remote via ssh in $RELAY_REMOTE_PATH for honest strict pull.
        print(
            "relay sync: --strict-gitignore is not supported for pull in v1 "
            "(would use LOCAL file list and miss remote-only files). Use the "
            "default mode `relay sync pull` instead, or wait for v1.1.",
            file=sys.stderr,
        )
        return 2

    if args.strict_gitignore:
        # build file list via git (push only — local is the source of truth)
        files_list = subprocess.run(
            ["git", "-C", str(project_root), "ls-files", "--cached", "--others",
             "--exclude-standard", "-z"],
            capture_output=True, check=False,
        )
        if files_list.returncode != 0:
            print(f"relay sync: git ls-files failed: {files_list.stderr.decode()}",
                  file=sys.stderr)
            return 2
        tmpfile = Path(f"/tmp/relay-sync-{os.getpid()}-{uuid.uuid4().hex[:8]}.lst")
        tmpfile.write_bytes(files_list.stdout)
        rsync_cmd += ["--files-from", str(tmpfile), "--from0",
                       "--exclude=.git", "--exclude=.shared"]
    else:
        # default mode: --filter=':- .gitignore'
        print("WARNING: --filter=':- .gitignore' does NOT honor reverse !path rules.", file=sys.stderr)
        if _gitignore_has_negation(project_root):
            print("  Your .gitignore contains !path rules — STRONGLY recommend "
                  "--strict-gitignore.", file=sys.stderr)
        if not args.dry_run:
            print("  First sync? Run with --dry-run first.", file=sys.stderr)
        rsync_cmd += [
            "--filter=:- .gitignore",
            "--exclude=.git",
            "--exclude=.shared",
        ]

    src = f"{project_root}/"
    dst = f"{env.remote_ssh}:{env.remote_path}/"
    if direction == "push":
        rsync_cmd += [src, dst]
    elif direction == "pull":
        rsync_cmd += [dst, src]
    else:
        print(f"relay sync: unknown direction {direction!r}", file=sys.stderr)
        return 2

    print(f"$ {shlex.join(rsync_cmd)}", file=sys.stderr)
    res = subprocess.run(rsync_cmd, check=False)
    if args.strict_gitignore:
        try:
            tmpfile.unlink()
        except FileNotFoundError:
            pass
    return res.returncode


# ---------------------------------------------------------------------------
# heartbeat infrastructure (Stage 2): owner-identity model + double-fork daemon
# + on-entry GC.
#
# Heartbeat sidecar lives next to the draft as `<draft>.heartbeat` and contains
# JSON metadata; its mtime is the liveness signal consumed by `relay wait`
# (Stage 2 exit code 11) and by on-entry GC.
#
# Owner kinds (see decision artifact 20260528-stage3-renewal-design seq 9
# §4.3):
#   agent / tool-process               pid-based; os.kill(pid, 0)
#   pidfile                            reads pid from a file, then os.kill
#   renewal-file                       mtime within RELAY_RENEWAL_STALE_THRESHOLD
#                                      (default 3600s, floor 60s). Stage 3 wires the tick that
#                                      keeps it fresh; in Stage 2 alone, this
#                                      kind has no live writer so don't use it
#                                      as a default.
#   none                               always alive (explicit timeout-only mode)
#
# tmux-pane was advertised in the locked spec but the impl was not wired to
# `tmux list-panes -t <pane>`. The kind is removed for now; reintroduce when
# the tmux verification strategy is implemented (would need a string pane id,
# not --owner-pid int).
# ---------------------------------------------------------------------------


def _heartbeat_sidecar_path(draft_path: Path) -> Path:
    return draft_path.parent / f"{draft_path.name}.heartbeat"


def _heartbeat_pidfile_path(session: Path, author: str) -> Path:
    return session / "_relay" / f"{author}.heartbeat.pid"


def _owner_alive(kind: str, *, owner_pid: Optional[int] = None,
                 owner_pidfile: Optional[str] = None,
                 owner_renewal_file: Optional[str] = None) -> bool:
    if kind == "none":
        return True
    if kind in {"agent", "tool-process"}:
        if owner_pid is None:
            return False
        try:
            os.kill(owner_pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True  # exists, not ours; still alive
        except OSError:
            return False
        return True
    if kind == "pidfile":
        if not owner_pidfile:
            return False
        try:
            pid_text = Path(owner_pidfile).read_text(encoding="utf-8").strip()
            pid = int(pid_text)
        except (OSError, ValueError):
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        except OSError:
            return False
        return True
    if kind == "renewal-file":
        if not owner_renewal_file:
            return False
        try:
            mtime = os.stat(owner_renewal_file).st_mtime
        except FileNotFoundError:
            return False
        except OSError:
            return False
        threshold = max(_wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60)
        return mtime >= time.time() - threshold
    return False


def _heartbeat_daemon_main(sidecar_path: Path, pidfile_path: Path,
                            owner_kind: str, owner_pid: Optional[int],
                            owner_pidfile: Optional[str],
                            owner_renewal_file: Optional[str],
                            interval: int) -> None:
    """Daemon main loop — runs in the detached grandchild."""
    # Close stdio to fully detach.
    for fd in (0, 1, 2):
        try:
            os.close(fd)
        except OSError:
            pass
    # Reopen to /dev/null so any stray prints don't EPIPE.
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        os.dup2(devnull, 1)
        os.dup2(devnull, 2)
        if devnull > 2:
            os.close(devnull)
    except OSError:
        pass

    # Write pidfile.
    try:
        atomic_write_text(pidfile_path, f"{os.getpid()}\n", mode=0o600)
    except OSError:
        os._exit(1)

    interval = max(int(interval), 1)
    while True:
        try:
            time.sleep(interval)
            if not _owner_alive(owner_kind,
                                 owner_pid=owner_pid,
                                 owner_pidfile=owner_pidfile,
                                 owner_renewal_file=owner_renewal_file):
                os._exit(0)
            # Update mtime; the sidecar JSON is written once at start so the
            # waiter's stat-based stale check sees fresh mtime as the proof.
            try:
                os.utime(sidecar_path, None)
            except FileNotFoundError:
                # sidecar removed externally → caller must have stopped us
                os._exit(0)
        except KeyboardInterrupt:
            os._exit(0)
        except BaseException:
            os._exit(1)


def _spawn_heartbeat_daemon(sidecar_path: Path, pidfile_path: Path,
                             owner_kind: str, owner_pid: Optional[int],
                             owner_pidfile: Optional[str],
                             owner_renewal_file: Optional[str],
                             interval: int) -> int:
    """Double-fork; return the detached daemon's pid via pipe from grandchild."""
    r, w = os.pipe()
    first = os.fork()
    if first > 0:
        os.close(w)
        try:
            os.waitpid(first, 0)
            raw = os.read(r, 64)
        finally:
            os.close(r)
        try:
            return int(raw.decode().strip())
        except (ValueError, AttributeError):
            return -1
    # first child
    os.close(r)
    try:
        os.setsid()
    except OSError:
        pass
    second = os.fork()
    if second > 0:
        try:
            os.write(w, f"{second}\n".encode())
        finally:
            os.close(w)
        os._exit(0)
    # second child — the daemon
    os.close(w)
    _heartbeat_daemon_main(sidecar_path, pidfile_path,
                            owner_kind, owner_pid, owner_pidfile,
                            owner_renewal_file, interval)
    os._exit(0)


def _heartbeat_is_running(pidfile_path: Path) -> tuple[bool, Optional[int]]:
    if not pidfile_path.exists():
        return False, None
    try:
        pid = int(pidfile_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False, None
    try:
        os.kill(pid, 0)
        return True, pid
    except ProcessLookupError:
        return False, pid
    except PermissionError:
        return True, pid
    except OSError:
        return False, pid


def _heartbeat_drafts_for_author(session: Path, author: str) -> list[Path]:
    """Return draft .md files belonging to current author that have a heartbeat sidecar."""
    out: list[Path] = []
    draft_dir = session / ".draft"
    if not draft_dir.is_dir():
        return out
    prefix_re = re.compile(rf"^\d{{3}}-{re.escape(author)}-[a-z0-9-]+\.md$")
    for draft in draft_dir.glob("*.md"):
        if not prefix_re.match(draft.name):
            continue
        if _heartbeat_sidecar_path(draft).exists():
            out.append(draft)
    return out


def _gc_heartbeat_orphans(session: Path, author: str) -> None:
    """Kill orphan heartbeat daemons + remove their files.

    Decision matrix (per locked spec §4.4):
        daemon alive  | sidecar stale | owner alive | verdict
        ----------------------------------------------------------
        yes           | no            | yes         | live, leave alone
        yes           | no            | no          | orphan — kill daemon, clean
        yes           | yes           | any         | orphan — daemon hung, kill + clean
        yes           | n/a absent    | n/a         | pid reuse/sidecar loss — files-only clean
        no            | any           | any         | orphan — pidfile leak, clean

    Runs at the top of every session-scoped relay subcommand. Silent.
    """
    if not author:
        return
    pidfile = _heartbeat_pidfile_path(session, author)
    if not pidfile.exists():
        return
    running, pid = _heartbeat_is_running(pidfile)

    if not running:
        _heartbeat_purge(session, author, pidfile, pid=None)
        return

    # Daemon alive — inspect each of its sidecars. If any sidecar is stale or
    # its owner is dead, the daemon is no longer authoritative.
    interval = max(_wait_int_env("RELAY_HEARTBEAT_INTERVAL", 10), 1)
    factor = max(_wait_int_env("RELAY_HEARTBEAT_STALE_FACTOR", 3), 1)
    sidecar_stale_threshold = max(interval * factor, 60)
    cutoff = time.time() - sidecar_stale_threshold

    drafts = _heartbeat_drafts_for_author(session, author)
    if not drafts:
        # The pidfile points at a live PID, but relay has no heartbeat sidecar
        # proving that PID is ours. This is the PID-reuse/stale-pidfile shape:
        # clear only relay-owned files and never signal the unrelated process.
        time.sleep(0.1)
        drafts = _heartbeat_drafts_for_author(session, author)
        if not drafts:
            _heartbeat_purge_files_only(session, author, pidfile)
            return

    for draft in drafts:
        sidecar = _heartbeat_sidecar_path(draft)
        try:
            stat = sidecar.stat()
        except OSError:
            continue
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            data = {}
        sidecar_stale = stat.st_mtime < cutoff
        owner_kind = data.get("owner_kind") or "none"
        owner_alive = _owner_alive(
            owner_kind,
            owner_pid=data.get("owner_pid"),
            owner_pidfile=data.get("owner_pidfile"),
            owner_renewal_file=data.get("owner_renewal_file"),
        )
        if sidecar_stale or not owner_alive:
            _heartbeat_purge(session, author, pidfile, pid=pid)
            return  # purge clears every sidecar at once; one bad sidecar tears it all down


def _heartbeat_purge(session: Path, author: str, pidfile: Path,
                      pid: Optional[int]) -> None:
    """Kill daemon if alive, remove pidfile + sidecars."""
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.monotonic() + 1.0
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.05)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    _heartbeat_purge_files_only(session, author, pidfile)


def _heartbeat_purge_files_only(session: Path, author: str, pidfile: Path) -> None:
    """Remove relay-owned heartbeat files without signaling any PID."""
    try:
        pidfile.unlink()
    except OSError:
        pass
    for draft in _heartbeat_drafts_for_author(session, author):
        try:
            _heartbeat_sidecar_path(draft).unlink()
        except OSError:
            pass
    try:
        env = load_env()
        d = _renewal_dir_for(derive_project(env), session.name, author)
    except SystemExit:
        d = None
    if d is not None and d.is_dir():
        for renewal_file in d.glob("*.renewal"):
            try:
                renewal_file.unlink()
            except OSError:
                pass



def cmd_heartbeat_start(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat start: could not resolve author identity "
              "(no platform signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2
    if args.owner_kind not in OWNER_KINDS:
        print(
            f"relay heartbeat start: --owner-kind must be one of "
            f"{sorted(OWNER_KINDS)}, got {args.owner_kind!r}",
            file=sys.stderr,
        )
        return 2

    draft_path = Path(args.draft).resolve()
    if not draft_path.is_file() or draft_path.parent.name != ".draft":
        print(f"relay heartbeat start: --draft must point to a .draft/ file: {draft_path}",
              file=sys.stderr)
        return 2
    # Draft filename must encode an author that matches this instance's author;
    # otherwise the heartbeat would attach to someone else's in-flight work.
    m = _DRAFT_NAME_RE.match(draft_path.name)
    if not m:
        print(f"relay heartbeat start: malformed draft name: {draft_path.name}",
              file=sys.stderr)
        return 2
    draft_author = m.group(2)
    if draft_author != env.author:
        print(
            f"relay heartbeat start: draft author {draft_author!r} does not match "
            f"this instance's author {env.author!r}",
            file=sys.stderr,
        )
        return 2
    session = draft_path.parent.parent

    # Validate owner combination.
    if args.owner_kind in {"agent", "tool-process"} and args.owner_pid is None:
        print(f"relay heartbeat start: --owner-kind {args.owner_kind} requires --owner-pid",
              file=sys.stderr)
        return 2
    if args.owner_kind == "pidfile" and not args.owner_pidfile:
        print("relay heartbeat start: --owner-kind pidfile requires --owner-pidfile",
              file=sys.stderr)
        return 2
    renewal_created_for_start = False
    renewal_path_for_start = None
    if args.owner_kind == "renewal-file":
        # Scoped renewal path is ALWAYS derived internally — callers cannot pass
        # one in (per spec, prevents cross-session false-alive bypass).
        derived = _renewal_path_for_draft(draft_path, session, env)
        if derived is None:
            print(
                "relay heartbeat start: cannot derive renewal path "
                "(RELAY_PROJECT unset or author unresolved); set RELAY_PROJECT "
                "or run inside a git repo, with a resolvable author identity "
                "(platform signal or RELAY_AUTHOR).",
                file=sys.stderr,
            )
            return 2
        derived.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        renewal_path_for_start = derived
        renewal_created_for_start = not derived.exists()
        # Seed the renewal file so the daemon's first owner-alive check passes.
        if renewal_created_for_start:
            derived.touch(mode=0o600)
        else:
            os.utime(derived, None)
        args.owner_renewal_file = str(derived)

    # Immediate owner-alive check; refuse if dead at start.
    if args.owner_kind != "none":
        alive = _owner_alive(
            args.owner_kind,
            owner_pid=args.owner_pid,
            owner_pidfile=args.owner_pidfile,
            owner_renewal_file=getattr(args, "owner_renewal_file", None),
        )
        if not alive:
            print(
                f"relay heartbeat start: owner not alive at start "
                f"(kind={args.owner_kind}, pid={args.owner_pid}, "
                f"pidfile={args.owner_pidfile}); verify --owner-pid / "
                "--owner-pidfile points at a live process, or rerun "
                "with --owner-kind renewal-file (recommended for SKILL usage).",
                file=sys.stderr,
            )
            return 2

    pidfile = _heartbeat_pidfile_path(session, env.author)
    pidfile.parent.mkdir(parents=True, exist_ok=True)
    running, _existing_pid = _heartbeat_is_running(pidfile)
    if running:
        if renewal_created_for_start and renewal_path_for_start is not None:
            try:
                renewal_path_for_start.unlink(missing_ok=True)
            except OSError:
                pass
        print(
            f"relay heartbeat start: heartbeat already running for {env.author} "
            f"(pidfile {pidfile}); run `relay heartbeat stop --force` to "
            "clear it, or `relay doctor` to inspect.",
            file=sys.stderr,
        )
        return 3

    # Seed sidecar JSON.
    sidecar = _heartbeat_sidecar_path(draft_path)
    payload = {
        "heartbeat_pid": None,  # filled by daemon
        "owner_pid": args.owner_pid,
        "owner_kind": args.owner_kind,
        "owner_pidfile": args.owner_pidfile,
        "owner_renewal_file": getattr(args, "owner_renewal_file", None),
        "host": os.uname().nodename,
        "author": env.author,
        "draft": draft_path.name,
        "started_at": now_iso(),
        "last_beat": now_iso(),
    }
    atomic_write_text(sidecar, json.dumps(payload, indent=2) + "\n", mode=0o600)

    interval = args.interval if args.interval is not None else _wait_int_env(
        "RELAY_HEARTBEAT_INTERVAL", 10
    )
    pid = _spawn_heartbeat_daemon(
        sidecar, pidfile,
        args.owner_kind, args.owner_pid, args.owner_pidfile,
        getattr(args, "owner_renewal_file", None),
        interval,
    )
    if pid <= 0:
        sidecar.unlink(missing_ok=True)
        print("relay heartbeat start: failed to spawn daemon", file=sys.stderr)
        return 2

    # Wait briefly for the daemon to write its pidfile.
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if pidfile.exists():
            break
        time.sleep(0.05)

    # Patch sidecar with the actual daemon pid (best-effort).
    try:
        payload["heartbeat_pid"] = pid
        atomic_write_text(sidecar, json.dumps(payload, indent=2) + "\n", mode=0o600)
    except OSError:
        pass

    print(pid)
    return 0


def cmd_heartbeat_stop(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat stop: could not resolve author identity "
              "(no platform signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2

    draft_arg = getattr(args, "draft", None)
    if draft_arg:
        draft_path = Path(draft_arg).resolve()
        if draft_path.parent.name != ".draft":
            print(f"relay heartbeat stop: --draft must point under .draft/: {draft_path}",
                  file=sys.stderr)
            return 2
        session = draft_path.parent.parent
    else:
        try:
            session = resolve_active_pair(
                env,
                getattr(args, "project", None),
                getattr(args, "pair_id", None),
            )
        except SystemExit as exc:
            print(f"relay heartbeat stop: {exc}", file=sys.stderr)
            return 2
        draft_path = None

    pidfile = _heartbeat_pidfile_path(session, env.author)
    if not pidfile.exists() and not args.force:
        # Nothing to do; considered success.
        return 0

    running, pid = _heartbeat_is_running(pidfile)
    if running and pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        # Wait briefly then SIGKILL if still alive.
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.1)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass

    # Remove pidfile.
    try:
        pidfile.unlink()
    except OSError:
        pass
    # Remove sidecar(s) and renewal file(s).
    if draft_path is not None:
        try:
            _heartbeat_sidecar_path(draft_path).unlink()
        except OSError:
            pass
        renewal = _renewal_path_for_draft(draft_path, session, env)
        if renewal is not None:
            try:
                renewal.unlink()
            except OSError:
                pass
    else:
        for draft in _heartbeat_drafts_for_author(session, env.author):
            try:
                _heartbeat_sidecar_path(draft).unlink()
            except OSError:
                pass
        d = _renewal_dir(session, env)
        if d is not None and d.is_dir():
            for f in d.glob("*.renewal"):
                try:
                    f.unlink()
                except OSError:
                    pass
    return 0


# ---------------------------------------------------------------------------
# Stage 3: renewal protocol
#
# Renewal files live locally on each side (not in .shared/, since sshfs
# attribute caching is exactly what mtime-based renewal must not depend on).
# Path scope: $XDG_RUNTIME_DIR/relay/<project>/<session>/<author>/<draft>.renewal
#
# Each session-scoped relay subcommand auto-ticks the renewal file(s) for the
# current author in the resolved session. As long as the SKILL keeps making
# relay calls, the renewal stays fresh; when the SKILL stops (e.g. user Ctrl-C
# mid-think), the renewal goes stale, the heartbeat daemon sees its owner is
# dead (via _owner_alive(renewal-file)), and stops touching the shared
# heartbeat sidecar. Peer's `wait` then detects the stale heartbeat → exit 11.
# ---------------------------------------------------------------------------

_tick_in_flight = False  # recursion guard for auto-tick at subcommand entries


def _renewal_dir_for(project: Optional[str], session_id: str, author: str) -> Optional[Path]:
    """Resolve the local renewal directory. Returns None if project/author is unknown."""
    if not project or not author or not session_id:
        return None
    base = (
        os.environ.get("XDG_RUNTIME_DIR")
        or os.environ.get("TMPDIR")
        or "/tmp"
    )
    return Path(base) / "relay" / project / session_id / author


def _renewal_dir(session: Path, env: Env) -> Optional[Path]:
    return _renewal_dir_for(derive_project(env), session.name, env.author or "")


def _renewal_path_for_draft(draft_path: Path, session: Path, env: Env) -> Optional[Path]:
    d = _renewal_dir(session, env)
    if d is None:
        return None
    # draft_path is like 001-claude-plan.md; strip .md for the renewal basename.
    return d / f"{draft_path.stem}.renewal"


def _maybe_tick_renewal(session: Path, env: Env) -> None:
    """Best-effort: refresh all renewal files in the current session/author scope."""
    global _tick_in_flight
    if _tick_in_flight:
        return
    d = _renewal_dir(session, env)
    if d is None or not d.is_dir():
        return
    _tick_in_flight = True
    try:
        for renewal_file in d.glob("*.renewal"):
            try:
                os.utime(renewal_file, None)
            except OSError:
                pass
    finally:
        _tick_in_flight = False


def _gc_renewal_orphans(session: Path, env: Env) -> None:
    """Remove renewal files whose corresponding heartbeat sidecar is gone."""
    d = _renewal_dir(session, env)
    if d is None or not d.is_dir():
        return
    active_basenames = {
        draft.stem for draft in _heartbeat_drafts_for_author(session, env.author or "")
    }
    for renewal_file in d.glob("*.renewal"):
        if renewal_file.stem not in active_basenames:
            try:
                renewal_file.unlink()
            except OSError:
                pass


def cmd_heartbeat_tick(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat tick: could not resolve author identity "
              "(no platform signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2
    try:
        session = resolve_active_pair(
            env,
            getattr(args, "project", None),
            getattr(args, "pair_id", None),
        )
    except SystemExit as exc:
        print(f"relay heartbeat tick: {exc}", file=sys.stderr)
        return 2
    _maybe_tick_renewal(session, env)
    return 0


# ---------------------------------------------------------------------------
# cmd_wait — block until peer publishes a new artifact targeting this author
# ---------------------------------------------------------------------------

# Exit codes (see decision artifact 20260528-stage3-renewal-design seq 9 §3.1):
#   0   new .ready targeted at me; stdout = absolute artifact path
#   10  timeout (RELAY_WAIT_TIMEOUT seconds elapsed)
#   11  peer heartbeat stale (Stage 2/3 only; never emitted in Stage 1)
#   12  session entered terminal state; stdout = one-line status
#   130 SIGINT (shell convention: 128 + 2)
#   2   protocol / mount / env / collision error; stderr = error message


def _wait_int_env(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        v = int(raw)
    except ValueError:
        return default
    return v


_DURATION_RE = re.compile(r"^(\d+)([smhd])$")


def _parse_duration(s: str) -> Optional[int]:
    """Parse '1h', '30m', '1d', '7200s' -> seconds. Returns None on invalid."""
    m = _DURATION_RE.match(s.strip())
    if not m:
        return None
    n = int(m.group(1))
    mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
    return n * mult


def cmd_doctor(args) -> int:
    """Report stale relay state; optionally clean owner-safe recoverable files.

    Exit codes:
      0 — no findings
      1 — findings reported (whether or not --fix ran)
      2 — protocol/env error
    """
    env = load_env()
    if not env.shared_root or not env.shared_root.is_dir():
        print("relay doctor: RELAY_SHARED_ROOT not set or missing", file=sys.stderr)
        return 2

    older_than_secs: Optional[int] = None
    if getattr(args, "older_than", None):
        older_than_secs = _parse_duration(args.older_than)
        if older_than_secs is None:
            print(
                f"relay doctor: invalid --older-than {args.older_than!r}; "
                "use '<n>s|m|h|d' (e.g. 1h, 30m, 1d).",
                file=sys.stderr,
            )
            return 2
        if not args.fix:
            print(
                "relay doctor: --older-than has no effect without --fix; "
                "drop --older-than for a report-only run.",
                file=sys.stderr,
            )
            return 2

    report = {
        "shared_root": str(env.shared_root),
        "author": env.author,
        "sessions": [],
        "actions": [],
        "findings_count": 0,
    }
    actions: list[str] = report["actions"]
    findings = 0

    for sd in iter_pair_dirs(env.shared_root):
        entry = {
            "session_id": sd.name,
            "is_active": False,
            "drafts": [],
            "heartbeat_pidfile": None,
            "heartbeat_sidecars": [],
            "incomplete_triads": [],
            "schema_error": None,
        }
        try:
            entry["is_active"] = session_is_active(sd)
        except SchemaVersionError as exc:
            entry["schema_error"] = exc.to_dict()
            findings += 1
            report["sessions"].append(entry)
            continue
        # Drafts
        draft_dir = sd / ".draft"
        if draft_dir.is_dir():
            for d in sorted(draft_dir.glob("[0-9][0-9][0-9]-*.md")):
                try:
                    age = int(time.time() - d.stat().st_mtime)
                except OSError:
                    continue
                entry["drafts"].append({"name": d.name, "age_seconds": age})
                findings += 1
        # Heartbeat (only inspect current author's lane to avoid cross-author claims)
        if env.author:
            pidfile = _heartbeat_pidfile_path(sd, env.author)
            if pidfile.exists():
                running, pid = _heartbeat_is_running(pidfile)
                entry["heartbeat_pidfile"] = {
                    "path": str(pidfile),
                    "pid": pid,
                    "alive": running,
                }
                findings += 1
                if args.fix and not running:
                    pidfile.unlink(missing_ok=True)
                    actions.append(f"removed dead pidfile {pidfile}")
            if draft_dir.is_dir():
                for sc in sorted(draft_dir.glob("*.heartbeat")):
                    try:
                        data = json.loads(sc.read_text(encoding="utf-8"))
                        if data.get("author") != env.author:
                            continue
                        age = int(time.time() - sc.stat().st_mtime)
                    except (OSError, ValueError):
                        continue
                    entry["heartbeat_sidecars"].append(
                        {"name": sc.name, "age_seconds": age}
                    )
                    findings += 1
        triad_findings = _published_triad_findings(sd)
        entry["incomplete_triads"] = triad_findings
        findings += len(triad_findings)
        # Draft GC (only with --fix + --older-than).
        # Two safety constraints (codex cross-review 2026-05-29):
        #   (a) Never delete a draft whose sibling .heartbeat sidecar is
        #       fresh — the draft is still being worked on, mtime alone
        #       can lag if the author is not touching the .md file.
        #   (b) When a draft IS deleted, also unlink its .heartbeat sidecar
        #       so `relay wait` does not later observe a stale peer
        #       heartbeat and return exit 11.
        if args.fix and older_than_secs is not None and draft_dir.is_dir():
            hb_fresh_threshold = max(
                _wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60
            )
            for d in sorted(draft_dir.glob("[0-9][0-9][0-9]-*.md")):
                try:
                    age = int(time.time() - d.stat().st_mtime)
                except OSError:
                    continue
                if age < older_than_secs:
                    continue
                sidecar = _heartbeat_sidecar_path(d)
                if sidecar.exists():
                    try:
                        hb_age = time.time() - sidecar.stat().st_mtime
                    except OSError:
                        hb_age = float("inf")
                    if hb_age < hb_fresh_threshold:
                        actions.append(
                            f"skipped {d}: heartbeat sidecar is fresh "
                            f"({int(hb_age)}s < {hb_fresh_threshold}s)"
                        )
                        continue
                try:
                    d.unlink()
                    actions.append(f"deleted abandoned draft {d}")
                except OSError as exc:
                    actions.append(f"failed to delete draft {d}: {exc}")
                    continue
                if sidecar.exists():
                    try:
                        sidecar.unlink()
                        actions.append(f"removed stale heartbeat sidecar {sidecar}")
                    except OSError as exc:
                        actions.append(
                            f"failed to remove heartbeat sidecar {sidecar}: {exc}"
                        )
        # Published triad GC (only with --fix + --older-than).
        # A valid publish writes md -> sha256 -> ready, then removes the draft.
        # The owner-safe predicate mirrors draft GC: old published-position
        # leftovers can be deleted only when the matching draft is absent or its
        # heartbeat is stale. A fresh matching draft heartbeat means publish may
        # still be in the md/sha/ready window, so doctor must report but not fix.
        if args.fix and older_than_secs is not None and triad_findings:
            hb_fresh_threshold = max(
                _wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60
            )
            for triad in triad_findings:
                age = triad.get("age_seconds")
                if age is None or age < older_than_secs:
                    continue
                draft = sd / ".draft" / triad["name"]
                if draft.exists():
                    sidecar = _heartbeat_sidecar_path(draft)
                    if sidecar.exists():
                        try:
                            hb_age = time.time() - sidecar.stat().st_mtime
                        except OSError:
                            hb_age = float("inf")
                        if hb_age < hb_fresh_threshold:
                            actions.append(
                                f"skipped incomplete triad {triad['base']}: "
                                f"matching draft heartbeat is fresh "
                                f"({int(hb_age)}s < {hb_fresh_threshold}s)"
                            )
                            continue
                paths = published_paths(sd, triad["base"])
                removed: list[str] = []
                failed = False
                for p in (paths["md"], paths["sha256"], paths["ready"]):
                    if not p.exists():
                        continue
                    try:
                        p.unlink()
                        removed.append(p.name)
                    except OSError as exc:
                        actions.append(
                            f"failed to delete incomplete triad file {p}: {exc}"
                        )
                        failed = True
                if removed:
                    actions.append(
                        f"deleted incomplete published triad {triad['base']}: "
                        + ", ".join(removed)
                    )
                    _fsync_dir(sd)
                elif not failed:
                    actions.append(
                        f"skipped incomplete triad {triad['base']}: no files remained"
                    )
        report["sessions"].append(entry)

    # Stale binding GC (v0.13). Bindings carry no PID — delete_binding removes
    # files only, never signals a process (mirrors _heartbeat_purge_files_only).
    report["stale_bindings"] = []
    report["unsupported_bindings"] = []
    for b in list_bindings(env.shared_root, include_schema_errors=True):
        if b.get("_schema_error"):
            report["unsupported_bindings"].append(b["_schema_error"])
            findings += 1
            continue
        if _binding_is_stale(b):
            report["stale_bindings"].append(b.get("instance_id") or b.get("author"))
            findings += 1
            if args.fix:
                delete_binding(env.shared_root, b.get("author", ""),
                               b.get("agent_session_id", ""))
                actions.append(f"removed stale binding {b.get('instance_id')}")
    # Legacy global marker left by pre-v0.13 bootstraps — harmless, informational.
    legacy = env.shared_root / ".active-session"
    report["legacy_active_session"] = str(legacy) if legacy.exists() else None

    report["findings_count"] = findings

    if getattr(args, "json", False):
        print(json.dumps(report, indent=2))
    else:
        _print_doctor_text(report, fix=bool(args.fix))

    return 1 if findings > 0 else 0


def _print_doctor_text(report: dict, *, fix: bool) -> None:
    print(f"relay doctor :: {report['shared_root']}")
    sessions = report.get("sessions", [])
    sessions_with_findings = [s for s in sessions if _doctor_session_has_findings(s)]
    clean_sessions = len(sessions) - len(sessions_with_findings)
    print(
        f"author: {report['author'] or '(unset)'} | "
        f"sessions: {len(sessions)} total, "
        f"{len(sessions_with_findings)} with findings, {clean_sessions} clean hidden"
    )
    if sessions_with_findings:
        print("\nsessions with findings:")
    for s in sessions_with_findings:
        marker = "[active]" if s["is_active"] else "[inactive]"
        parts = []
        if s["drafts"]:
            parts.append(f"drafts={len(s['drafts'])}")
        if s["heartbeat_pidfile"]:
            hp = s["heartbeat_pidfile"]
            parts.append("heartbeat_pidfile=" + ("alive" if hp["alive"] else "dead"))
        if s["heartbeat_sidecars"]:
            parts.append(f"heartbeat_sidecars={len(s['heartbeat_sidecars'])}")
        if s["incomplete_triads"]:
            parts.append(f"incomplete_triads={len(s['incomplete_triads'])}")
        if s.get("schema_error"):
            parts.append(s["schema_error"]["code"])
        detail = f" ({', '.join(parts)})" if parts else ""
        print(f"  - {s['session_id']} {marker}{detail}")
        if s.get("schema_error"):
            print(f"    schema: {s['schema_error']['message']}")
        if s["drafts"]:
            print("    drafts:")
            for d in s["drafts"]:
                print(f"      {d['name']} age={d['age_seconds']}s")
        hp = s["heartbeat_pidfile"]
        if hp:
            tag = "alive" if hp["alive"] else "DEAD"
            print(f"    heartbeat pidfile: pid={hp['pid']} {tag} {hp['path']}")
        if s["heartbeat_sidecars"]:
            print("    heartbeat sidecars:")
            for sc in s["heartbeat_sidecars"]:
                print(f"      {sc['name']} age={sc['age_seconds']}s")
        if s["incomplete_triads"]:
            print("    incomplete published triads:")
            for triad in s["incomplete_triads"]:
                problems = ",".join(triad["problems"])
                age = triad["age_seconds"]
                age_text = f"{age}s" if age is not None else "unknown"
                print(f"      {triad['base']} problems={problems} age={age_text}")
    if report.get("stale_bindings"):
        print("\nstale bindings:")
        for ib in report["stale_bindings"]:
            print(f"  - {ib}")
    if report.get("unsupported_bindings"):
        print("\nunsupported bindings:")
        for err in report["unsupported_bindings"]:
            print(f"  - {err['message']}")
    if report.get("legacy_active_session"):
        print(f"\nnote: pre-v0.13 .active-session marker present (harmless): "
              f"{report['legacy_active_session']}")
    if report["actions"]:
        print("\nactions taken:")
        for a in report["actions"]:
            print(f"  - {a}")
    print(f"\nsummary: {report['findings_count']} findings"
          f"{' (fix applied)' if fix else ''}")


def _doctor_session_has_findings(session: dict) -> bool:
    return bool(
        session.get("drafts")
        or session.get("heartbeat_pidfile")
        or session.get("heartbeat_sidecars")
        or session.get("incomplete_triads")
        or session.get("schema_error")
    )


def cmd_wait(args) -> int:
    env = load_env()
    if not env.author:
        print("relay wait: could not resolve author identity "
              "(no platform signal and RELAY_AUTHOR unset)", file=sys.stderr)
        return 2

    require_binding = bool(getattr(args, "require_binding", False))
    try:
        session = resolve_active_pair(
            env,
            getattr(args, "project", None),
            getattr(args, "pair_id", None),
            require_binding=require_binding,
        )
    except SystemExit as exc:
        msg = str(exc)
        hint = ""
        if "no active pair" in msg:
            hint = " — run `relay pairs list` to see existing pairs, or `relay bootstrap --topic <slug>` to start a new one."
        elif "multiple active pairs" in msg:
            hint = " — run `relay pair ensure` / `relay pair join <slug>`, or pass `--pair-id <id>`."
        print(f"relay wait: {msg}{hint}", file=sys.stderr)
        return 2
    if session is None:
        # Strict --require-binding and no live binding: nothing to wait on.
        # Refuse rather than block on a sole-active pair this instance never
        # joined (same identity boundary as `status --require-binding`).
        print("relay wait: not bound to any pair (--require-binding); nothing "
              "to wait for — run `relay pair ensure` / `relay pair join <slug>`, "
              "or pass `--pair-id`.", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, env.author)
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)

    cli_timeout = getattr(args, "timeout", None)
    cli_no_timeout = bool(getattr(args, "no_timeout", False))
    cli_poll = getattr(args, "poll", None)
    if cli_no_timeout:
        timeout = None  # sentinel: skip nominal deadline; stale-heartbeat escape remains
    else:
        timeout = cli_timeout if cli_timeout is not None else _wait_int_env("RELAY_WAIT_TIMEOUT", 3600)
        if timeout < 0:
            timeout = 0
    poll = cli_poll if cli_poll is not None else _wait_int_env("RELAY_WAIT_POLL_INTERVAL", 2)
    if poll <= 0:
        poll = 1

    def _terminal_exit() -> int:
        fm = latest_artifact_frontmatter(session)
        status = (fm or {}).get("status") or "closed"
        print(status)
        return 12

    # Entry: if the latest artifact is already targeting me, return it immediately.
    pub_entry = list_published(session)
    if pub_entry:
        try:
            fm_last, _ = parse_frontmatter(pub_entry[-1].read_text(encoding="utf-8"))
        except (OSError, ValueError):
            fm_last = None
        if fm_last and fm_last.get("peer") == env.author:
            print(pub_entry[-1])
            return 0
    # Finding 1: baseline must exclude in-flight peer drafts, otherwise a
    # peer publishing the same seq they had open at wait entry is filtered.
    baseline_seq = latest_published_seq(session)

    if not session_is_active(session):
        return _terminal_exit()

    # Stage 3 wait policy:
    #   - No peer renewal-file heartbeat is visible → use nominal timeout
    #     (returns exit 10 if no peer artifact arrives in time).
    #   - Peer renewal-file heartbeat IS visible at any point during the loop →
    #     defer to its mtime as the liveness signal. Stale heartbeat → exit 11.
    #     Fresh heartbeat → keep polling (no nominal timeout while peer is alive).
    #
    # Detection must be DYNAMIC inside the loop: peer typically starts the
    # heartbeat after we already entered wait, so a once-only snapshot at entry
    # would miss it.
    stale_threshold = max(_wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60)
    nominal_deadline = None if timeout is None else time.monotonic() + timeout
    # Peer for the stale-heartbeat check comes from session.json participants
    # (never RELAY_PEER). Fixed for the duration of this wait.
    wait_peer = resolve_peer(session, env.author or "") or ""

    # Optional readiness sentinel for tests / supervisors that need to know
    # the poll loop has been reached (e.g. to send SIGINT reliably without
    # a `time.sleep()` race). Unset in normal operation.
    ready_sentinel = os.environ.get("RELAY_WAIT_READY_SENTINEL")
    if ready_sentinel:
        try:
            Path(ready_sentinel).touch()
        except OSError:
            pass  # best-effort signal; not protocol-critical

    try:
        while True:
            for pub in list_published(session):
                m = _DRAFT_NAME_RE.match(pub.name)
                if not m:
                    continue
                seq = int(m.group(1))
                if seq <= baseline_seq:
                    continue
                try:
                    fm, _body = parse_frontmatter(pub.read_text(encoding="utf-8"))
                except (OSError, ValueError):
                    continue
                if fm.get("peer") == env.author:
                    print(pub)
                    return 0
                baseline_seq = max(baseline_seq, seq)

            if not session_is_active(session):
                return _terminal_exit()

            # Dynamic peer-heartbeat detection: re-check every iteration.
            has_renewal_file_peer = _peer_has_renewal_file_heartbeat(
                session, wait_peer
            )
            if has_renewal_file_peer:
                if _peer_heartbeat_is_stale(session, wait_peer, stale_threshold):
                    return 11
                # heartbeat is fresh → keep polling, ignore nominal timeout
            else:
                # No peer heartbeat seen yet → honor nominal timeout
                # unless --no-timeout was passed (nominal_deadline is None).
                if nominal_deadline is not None and time.monotonic() >= nominal_deadline:
                    return 10

            time.sleep(poll)
    except KeyboardInterrupt:
        return 130


def _peer_heartbeat_sidecars(session: Path, peer: str) -> list[Path]:
    """List heartbeat sidecars (`.draft/*.heartbeat`) belonging to peer."""
    if not peer:
        return []
    draft_dir = session / ".draft"
    if not draft_dir.is_dir():
        return []
    out: list[Path] = []
    for sidecar in draft_dir.glob("*.heartbeat"):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("author") == peer:
            out.append(sidecar)
    return out


def _peer_has_renewal_file_heartbeat(session: Path, peer: str) -> bool:
    for sidecar in _peer_heartbeat_sidecars(session, peer):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("owner_kind") == "renewal-file":
            return True
    return False


def _peer_heartbeat_is_stale(session: Path, peer: str, threshold: int) -> bool:
    """Stale-renewal detection: only renewal-file kind sidecars count.

    Spec restricts wait exit 11 to a stale peer owner_kind=renewal-file heartbeat;
    pid-based or `none` sidecars must not trigger it.
    """
    cutoff = time.time() - threshold
    for sidecar in _peer_heartbeat_sidecars(session, peer):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("owner_kind") != "renewal-file":
            continue
        try:
            mtime = sidecar.stat().st_mtime
        except OSError:
            continue
        if mtime < cutoff:
            return True
    return False


# ---------------------------------------------------------------------------
# hooks subcommand — install/manage cross-platform hook integration
# ---------------------------------------------------------------------------

HOOKS_DIR = RELAY_PACKAGE_DIR / "hooks"
HOOK_SCRIPT = HOOKS_DIR / "relay-hook.py"
HOOK_FRAGMENT_CLAUDE = HOOKS_DIR / "install-targets" / "claude-settings-fragment.json"
HOOK_FRAGMENT_CODEX = HOOKS_DIR / "install-targets" / "codex-hooks-fragment.json"
HOOK_MANAGED_MARKER = "_agent_relay_managed"
HOOK_EVENTS = ("SessionStart", "PreToolUse", "Stop")


def _hooks_target_path(target: str) -> Path:
    if target == "claude":
        return Path.home() / ".claude" / "settings.json"
    if target == "codex":
        return Path.home() / ".codex" / "hooks.json"
    raise ValueError(f"unknown hooks target: {target}")


def _hooks_render_command() -> str:
    """Render the hook command, shell-quoted and PATH-independent.

    Two robustness requirements baked in:

    1. `sys.executable` as an absolute path: Codex spawns hooks with a
       stripped PATH (no /usr/bin), so a `#!/usr/bin/env python3` shebang
       can't resolve `python3` (exit 127). Absolute interpreter fixes it.
    2. **Fail open if the dispatcher script is missing** (issue
       20260529T092859): command hooks are run via the shell, so we guard
       with `[ -f <script> ] || exit 0` BEFORE exec'ing python. If
       relay-hook.py is absent (e.g. the package dir got moved/deleted),
       the hook exits 0 (allow) instead of the OS erroring `can't open
       file` and the host blocking every Edit/Write — which previously
       wedged the whole session. `exec` keeps stdin (the event JSON) and
       the response stdout intact; shell builtins `[`/`exec` need no PATH.
    """
    py = shlex.quote(sys.executable)
    script = shlex.quote(str(HOOK_SCRIPT))
    return f"[ -f {script} ] || exit 0; exec {py} {script}"


def _hooks_load_fragment(target: str) -> dict:
    path = HOOK_FRAGMENT_CLAUDE if target == "claude" else HOOK_FRAGMENT_CODEX
    raw = path.read_text(encoding="utf-8")
    raw = raw.replace("{RELAY_HOOK_COMMAND}", _hooks_render_command())
    return json.loads(raw)


def _hooks_read_config(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"relay hooks: cannot parse {path}: {exc}")


def _hooks_strip_managed(config: dict) -> dict:
    """Return config with all `_agent_relay_managed` entries removed."""
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        return config
    for event, entries in list(hooks.items()):
        if not isinstance(entries, list):
            continue
        kept = [e for e in entries if not (isinstance(e, dict) and e.get(HOOK_MANAGED_MARKER))]
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    if not hooks:
        config.pop("hooks", None)
    return config


def _hooks_merge(config: dict, fragment: dict) -> tuple[dict, list[str]]:
    """Append-after merge: managed entries land at the END of each event array.

    Existing entries (oh-my-codex etc.) keep their position and trust key
    indices. Returns (new_config, summary_lines).
    """
    summary: list[str] = []
    config = _hooks_strip_managed(config)  # idempotent: drop previous-version managed
    target_hooks = config.setdefault("hooks", {})
    frag_hooks = fragment.get("hooks", {})
    for event in HOOK_EVENTS:
        new_entries = frag_hooks.get(event, [])
        if not new_entries:
            continue
        existing = target_hooks.get(event, [])
        if not isinstance(existing, list):
            existing = []
        merged = existing + new_entries  # append-after
        target_hooks[event] = merged
        summary.append(
            f"  {event}: appended at index {len(existing)} "
            f"(existing entries: {len(existing)})"
        )
    return config, summary


def _hooks_atomic_write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    atomic_write_text(path, text, mode=0o600)


def cmd_hooks_install(args) -> int:
    if not HOOK_SCRIPT.exists():
        print(f"relay hooks: dispatcher missing at {HOOK_SCRIPT}", file=sys.stderr)
        return 2
    if not os.access(HOOK_SCRIPT, os.X_OK):
        print(f"relay hooks: dispatcher is not executable: {HOOK_SCRIPT}\n"
              f"  fix: chmod +x {HOOK_SCRIPT}", file=sys.stderr)
        return 2

    targets = ["claude", "codex"] if args.target == "both" else [args.target]
    for target in targets:
        cfg_path = _hooks_target_path(target)
        fragment = _hooks_load_fragment(target)
        existing = _hooks_read_config(cfg_path)
        merged, summary = _hooks_merge(existing, fragment)

        print(f"target: {target}  ({cfg_path})")
        if args.dry_run:
            print("  (dry-run; no changes written)")
        else:
            _hooks_atomic_write_json(cfg_path, merged)
        for line in summary:
            print(line)

    print()
    print("Next steps:")
    print(f"  • dispatcher: {HOOK_SCRIPT}")
    print("  • Claude Code: hooks take effect at the next session start")
    if "codex" in targets:
        print("  • Codex CLI: run `codex`, then `/hooks` and trust the new")
        print("    `agent-relay` entries (each event needs trust once)")
    print("  • inspect: `relay hooks status`  /  `relay hooks doctor`")
    return 0


def cmd_hooks_uninstall(args) -> int:
    targets = ["claude", "codex"] if args.target == "both" else [args.target]
    for target in targets:
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"target: {target}  (no config at {cfg_path}; skipped)")
            continue
        cfg = _hooks_read_config(cfg_path)
        stripped = _hooks_strip_managed(cfg)
        if args.dry_run:
            print(f"target: {target}  ({cfg_path})  (dry-run)")
        else:
            _hooks_atomic_write_json(cfg_path, stripped)
            print(f"target: {target}  ({cfg_path})  removed managed entries")
    return 0


def _hooks_count_managed(config: dict) -> dict[str, int]:
    out: dict[str, int] = {}
    hooks = config.get("hooks", {})
    if not isinstance(hooks, dict):
        return out
    for event, entries in hooks.items():
        if not isinstance(entries, list):
            continue
        n = sum(1 for e in entries if isinstance(e, dict) and e.get(HOOK_MANAGED_MARKER))
        if n:
            out[event] = n
    return out


def cmd_hooks_doctor(args) -> int:
    findings = 0
    print(f"relay hooks doctor (dispatcher: {HOOK_SCRIPT})")
    if not HOOK_SCRIPT.exists():
        print("  [fail] dispatcher missing"); findings += 1
    elif not os.access(HOOK_SCRIPT, os.X_OK):
        print("  [fail] dispatcher not executable"); findings += 1
    else:
        print("  [ok]   dispatcher present + executable")

    for target in ("claude", "codex"):
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"  [--]   {target}: no config ({cfg_path})")
            continue
        cfg = _hooks_read_config(cfg_path)
        counts = _hooks_count_managed(cfg)
        if not counts:
            print(f"  [--]   {target}: no managed entries in {cfg_path}")
            continue
        missing = [e for e in HOOK_EVENTS if e not in counts]
        if missing:
            print(f"  [warn] {target}: managed entries present but missing events: "
                  f"{', '.join(missing)}")
            findings += 1
        else:
            print(f"  [ok]   {target}: managed entries for {', '.join(HOOK_EVENTS)}")
        # Codex trust hint
        if target == "codex":
            state = cfg.get("state", {})
            if isinstance(state, dict):
                trusted = sum(1 for k in state if "agent_relay" in k or HOOK_MANAGED_MARKER in k)
                if trusted == 0:
                    print(f"  [hint] codex: run `/hooks` in codex CLI to trust new entries")
    return 0 if findings == 0 else 1


def cmd_hooks_status(args) -> int:
    print(f"relay hooks status (dispatcher: {HOOK_SCRIPT})")
    print(f"  exists={HOOK_SCRIPT.exists()}  executable={os.access(HOOK_SCRIPT, os.X_OK)}")
    for target in ("claude", "codex"):
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"  {target}: (no config)")
            continue
        cfg = _hooks_read_config(cfg_path)
        counts = _hooks_count_managed(cfg)
        print(f"  {target}: managed entries = {dict(counts) if counts else '{}'}")

    env = load_env()
    if env.shared_root:
        trail = env.shared_root / "_relay" / "hook-trail.log"
        if trail.exists():
            print()
            print(f"Recent hook activity ({trail}):")
            try:
                lines = trail.read_text(encoding="utf-8").splitlines()[-10:]
                for ln in lines:
                    print(f"  {ln}")
            except OSError:
                pass
    return 0


# ---------------------------------------------------------------------------
# CLI dispatch
# ---------------------------------------------------------------------------

def cmd_whoami(args) -> int:
    """Print this instance's resolved identity + current pair binding.
    Diagnostic for the binding layer; safe with no active pair."""
    env = load_env()
    bound = None
    derived_peer = None
    schema_error = None
    if env.author and env.agent_session_id and env.shared_root:
        try:
            b = read_binding(env.shared_root, env.author, env.agent_session_id)
        except SchemaVersionError as exc:
            b = None
            schema_error = exc.to_dict()
        bound = b.get("pair_slug") if b else None
        if bound:
            try:
                derived_peer = resolve_peer(env.shared_root / bound, env.author)
            except SchemaVersionError as exc:
                schema_error = exc.to_dict()
    payload = {
        "author": env.author,
        "author_source": env.author_source,
        "agent_session_id": env.agent_session_id,
        "agent_session_id_source": env.agent_session_id_source,
        "instance_id": env.instance_id,
        "bound_pair": bound,
        "derived_peer": derived_peer,
        "schema_error": schema_error,
        "diagnostics": env.identity_diagnostics,
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False))
        return 0
    print(f"author:            {env.author or '(unset)'}  (source: {env.author_source})")
    print(f"agent_session_id:  {env.agent_session_id or '(none)'}"
          f"  (source: {env.agent_session_id_source})")
    print(f"instance_id:       {env.instance_id or '(none)'}")
    print(f"bound_pair:        {bound or '(none)'}")
    print(f"derived_peer:      {derived_peer or '(none)'}")
    if schema_error:
        print(f"schema_error:      {schema_error['code']}: {schema_error['message']}")
    if env.identity_diagnostics:
        print(f"diagnostics:       {', '.join(env.identity_diagnostics)}")
    return 0


def cmd_pair_show(args) -> int:
    """Show THIS session's pair binding and the exact command the peer uses to
    join the same pair. The quick "which pair am I in / how does my peer pair
    with me precisely" affordance — callable anytime, complements `relay whoami`
    and `relay pairs list`. Reads the binding directly, so it reports the pair
    even when it is paused (`timed_out`) or closed."""
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pair show: {exc}", file=sys.stderr)
        return 2
    bound = None
    peer = None
    schema_error = None
    if env.author and env.agent_session_id:
        try:
            b = read_binding(root, env.author, env.agent_session_id)
        except SchemaVersionError as exc:
            b = None
            schema_error = exc.to_dict()
        bound = b.get("pair_slug") if b else None
        if bound and (root / bound / "session.json").exists():
            try:
                peer = resolve_peer(root / bound, env.author)
            except SchemaVersionError as exc:
                schema_error = exc.to_dict()
    join_cmd = f"relay pair join {bound}" if bound else None
    payload = {
        "pair": bound,
        "author": env.author,
        "peer": peer,
        "instance_id": env.instance_id,
        "peer_join_cmd": join_cmd,
        "bound": bound is not None,
        "schema_error": schema_error,
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False))
        return 0
    if not bound:
        print("pair:    (none — this session is not bound to a pair)")
        print("         run `relay pair ensure` to bind, or `relay bootstrap "
              "--topic <slug>` to start one.")
        return 0
    print(f"pair:    {bound}")
    print(f"you:     {env.author or '(unset)'}  (instance {env.instance_id or '(none)'})")
    print(f"peer:    {peer or '(unresolved)'}")
    print(f"► your peer ({peer or 'the other agent'}) joins THIS exact pair with:")
    print(f"      {join_cmd}")
    if schema_error:
        print(f"schema_error: {schema_error['code']}: {schema_error['message']}")
    return 0


def cmd_pair_join(args) -> int:
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pair join: {exc}", file=sys.stderr)
        return 2
    rc = join_pair(env, root, args.slug)
    if rc == 0:
        print(f"bound {env.instance_id} -> {args.slug}")
    return rc


def cmd_pair_leave(args) -> int:
    env = load_env()
    if not env.author or not env.agent_session_id:
        print("relay pair leave: no instance identity to unbind", file=sys.stderr)
        return 2
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay pair leave: {exc}", file=sys.stderr)
        return 2
    delete_binding(root, env.author, env.agent_session_id)
    print(f"unbound {env.instance_id}")
    return 0


def _pair_candidate(root: Path, sd: Path) -> dict:
    try:
        sj = read_session_json(sd)
    except (OSError, SchemaVersionError):
        sj = {}
    live = [x for x in binding_for_pair(root, sd.name) if not _binding_is_stale(x)]
    return {
        "slug": sd.name,
        "title": sj.get("title"),
        "state": sj.get("state"),
        "authors": [x.get("author") for x in live],
        "bound_instances": [x.get("instance_id") for x in live],
        "open_slots": max(0, 2 - len(live)),
    }


def _ensure_emit(args, payload: dict, rc: int = 0) -> int:
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False))
    else:
        print(f"action: {payload.get('action')}")
        if payload.get("pair"):
            print(f"  pair: {payload['pair']}")
        if payload.get("detail"):
            print(f"  {payload['detail']}")
        for c in payload.get("candidates", []):
            authors = ",".join(a for a in c["authors"] if a) or "-"
            print(f"  - {c['slug']}  slots={c['open_slots']}/2 authors={authors}")
        for p in payload.get("pairs", []):
            print(f"  - {p}")
    return rc


def cmd_pair_ensure(args) -> int:
    """Smart pair resolution for the skill prelude. Emits a structured
    {action, ...} and an exit code (0 = ready: use/joined; 3 = user input
    needed: bootstrap/choose/full; 2 = error). Only mechanical decisions live
    here — the interactive 'ask the user which pair' stays in the skill."""
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        return _ensure_emit(args, {"action": "error", "detail": str(exc)}, rc=2)
    if not env.author or not env.agent_session_id:
        return _ensure_emit(args, {"action": "error",
            "detail": "no instance identity (no platform signal and "
                      "RELAY_AUTHOR unset)"}, rc=2)
    if env.agent_session_id_source == "fallback-degraded":
        # Identity can't be told apart from another same-author window here, so
        # never auto-bind (that would silently share a pair). Require explicit
        # selection. (codex code-review must-fix.)
        try:
            pairs = [s.name for s in active_pair_dirs(root)]
        except SchemaVersionError as exc:
            return _ensure_emit(args, {"action": "error", "detail": str(exc)}, rc=2)
        return _ensure_emit(args, {
            "action": "degraded",
            "detail": "agent session id unresolved (no platform id / tty / atuin); "
                      "pass --pair-id <slug> or export RELAY_AGENT_SESSION_ID",
            "pairs": pairs,
        }, rc=3)
    # 1. already bound to a live pair -> use it (fast path)
    try:
        b = read_binding(root, env.author, env.agent_session_id)
    except SchemaVersionError as exc:
        return _ensure_emit(args, {"action": "error", "detail": str(exc)}, rc=2)
    if b:
        slug = b.get("pair_slug")
        cand = root / slug if slug else None
        if cand and (cand / "session.json").exists():
            try:
                # session_is_resumable: a `timed_out` (paused) pair is still
                # THIS instance's to resume — return `use` and keep the binding
                # rather than dropping it and telling the agent to bootstrap.
                if session_is_resumable(cand):
                    return _ensure_emit(args, {"action": "use", "pair": slug,
                                               "instance_id": env.instance_id}, rc=0)
            except SchemaVersionError as exc:
                return _ensure_emit(args, {"action": "error", "detail": str(exc)}, rc=2)
        delete_binding(root, env.author, env.agent_session_id)  # truly dead -> rediscover
    # 2. discover active pairs
    try:
        actives = active_pair_dirs(root)
    except SchemaVersionError as exc:
        return _ensure_emit(args, {"action": "error", "detail": str(exc)}, rc=2)
    if not actives:
        return _ensure_emit(args, {"action": "bootstrap",
            "detail": "no active pair; bootstrap one"}, rc=3)
    # 3. joinable = has a free/reclaimable slot AND no live same-author binding
    joinable = []
    for sd in actives:
        live = [x for x in binding_for_pair(root, sd.name) if not _binding_is_stale(x)]
        if any(x.get("author") == env.author for x in live):
            continue
        if len(live) < 2:
            joinable.append(sd)
    if len(joinable) == 1:
        slug = joinable[0].name
        if join_pair(env, root, slug) == 0:
            return _ensure_emit(args, {"action": "joined", "pair": slug,
                                       "instance_id": env.instance_id}, rc=0)
        return _ensure_emit(args, {"action": "error",
            "detail": f"auto-join {slug} failed"}, rc=2)
    if not joinable:
        return _ensure_emit(args, {"action": "full",
            "pairs": [s.name for s in actives],
            "detail": "active pairs exist but none joinable (full or same-author)"},
            rc=3)
    return _ensure_emit(args, {"action": "choose",
        "candidates": [_pair_candidate(root, sd) for sd in joinable]}, rc=3)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="relay",
        description="agent-relay file protocol CLI.")
    p.add_argument("--version", action="version", version=f"relay {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    pp = sub.add_parser("preflight", help="Check env, mount, project, FS probes.")
    pp.add_argument("--json", action="store_true")
    pp.set_defaults(func=cmd_preflight)

    pwho = sub.add_parser("whoami",
        help="Print resolved instance identity (author + agent session id).")
    pwho.add_argument("--json", action="store_true")
    pwho.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    pwho.set_defaults(func=cmd_whoami)

    pi = sub.add_parser("init", help="Idempotently create RELAY_SHARED_ROOT + sentinel.")
    pi.add_argument("--same-host", action="store_true",
                    help="Two claude/codex agents on one machine: prints that no "
                         "identity env is needed (author auto-detects). Mutually "
                         "exclusive with --author/--sync.")
    pi.add_argument("--author", default=None,
                    help="Override the auto-detected author for a custom (non "
                         "claude/codex) agent; renders RELAY_AUTHOR into "
                         ".envrc.<hostname>. Not needed for claude/codex.")
    pi.add_argument("--sync", default=None, choices=["none", "rsync"],
                    help="Sync capability for this side. Use --sync rsync on the "
                         "transport-owning side to render a minimal rsync .envrc.")
    pi.set_defaults(func=cmd_init)

    pb = sub.add_parser("bootstrap", help="Create a new pair under .shared/.")
    pb.add_argument("--topic", required=True, help="Pair topic slug.")
    pb.add_argument("--title", default=None, help="Human-readable title.")
    pb.add_argument("--peer", default=None,
                    help="Name the other participant. Optional for a "
                         "claude<->codex pair (auto-derived); required for any "
                         "other agent identity.")
    pb.add_argument("--force", action="store_true",
                    help="Allow creating a parallel active pair.")
    pb.set_defaults(func=cmd_bootstrap)

    ps = sub.add_parser("status", help="Show the bound pair's status.")
    ps.add_argument("--project", default=None)
    ps.add_argument("--pair-id", default=None,
                    help="Resolve a specific flat .shared/<pair-id> pair.")
    ps.add_argument("--agent-session-id", default=None,
                    help="Override agent session id for instance resolution (used by hooks).")
    ps.add_argument("--last", type=int, default=0,
                     help="Show only last N published artifacts (0 = all).")
    ps.add_argument("--require-binding", action="store_true",
                    help="Strict resolution for passive automation: resolve only "
                         "via explicit --pair-id or a live binding, never the "
                         "sole-active fallback. Unbound => exit 0 with a "
                         "non-actionable payload (bound_pair: null).")
    ps.add_argument("--json", action="store_true")
    ps.set_defaults(func=cmd_status)

    pc = sub.add_parser("claim", help="Scaffold a new draft artifact under .draft/.")
    pc.add_argument("--kind", required=True, choices=sorted(KINDS))
    pc.add_argument("--in-reply-to", type=int, default=None)
    pc.add_argument("--corrects", type=int, default=None,
                    help="Seq this draft supersedes; required when --kind correction. "
                         "Optional for addendum (an addendum adds info without retracting).")
    pc.add_argument("--project", default=None)
    pc.add_argument("--pair-id", default=None)
    pc.add_argument("--no-heartbeat", action="store_true",
                    help="Do not auto-start a renewal-file heartbeat for the "
                         "draft (tests / advanced / debug). Normally claim "
                         "starts one so the draft has liveness coverage.")
    pc.set_defaults(func=cmd_claim)

    pds = sub.add_parser(
        "draft",
        help="Fill draft contents without the agent's native Write/Edit tools.",
    )
    ds_sub = pds.add_subparsers(dest="draft_cmd", required=True)
    pds_set = ds_sub.add_parser(
        "set",
        help="Update a draft's body / prompt_for_next / flags (finding 9).",
    )
    pds_set.add_argument("draft_path", help="Path to .draft/NNN-author-kind.md")
    pds_set.add_argument(
        "--body-file", default=None,
        help="Path to body content. Use '-' to read body from stdin.",
    )
    pds_set.add_argument(
        "--prompt-for-next-file", default=None,
        help="Path to prompt_for_next content. Use '-' to read from stdin.",
    )
    pds_set.add_argument(
        "--sync-needed", action="store_true",
        help="Set sync_needed: true on the draft.",
    )
    pds_set.add_argument(
        "--touched-path", action="append", default=[],
        help="Append a path to touched_paths. Repeatable; dedups.",
    )
    pds_set.add_argument(
        "--corrects", type=int, default=None,
        help="Set corrects: <seq>. Must be a positive int (validated at publish).",
    )
    pds_set.set_defaults(func=cmd_draft_set)

    pis = sub.add_parser(
        "issue",
        help="Machine-global feedback ledger for problems hit while using relay.",
    )
    is_sub = pis.add_subparsers(dest="issue_cmd", required=True)

    pia = is_sub.add_parser("add", help="Record a new issue.")
    pia.add_argument("--title", required=True, help="One-line summary.")
    pia.add_argument("--severity", default="minor", choices=sorted(ISSUE_SEVERITIES))
    pia.add_argument("--area", default="other", choices=sorted(ISSUE_AREAS))
    pia.add_argument("--body", default=None, help="Inline longer description.")
    pia.add_argument("--body-file", default=None,
                     help="Description from a file, or '-' for stdin.")
    pia.set_defaults(func=cmd_issue_add)

    pil = is_sub.add_parser("list", help="List recorded issues (default: open).")
    pil.add_argument("--status", default="open",
                     choices=sorted(ISSUE_STATUSES | {"all"}))
    pil.add_argument("--area", default=None, choices=sorted(ISSUE_AREAS))
    pil.add_argument("--json", action="store_true")
    pil.set_defaults(func=cmd_issue_list)

    pish = is_sub.add_parser("show", help="Print one issue by id (or unique prefix).")
    pish.add_argument("id")
    pish.add_argument("--json", action="store_true",
                      help="Emit {path, frontmatter, body} as JSON.")
    pish.set_defaults(func=cmd_issue_show)

    pir = is_sub.add_parser("resolve", help="Mark an issue resolved.")
    pir.add_argument("id")
    pir.add_argument("--note", default=None,
                     help="Resolution note, e.g. 'fixed in <sha>'.")
    pir.set_defaults(func=cmd_issue_resolve)

    ppub = sub.add_parser("publish", help="Validate + atomically promote a draft.")
    ppub.add_argument("draft_path", help="Path to .draft/NNN-author-kind.md")
    ppub.add_argument("--status", default=None, choices=sorted(STATUSES - {"draft"}),
                       help="Publish with this status (default: ready).")
    ppub.add_argument("--force", action="store_true",
                      help="Allow terminal publication into an inactive pair.")
    ppub.add_argument("--force-reason", default=None)
    ppub.set_defaults(func=cmd_publish)

    pcl = sub.add_parser("close", help="Write CLOSED sentinel + update session.json.")
    pcl.add_argument("--reason", required=True)
    pcl.add_argument("--outcome", default=None)
    pcl.add_argument("--project", default=None)
    pcl.add_argument("--pair-id", default=None)
    pcl.set_defaults(func=cmd_close)

    ppairs = sub.add_parser("pairs",
        help="Pair discovery + archive maintenance (list / archive / restore).")
    pps = ppairs.add_subparsers(dest="pairs_cmd", required=True)
    ppl = pps.add_parser("list", help="List all pairs, their bound instances, and open slots.")
    ppl.add_argument("--json", action="store_true")
    ppl.add_argument("--archived", action="store_true",
        help="List archived pairs (under .shared/_archive/) instead of live ones.")
    ppl.set_defaults(func=cmd_pairs_list)
    ppa = pps.add_parser("archive",
        help="Move a terminated pair dir into .shared/_archive/ to declutter .shared/.")
    ppa.add_argument("slug", nargs="?", help="Pair slug (YYYYMMDD-topic) to archive.")
    ppa.add_argument("--terminated", action="store_true",
        help="Archive ALL closed/terminal pairs in one sweep.")
    ppa.add_argument("--force", action="store_true",
        help="Also archive an ACTIVE pair (shelve it); drops any binding to it.")
    ppa.set_defaults(func=cmd_pairs_archive)
    ppr = pps.add_parser("restore",
        help="Move an archived pair back from .shared/_archive/ to .shared/.")
    ppr.add_argument("slug", help="Archived pair slug (YYYYMMDD-topic) to restore.")
    ppr.set_defaults(func=cmd_pairs_restore)

    ppair = sub.add_parser("pair",
        help="Bind this instance to a pair (join), drop the binding (leave), "
             "smart-resolve which pair to work in (ensure), or show this "
             "session's pair + the peer's join command (show).")
    pair_sub = ppair.add_subparsers(dest="pair_cmd", required=True)
    pj = pair_sub.add_parser("join", help="Bind this instance to <slug>.")
    pj.add_argument("slug", help="Pair slug (YYYYMMDD-topic).")
    pj.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    pj.set_defaults(func=cmd_pair_join)
    pv = pair_sub.add_parser("leave", help="Drop this instance's binding (files only).")
    pv.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    pv.set_defaults(func=cmd_pair_leave)
    pe = pair_sub.add_parser("ensure",
        help="Smart-resolve the pair: use the binding, auto-join the sole "
             "compatible pair, or report that the user must choose / bootstrap.")
    pe.add_argument("--json", action="store_true")
    pe.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    pe.set_defaults(func=cmd_pair_ensure)
    psh = pair_sub.add_parser("show",
        help="Show this session's bound pair + the exact `pair join` command the "
             "peer uses to pair with it (precise pairing).")
    psh.add_argument("--json", action="store_true")
    psh.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    psh.set_defaults(func=cmd_pair_show)

    psync = sub.add_parser("sync", help="rsync wrapper (only the RELAY_SYNC=rsync side may run it).")
    psync.add_argument("direction", choices=["push", "pull"])
    psync.add_argument("--dry-run", action="store_true")
    psync.add_argument("--strict-gitignore", action="store_true",
                        help="Use git ls-files instead of rsync --filter (exact gitignore semantics).")
    psync.add_argument("--delete", action="store_true",
                        help="Pass --delete to rsync (off by default).")
    psync.set_defaults(func=cmd_sync)

    pdoc = sub.add_parser("doctor",
        help="Report stale relay state; optionally clean owner-safe junk.")
    pdoc.add_argument("--json", action="store_true",
                      help="Machine-readable report.")
    pdoc.add_argument("--fix", action="store_true",
                      help="Clean owner-safe junk (dead pidfiles). With --older-than, "
                           "also delete abandoned drafts and incomplete published "
                           "triads older than the threshold.")
    pdoc.add_argument("--older-than", default=None,
                      help="Duration ('1h', '30m', '1d'). Required with --fix only "
                           "to delete drafts or incomplete triads; ignored otherwise.")
    pdoc.set_defaults(func=cmd_doctor)

    pw = sub.add_parser("wait",
        help="Block until peer publishes a new artifact targeting this author.")
    pw.add_argument("--project", default=None)
    pw.add_argument("--pair-id", default=None)
    pw.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    pw_timeout = pw.add_mutually_exclusive_group()
    pw_timeout.add_argument("--timeout", type=int, default=None,
                    help="Override RELAY_WAIT_TIMEOUT (default 3600s).")
    pw_timeout.add_argument("--no-timeout", action="store_true",
                    help="Disable the nominal no-heartbeat deadline. "
                         "A stale peer renewal-file heartbeat still exits with 11.")
    pw.add_argument("--poll", type=int, default=None,
                    help="Override RELAY_WAIT_POLL_INTERVAL (default 2s).")
    pw.add_argument("--require-binding", action="store_true",
                    help="Strict resolution (see `status --require-binding`): "
                         "refuse to wait on a sole-active pair when unbound.")
    pw.set_defaults(func=cmd_wait)

    phb = sub.add_parser("heartbeat", help="Owner-tied liveness daemon for a draft.")
    phs = phb.add_subparsers(dest="heartbeat_cmd", required=True)

    phb_start = phs.add_parser("start",
        help="Spawn a detached daemon that refreshes the draft heartbeat sidecar.")
    phb_start.add_argument("--draft", required=True,
        help="Path to .draft/NNN-<author>-<kind>.md")
    phb_start.add_argument("--owner-kind", default="renewal-file", choices=sorted(OWNER_KINDS),
        help="How to determine owner liveness. Default (and the only one used by "
             "the normal SKILL workflow) is renewal-file; agent/tool-process/"
             "pidfile/none are advanced/legacy.")
    phb_start.add_argument("--owner-pid", type=int, default=None)
    phb_start.add_argument("--owner-pidfile", default=None)
    phb_start.add_argument("--interval", type=int, default=None,
        help="Beat interval in seconds (default RELAY_HEARTBEAT_INTERVAL=10).")
    phb_start.set_defaults(func=cmd_heartbeat_start)

    phb_stop = phs.add_parser("stop",
        help="Terminate the heartbeat daemon and remove its files.")
    phb_stop.add_argument("--draft", default=None,
        help="Optional draft path; if omitted, all sidecars for current author are cleared.")
    phb_stop.add_argument("--project", default=None)
    phb_stop.add_argument("--pair-id", default=None)
    phb_stop.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    phb_stop.add_argument("--force", action="store_true",
        help="Remove files even if no daemon is running.")
    phb_stop.set_defaults(func=cmd_heartbeat_stop)

    phb_tick = phs.add_parser("tick",
        help="Refresh the local renewal file mtime so the daemon sees the owner alive.")
    phb_tick.add_argument("--project", default=None)
    phb_tick.add_argument("--pair-id", default=None)
    phb_tick.add_argument("--agent-session-id", default=None,
        help="Override agent session id for instance resolution (used by hooks).")
    phb_tick.set_defaults(func=cmd_heartbeat_tick)

    pho = sub.add_parser("hooks",
        help="Install/manage cross-platform hook integration (Claude Code + Codex CLI).")
    phos = pho.add_subparsers(dest="hooks_cmd", required=True)

    pho_install = phos.add_parser("install",
        help="Append agent-relay hooks to Claude settings.json and/or Codex hooks.json.")
    pho_install.add_argument("--target", choices=("claude", "codex", "both"), default="both")
    pho_install.add_argument("--dry-run", action="store_true")
    pho_install.set_defaults(func=cmd_hooks_install)

    pho_uninstall = phos.add_parser("uninstall",
        help="Remove agent-relay managed hook entries.")
    pho_uninstall.add_argument("--target", choices=("claude", "codex", "both"), default="both")
    pho_uninstall.add_argument("--dry-run", action="store_true")
    pho_uninstall.set_defaults(func=cmd_hooks_uninstall)

    pho_doctor = phos.add_parser("doctor",
        help="Verify hook dispatcher + config wiring + trust state.")
    pho_doctor.set_defaults(func=cmd_hooks_doctor)

    pho_status = phos.add_parser("status",
        help="Show hook install state + recent activity from hook-trail.log.")
    pho_status.set_defaults(func=cmd_hooks_status)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    # Hooks receive the agent session id on stdin and pass it via
    # --agent-session-id; surface it as RELAY_AGENT_SESSION_ID so load_env()
    # (top of the resolve_instance_id precedence chain) picks it up without
    # each command re-parsing.
    _asid = getattr(args, "agent_session_id", None)
    if _asid:
        os.environ["RELAY_AGENT_SESSION_ID"] = _asid
    try:
        return args.func(args)
    except SchemaVersionError as exc:
        print(f"relay: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    # Top-level SIGINT guard: codex seq 8 observed tracebacks when SIGINT
    # arrived during early CLI startup (argparse build) before any command
    # handler installed its own KeyboardInterrupt catcher. Exit cleanly with
    # 130 (128 + SIGINT) so the protocol contract holds anywhere in the
    # process lifetime, not just inside `cmd_wait`.
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
