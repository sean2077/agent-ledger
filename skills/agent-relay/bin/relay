#!/usr/bin/env python3
"""relay — agent-relay file protocol CLI.

Single-file executable, Python 3.10+, stdlib only. See companion spec:
  skills/agent-relay/references/file-protocol.md

Commands:
  init         idempotently create RELAY_SHARED_ROOT + sentinel; render .envrc
  preflight    env + mount + project + FS probes + POSIX mode
  bootstrap    create new session directory under .shared/
  status       list session artifacts + readiness + session-active rule
  sessions     subcommands: list (recovery/discovery across all sessions)
  next-seq     print next available NNN (advisory)
  claim        scaffold a new draft under .draft/
  publish      validate draft, atomically promote to published + sha256 + ready
  close        write CLOSED sentinel + update session.json (no edit to prior files)
  sync         rsync wrapper for the RELAY_SYNC=rsync side (push/pull,
               default and strict modes)
  wait         block until peer publishes; exit codes 0/10/11/12/130/2
  doctor       report (and optionally fix) stuck drafts, dead heartbeat
               pidfiles, abandoned sidecars
  heartbeat    subcommands: start, stop, tick (per-draft liveness daemon)
  hooks        subcommands: install, uninstall, status, doctor (Claude Code
               + Codex CLI hook integration)
"""

from __future__ import annotations

import argparse
import dataclasses
import hashlib
import json
import os
import random
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path
from typing import Callable, Optional


RELAY_PACKAGE_DIR = Path(__file__).resolve().parent.parent

__version__ = "0.10.0"
SCHEMA_VERSION = 3

KINDS = {"plan", "review", "fix", "note", "question", "decision", "correction", "addendum"}
# Kinds whose semantics allow a `corrects:` back-reference (file-protocol §3).
# correction REQUIRES it; addendum MAY set it; all other kinds MUST NOT.
CORRECTS_KINDS = {"correction", "addendum"}
STATUSES = {"draft", "ready", "closed", "cancelled", "failed", "timed_out"}
TERMINAL_STATUSES = {"closed", "cancelled", "failed", "timed_out"}
PLACEHOLDER_MARKER = "TODO:"
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,47}$")
NON_BLOCKING_PREFLIGHT_WARNS = {"fs.mtime_monotonic"}
OWNER_KINDS = {"agent", "tool-process", "pidfile", "renewal-file", "none"}


# ---------------------------------------------------------------------------
# atomic primitives
# ---------------------------------------------------------------------------

def atomic_write_bytes(target: Path, data: bytes, *, mode: int = 0o600) -> None:
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.parent / f".{target.name}.relay-{os.getpid()}-{uuid.uuid4().hex[:8]}.tmp"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            raise
        os.replace(tmp, target)
        _fsync_dir(target.parent)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def atomic_write_text(target: Path, text: str, *, mode: int = 0o600) -> None:
    atomic_write_bytes(target, text.encode("utf-8"), mode=mode)


def atomic_reserve_text(target: Path, text: str, *, mode: int = 0o600) -> None:
    """Create `target` exclusively (O_CREAT|O_EXCL) then write+fsync.

    Used by `relay publish` to reserve the final `.md` path against
    truly-concurrent publishers (finding 2). `atomic_write_text` uses
    tmp+`os.replace`, which is atomic but UNCONDITIONAL — two writers
    can both pass an `exists()` check and then clobber each other via
    `os.replace`. This primitive raises `FileExistsError` instead.

    Note: unlike `atomic_write_text`, the final path is briefly visible
    in a partial-content state between create and fsync. The relay
    protocol gates consumer reads on the `.ready` sentinel (written
    last by the same publisher), so partial content is not observable
    to a protocol-compliant reader.
    """
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(text.encode("utf-8"))
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        try:
            target.unlink()
        except OSError:
            pass
        raise
    _fsync_dir(target.parent)


def atomic_write_json(target: Path, obj: dict, *, mode: int = 0o600) -> None:
    atomic_write_text(
        target,
        json.dumps(obj, indent=2, ensure_ascii=False) + "\n",
        mode=mode,
    )


def _fsync_dir(path: Path) -> None:
    try:
        fd = os.open(path, os.O_DIRECTORY)
    except (OSError, AttributeError):
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def sha256_of_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def now_iso() -> str:
    return datetime.now().astimezone().replace(microsecond=0).isoformat()


# ---------------------------------------------------------------------------
# FS behavior probes
# ---------------------------------------------------------------------------

@dataclasses.dataclass
class ProbeResult:
    name: str
    status: str
    detail: str
    elapsed_ms: int


def _probe_tmp_rename(root: Path) -> tuple[str, str]:
    tmp = root / ".relay-probe.tmp"
    target = root / ".relay-probe.target"
    try:
        payload = os.urandom(32)
        tmp.write_bytes(payload)
        os.replace(tmp, target)
        if target.read_bytes() != payload:
            return "fail", "readback mismatch after rename"
        return "pass", "tmp+rename atomic; readback matches"
    finally:
        for p in (tmp, target):
            try:
                p.unlink()
            except FileNotFoundError:
                pass


def _probe_mtime_monotonic(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-mtime"
    try:
        target.write_bytes(b"v1")
        m1 = target.stat().st_mtime_ns
        time.sleep(0.05)
        target.write_bytes(b"v2")
        m2 = target.stat().st_mtime_ns
        if m2 < m1:
            return "fail", f"mtime regressed: {m1} -> {m2}"
        if m2 == m1:
            return "warn", f"mtime unchanged ({m1}); coarse resolution"
        return "pass", f"mtime advanced {m2 - m1}ns"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_symlink_ops(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-symlink-target"
    link = root / ".relay-probe-symlink"
    try:
        target.write_bytes(b"x")
        try:
            os.symlink(target.name, link)
        except OSError as e:
            return "fail", f"symlink create unsupported: {e}"
        if os.readlink(link) != target.name:
            return "fail", "readlink mismatch"
        return "pass", "create / readlink ok"
    finally:
        for p in (link, target):
            try:
                if p.is_symlink() or p.exists():
                    p.unlink()
            except (FileNotFoundError, IsADirectoryError):
                pass


def _probe_sha256_stable(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-sha"
    try:
        payload = os.urandom(8192)
        target.write_bytes(payload)
        h1 = hashlib.sha256(target.read_bytes()).hexdigest()
        h2 = hashlib.sha256(target.read_bytes()).hexdigest()
        if h1 != h2:
            return "fail", "hash mismatch across reopen"
        return "pass", f"sha256 stable ({h1[:16]}..)"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_fsync_readback(root: Path) -> tuple[str, str]:
    target = root / ".relay-probe-fsync"
    try:
        payload = os.urandom(1024)
        with open(target, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        if target.read_bytes() != payload:
            return "fail", "fsync readback mismatch"
        return "pass", "fsync ok"
    finally:
        try:
            target.unlink()
        except FileNotFoundError:
            pass


def _probe_posix_mode(root: Path, target_mode: int = 0o700) -> tuple[str, str]:
    actual = stat.S_IMODE(root.stat().st_mode)
    if actual == target_mode:
        return "pass", f"mode {actual:04o} matches target {target_mode:04o}"
    if actual & 0o002:
        return "fail", f"mode {actual:04o} world-writable"
    if actual & 0o077:
        return "warn", f"mode {actual:04o} exceeds target {target_mode:04o}"
    return "warn", f"mode {actual:04o} differs from target {target_mode:04o}"


_FS_PROBES: list[tuple[str, Callable[[Path], tuple[str, str]]]] = [
    ("tmp_rename", _probe_tmp_rename),
    ("mtime_monotonic", _probe_mtime_monotonic),
    ("symlink_ops", _probe_symlink_ops),
    ("sha256_stable", _probe_sha256_stable),
    ("fsync_readback", _probe_fsync_readback),
]


def run_probes(root: Path, posix_target: int = 0o700) -> list[ProbeResult]:
    out: list[ProbeResult] = []
    for name, fn in _FS_PROBES:
        t = time.monotonic()
        try:
            s, d = fn(root)
        except Exception as exc:
            s, d = "fail", f"{type(exc).__name__}: {exc}"
        out.append(ProbeResult(name, s, d, int((time.monotonic() - t) * 1000)))
    t = time.monotonic()
    try:
        s, d = _probe_posix_mode(root, posix_target)
    except Exception as exc:
        s, d = "fail", f"{type(exc).__name__}: {exc}"
    out.append(ProbeResult("posix_mode", s, d, int((time.monotonic() - t) * 1000)))
    return out


def _preflight_exit_code(checks: list[dict]) -> int:
    exit_code = 0
    for c in checks:
        status = c["status"]
        if status == "fail":
            return 2
        if (
            status == "warn"
            and c["name"] not in NON_BLOCKING_PREFLIGHT_WARNS
            and exit_code < 1
        ):
            exit_code = 1
    return exit_code


# ---------------------------------------------------------------------------
# Env loading
# ---------------------------------------------------------------------------

@dataclasses.dataclass
class Env:
    role: Optional[str]
    author: Optional[str]
    peer: Optional[str]
    shared_root: Optional[Path]
    project: Optional[str]
    remote_ssh: Optional[str]
    remote_path: Optional[str]
    # `sync_raw` is the literal value from RELAY_SYNC (or None if unset);
    # `sync_source` is one of "env" | "role-alias" | "shape-a-infer" | None,
    # so preflight can warn appropriately. Resolution lives in `_resolve_sync`.
    sync_raw: Optional[str] = None


SYNC_VALUES = {"none", "rsync"}


def load_env() -> Env:
    shared = os.environ.get("RELAY_SHARED_ROOT")
    shared_path = Path(shared).expanduser().resolve() if shared else None
    return Env(
        role=os.environ.get("RELAY_ROLE") or None,
        author=os.environ.get("RELAY_AUTHOR") or None,
        peer=os.environ.get("RELAY_PEER") or None,
        shared_root=shared_path,
        project=os.environ.get("RELAY_PROJECT") or None,
        remote_ssh=os.environ.get("RELAY_REMOTE_SSH") or None,
        remote_path=os.environ.get("RELAY_REMOTE_PATH") or None,
        sync_raw=os.environ.get("RELAY_SYNC") or None,
    )


def _resolve_sync(env: Env, *, is_shape_a: bool) -> tuple[Optional[str], str]:
    """Return (effective_sync, source) where source is 'env', 'shape-a-infer',
    'env-invalid', 'role-removed', or 'unset'. `effective_sync` is in
    SYNC_VALUES or None.

    Precedence: explicit RELAY_SYNC wins; else shape-A infers `none`; else
    unset. The legacy RELAY_ROLE alias was removed in v0.6 — if the user
    still has RELAY_ROLE set but no RELAY_SYNC, we surface a specific
    'role-removed' source so the caller can emit a clear migration hint
    rather than a generic 'unset' failure.
    """
    if env.sync_raw is not None:
        if env.sync_raw in SYNC_VALUES:
            return env.sync_raw, "env"
        return None, "env-invalid"
    if env.role:
        # Legacy var still in the user's envrc — refuse rather than guess.
        return None, "role-removed"
    if is_shape_a:
        return "none", "shape-a-infer"
    return None, "unset"


def git_toplevel(start: Path | None = None) -> Optional[Path]:
    start = start or Path.cwd()
    try:
        res = subprocess.run(
            ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=False,
        )
        if res.returncode != 0:
            return None
        return Path(res.stdout.strip())
    except FileNotFoundError:
        return None


def sanitize_project_slug(raw: str) -> str:
    """Coerce an arbitrary directory name into a SLUG_RE-matching slug.

    git toplevel names legally contain dots, underscores, and capitals
    (`actibot_ego.jy`, `MyProject`); SLUG_RE does not. Lower-case the
    name, fold any run of non-slug chars into a single hyphen, trim
    leading/trailing hyphens, and clip to 48 chars. Explicit user input
    via RELAY_PROJECT bypasses this — callers validate that separately.
    """
    s = raw.lower()
    s = re.sub(r"[^a-z0-9-]+", "-", s)
    s = s.strip("-")
    return s[:48]


def derive_project(env: Env) -> Optional[str]:
    if env.project:
        return env.project
    top = git_toplevel()
    if not top:
        return None
    return sanitize_project_slug(top.name) or None


# ---------------------------------------------------------------------------
# Frontmatter (minimal YAML subset)
# ---------------------------------------------------------------------------

_FM_RE = re.compile(r"^---\n(.*?\n)---\n?(.*)$", re.DOTALL)


def parse_frontmatter(text: str) -> tuple[dict, str]:
    m = _FM_RE.match(text)
    if not m:
        raise ValueError("no frontmatter found (expected --- ... --- at start)")
    return _parse_yaml_subset(m.group(1)), m.group(2)


def _parse_yaml_subset(text: str) -> dict:
    out: dict = {}
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith("#"):
            i += 1
            continue
        if ":" not in line:
            raise ValueError(f"bad frontmatter line: {line!r}")
        key, _, rest = line.partition(":")
        key = key.strip()
        rest = rest.rstrip()
        if rest.strip() == "|":
            block: list[str] = []
            i += 1
            indent: Optional[int] = None
            while i < len(lines):
                ln = lines[i]
                if not ln.strip():
                    block.append("")
                    i += 1
                    continue
                lead = len(ln) - len(ln.lstrip())
                if indent is None:
                    indent = lead
                if lead < indent:
                    break
                block.append(ln[indent:])
                i += 1
            out[key] = "\n".join(block).rstrip() + ("\n" if block else "")
            continue
        if rest.strip() == "[]":
            out[key] = []
            i += 1
            continue
        if rest.strip() == "":
            items: list = []
            i += 1
            while i < len(lines):
                ln = lines[i]
                if not ln.strip():
                    i += 1
                    continue
                stripped = ln.lstrip()
                if stripped.startswith("- "):
                    items.append(_scalar(stripped[2:].strip()))
                    i += 1
                    continue
                break
            out[key] = items
            continue
        out[key] = _scalar(rest.strip())
        i += 1
    return out


def _scalar(s: str):
    if s in ("", "null", "~"):
        return None
    if s == "true":
        return True
    if s == "false":
        return False
    if (s.startswith('"') and s.endswith('"')) or (s.startswith("'") and s.endswith("'")):
        return s[1:-1]
    try:
        return int(s)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return s


def dump_frontmatter(d: dict, body: str = "") -> str:
    lines = ["---"]
    for k, v in d.items():
        if v is None:
            lines.append(f"{k}: null")
        elif v is True:
            lines.append(f"{k}: true")
        elif v is False:
            lines.append(f"{k}: false")
        elif isinstance(v, list):
            if not v:
                lines.append(f"{k}: []")
            else:
                lines.append(f"{k}:")
                for it in v:
                    lines.append(f"  - {it}")
        elif isinstance(v, str) and "\n" in v:
            lines.append(f"{k}: |")
            for ln in v.rstrip("\n").splitlines():
                lines.append(f"  {ln}")
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    if body and not body.startswith("\n"):
        lines.append("")
    return "\n".join(lines) + "\n" + body


# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------

def session_root(env: Env) -> Path:
    if not env.shared_root:
        raise SystemExit("RELAY_SHARED_ROOT not set")
    return env.shared_root


def active_marker_path(root: Path) -> Path:
    return root / ".active-session"


def read_active_marker(root: Path) -> str | None:
    marker = active_marker_path(root)
    try:
        value = marker.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        return None
    return value or None


def write_active_marker(root: Path, session_slug: str) -> None:
    atomic_write_text(active_marker_path(root), f"{session_slug}\n", mode=0o600)


def clear_active_marker(root: Path, session_slug: str | None = None) -> None:
    marker = active_marker_path(root)
    current = read_active_marker(root)
    if session_slug is not None and current != session_slug:
        return
    try:
        marker.unlink()
        _fsync_dir(root)
    except FileNotFoundError:
        pass


def iter_session_dirs(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    sessions: list[Path] = []
    for sd in sorted(root.iterdir()):
        if not sd.is_dir() or sd.name.startswith(".") or sd.name == "_relay":
            continue
        if (sd / "session.json").exists():
            sessions.append(sd)
    return sessions


def active_sessions(root: Path) -> list[Path]:
    return [sd for sd in iter_session_dirs(root) if session_is_active(sd)]


def resolve_session(env: Env, session_id: str | None = None, *,
                    project: str | None = None, require_active: bool = False) -> Path:
    root = session_root(env)
    if not root.is_dir():
        raise SystemExit(f"no shared root: {root}")
    if session_id:
        candidate = root / session_id
        if not (candidate / "session.json").exists():
            raise SystemExit(f"no session {session_id!r} under {root}")
        if require_active and not session_is_active(candidate):
            raise SystemExit(f"session is not active: {session_id}")
        return candidate
    if require_active:
        return resolve_active_session(env, project)
    raise SystemExit("session_id is required unless resolving the active session")


def resolve_active_session(env: Env, project: str | None = None,
                           session_id: str | None = None) -> Path:
    root = session_root(env)
    if not root.is_dir():
        raise SystemExit(f"no shared root: {root}")
    if session_id:
        return resolve_session(env, session_id, project=project, require_active=True)

    # session_is_active() honors state, CLOSED sentinel, AND latest artifact
    # status (so stale-active sessions with terminal latest artifacts are
    # excluded). Avoids spurious "multiple active sessions".
    candidates = active_sessions(root)
    if not candidates:
        raise SystemExit(f"no active session under {root}")
    if len(candidates) > 1:
        # Finding 5 (codex seq 2): when several sessions are active (the
        # documented `bootstrap --force` parallel mode), let `.active-session`
        # disambiguate so preflight-pass and command-success agree. Preflight
        # already treats a marker that names one of the actives as OK; without
        # honoring it here, every default command still failed with "multiple
        # active sessions", making the marker non-predictive.
        marker = read_active_marker(root)
        if marker:
            for s in candidates:
                if s.name == marker:
                    return s
        names = ", ".join(s.name for s in candidates)
        hint = f" (.active-session={marker!r} matches none of them)" if marker else ""
        raise SystemExit(
            f"multiple active sessions; specify --session-id: {names}{hint}"
        )
    return candidates[0]


def list_published(session: Path) -> list[Path]:
    """Return published artifacts whose sidecars are present AND sha256 matches.

    Sidecar mere existence is not enough — a stale `.sha256` after post-publish
    tampering would otherwise silently pass consumers. We re-hash the .md and
    compare against the sidecar's first field (sha256sum format: '<hex>  <name>').
    """
    out: list[Path] = []
    for f in sorted(session.glob("[0-9][0-9][0-9]-*.md")):
        base = f.name[:-3]  # drop .md → NNN-author-kind
        ready_path = session / f"{base}.ready"
        sha_path = session / f"{f.name}.sha256"
        if not (ready_path.exists() and sha_path.exists()):
            continue
        try:
            expected = sha_path.read_text().split()[0].strip()
            actual = sha256_of_file(f)
        except (OSError, IndexError):
            continue
        if expected.lower() != actual.lower():
            continue  # tampered or partial; treat as not published
        out.append(f)
    return out


def latest_seq(session: Path) -> int:
    """Max seq across published artifacts AND in-flight drafts.

    Used by claim-time reservation so a new draft never overlaps an
    in-flight one. NOT safe as a `relay wait` baseline — see
    `latest_published_seq()` for that case (finding 1).
    """
    seqs: list[int] = []
    for f in session.glob("[0-9][0-9][0-9]-*.md"):
        try:
            seqs.append(int(f.name[:3]))
        except ValueError:
            pass
    draft = session / ".draft"
    if draft.is_dir():
        for f in draft.glob("[0-9][0-9][0-9]-*.md"):
            try:
                seqs.append(int(f.name[:3]))
            except ValueError:
                pass
    return max(seqs) if seqs else 0


def latest_published_seq(session: Path) -> int:
    """Max seq across .ready-published artifacts only (excludes .draft/).

    Used by `relay wait` to compute its baseline. Including drafts
    here would mask the peer publishing the very draft they had open
    when wait entered (finding 1: the published seq equals the draft
    seq, and the old `latest_seq()` baseline filtered it out).
    """
    seqs: list[int] = []
    for p in list_published(session):
        try:
            seqs.append(int(p.name[:3]))
        except ValueError:
            pass
    return max(seqs) if seqs else 0


def published_paths(session: Path, base: str) -> dict[str, Path]:
    """base = 'NNN-author-kind' (no .md). Returns dict of expected paths."""
    return {
        "md": session / f"{base}.md",
        "sha256": session / f"{base}.md.sha256",
        "ready": session / f"{base}.ready",
    }


def session_is_active(session: Path) -> bool:
    """Implements the session-active rule from file-protocol.md §5."""
    sj = session / "session.json"
    if not sj.exists():
        return False
    try:
        data = json.loads(sj.read_text())
    except json.JSONDecodeError:
        return False
    if data.get("state") != "active":
        return False
    if (session / "CLOSED").exists():
        return False
    pub = list_published(session)
    if not pub:
        return True  # bootstrapped, no artifacts yet
    latest = pub[-1]
    try:
        fm, _ = parse_frontmatter(latest.read_text(encoding="utf-8"))
    except (ValueError, OSError):
        return True  # malformed; conservatively keep active
    status = fm.get("status")
    if status in TERMINAL_STATUSES:
        return False
    return True


def latest_artifact_frontmatter(session: Path) -> dict | None:
    pub = list_published(session)
    if not pub:
        return None
    try:
        fm, _ = parse_frontmatter(pub[-1].read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return fm


def session_category(session: Path) -> str:
    if session_is_active(session):
        return "active"
    if (session / "CLOSED").exists():
        return "closed"
    try:
        sj = json.loads((session / "session.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "invalid"
    if sj.get("state") == "closed":
        return "closed"
    fm = latest_artifact_frontmatter(session)
    if fm and fm.get("status") in TERMINAL_STATUSES:
        return "terminal"
    return "inactive"


def _check_active_marker(root: Path) -> dict:
    marker = read_active_marker(root)
    actives = active_sessions(root)
    active_names = [sd.name for sd in actives]
    if marker is None:
        if not active_names:
            return {
                "name": "session.active_marker",
                "status": "pass",
                "detail": "no active sessions and no marker",
            }
        if len(active_names) == 1:
            return {
                "name": "session.active_marker",
                "status": "pass",
                "detail": f"single active session {active_names[0]} (no marker needed)",
            }
        # Finding 5: `bootstrap --force` is documented for parallel sessions.
        # Multiple actives without a marker is the legitimate state for that
        # mode; downgrade from fail -> warn so callers can pass --session-id
        # to disambiguate downstream commands without preflight blocking.
        return {
            "name": "session.active_marker",
            "status": "warn",
            "detail": (
                f"{len(active_names)} active sessions without a marker "
                f"({', '.join(active_names)}); "
                "use --session-id <id> on follow-up commands, or `relay sessions list`."
            ),
        }
    target = root / marker
    if not (target / "session.json").exists():
        return {
            "name": "session.active_marker",
            "status": "fail",
            "detail": f".active-session points at missing session {marker!r}",
        }
    if marker not in active_names:
        # Marker points at a real session that's no longer active.
        return {
            "name": "session.active_marker",
            "status": "fail",
            "detail": f".active-session={marker!r} but that session is not active "
                      f"(active={active_names or 'none'})",
        }
    if len(active_names) > 1:
        # Marker disambiguates; parallel mode is fine.
        others = [n for n in active_names if n != marker]
        return {
            "name": "session.active_marker",
            "status": "pass",
            "detail": f".active-session={marker} (other active: {', '.join(others)})",
        }
    return {
        "name": "session.active_marker",
        "status": "pass",
        "detail": f"active session marker matches {marker}",
    }


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def _print_env_template() -> None:
    sys.stderr.write(
        "\nenvironment setup (v0.6+):\n"
        "  This project uses a per-host .envrc.<hostname> file dispatched\n"
        "  by the committed .envrc. Pick one of:\n\n"
        "    # same-host (two agents on one machine):\n"
        "    relay init --role same-host\n"
        "    source .envrc                           # codex terminal (default)\n"
        "    # in the OTHER terminal:\n"
        "    export RELAY_AUTHOR=claude && source .envrc\n\n"
        "    # explicit per-side (any topology):\n"
        "    relay init --author codex --peer claude --sync none\n"
        "    # or with rsync transport ownership:\n"
        "    relay init --author codex --peer claude --sync rsync\n"
        "    # then $EDITOR \".envrc.$(hostname -s)\" to fill RELAY_REMOTE_SSH/PATH\n"
        "    source .envrc\n"
    )


def cmd_preflight(args) -> int:
    env = load_env()
    out: dict = {"exit_code": 0, "env": {}, "checks": []}

    # Detect project shape unconditionally (independent of RELAY_ROLE, per
    # codex seq 4 ack on D1 — otherwise same-host setups without a legacy
    # role never reach the shape-A inference path):
    #   shape A: PROJECT_ROOT is itself a fuse mount → rsync structurally
    #            inapplicable; RELAY_REMOTE_SSH / RELAY_REMOTE_PATH irrelevant.
    #   shape B: PROJECT_ROOT is local; only .shared/ may be mounted.
    is_shape_a = False
    project_root = git_toplevel()
    if project_root is not None:
        is_shape_a = _is_fuse_mount(project_root)

    sync_effective, sync_source = _resolve_sync(env, is_shape_a=is_shape_a)

    required = ["RELAY_AUTHOR", "RELAY_PEER", "RELAY_SHARED_ROOT"]
    if sync_effective == "rsync":
        required += ["RELAY_REMOTE_SSH", "RELAY_REMOTE_PATH"]
    for var in required:
        val = os.environ.get(var)
        out["env"][var] = bool(val)
        out["checks"].append({
            "name": f"env.{var}",
            "status": "pass" if val else "fail",
            "detail": "set" if val else "not set",
        })

    # Sync resolution check — surfaces effective sync mode plus migration hints.
    if sync_source == "env-invalid":
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "fail",
            "detail": f"RELAY_SYNC={env.sync_raw!r} invalid; expected one of "
                      f"{sorted(SYNC_VALUES)}",
        })
    elif sync_source == "role-removed":
        # v0.6 breaking change: RELAY_ROLE alias removed. Give the user the
        # exact migration line. Shape-A carve-out: if the project root is a
        # fuse mount, rsync is structurally inapplicable regardless of which
        # legacy role they had, so the hint must point at `none`, not the
        # default host->rsync mapping (would contradict the project.shape
        # check in the same output).
        if is_shape_a:
            target = "none"
            extra = (
                " (shape A detected: the project root is a fuse mount, so "
                "rsync is structurally inapplicable on this side — RELAY_SYNC=none "
                "is the right call regardless of the legacy role value)"
            )
        else:
            target = "rsync" if env.role == "host" else "none"
            extra = ""
        out["checks"].append({
            "name": "env.RELAY_ROLE.removed", "status": "fail",
            "detail": (
                f"RELAY_ROLE={env.role!r} is no longer recognized (removed in v0.6). "
                f"Migrate: replace it with `export RELAY_SYNC={target}` in your "
                f".envrc.<hostname>. Standard mapping: host -> RELAY_SYNC=rsync, "
                f"remote -> RELAY_SYNC=none.{extra}"
            ),
        })
    elif sync_effective is None:
        # Neither RELAY_SYNC nor legacy var set, and shape detection
        # could not infer (shape B or no git toplevel). Fail with a hint.
        hint = (
            "set RELAY_SYNC=rsync (this side owns rsync transport) "
            "or RELAY_SYNC=none (this side does not sync)"
        )
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "fail",
            "detail": f"RELAY_SYNC not set; {hint}",
        })
    else:
        out["env"]["RELAY_SYNC"] = True
        detail = f"sync={sync_effective} (source: {sync_source})"
        out["checks"].append({
            "name": "env.RELAY_SYNC", "status": "pass", "detail": detail,
        })

    if project_root is not None:
        if is_shape_a:
            shape_detail = "shape A (PROJECT_ROOT is a fuse mount; rsync structurally inapplicable)"
            if sync_effective == "rsync":
                # Contradiction: caller asserts they own rsync but project root
                # IS the mount, so there is nothing to rsync.
                out["checks"].append({
                    "name": "project.shape", "status": "fail",
                    "detail": shape_detail + " — but RELAY_SYNC=rsync; refuse to run sync",
                })
            else:
                out["checks"].append({
                    "name": "project.shape", "status": "pass",
                    "detail": shape_detail,
                })
        else:
            out["checks"].append({
                "name": "project.shape", "status": "pass",
                "detail": "shape B (PROJECT_ROOT is local; rsync available if SYNC=rsync)",
            })

    if env.shared_root and project_root is not None:
        top = project_root.resolve()
        try:
            env.shared_root.relative_to(top)
            out["checks"].append({
                "name": "shared_root.location",
                "status": "pass",
                "detail": f"{env.shared_root} is under git toplevel {top}",
            })
        except ValueError:
            out["checks"].append({
                "name": "shared_root.location",
                "status": "fail",
                "detail": f"{env.shared_root} is outside git toplevel {top}",
            })

    if env.shared_root:
        sentinel = env.shared_root / "_relay" / ".sentinel"
        out["checks"].append({
            "name": "mount.sentinel",
            "status": "pass" if sentinel.exists() else "fail",
            "detail": str(sentinel) if sentinel.exists() else
                      f"missing {sentinel}; run `relay bootstrap` or check mount",
        })
    else:
        out["checks"].append({"name": "mount.sentinel", "status": "fail",
                               "detail": "RELAY_SHARED_ROOT not set"})

    declared = env.project
    derived = git_toplevel()
    derived_name = derived.name if derived else None
    # Finding 7: compare sanitized forms so an explicit RELAY_PROJECT that
    # matches the *valid slug grammar* of a dotted/underscored repo (e.g.
    # RELAY_PROJECT=actibot-ego-jy in a checkout named actibot_ego.jy)
    # is treated as consistent. Without this both sides differ literally
    # and preflight fails even though they refer to the same project.
    declared_canon = sanitize_project_slug(declared) if declared else None
    derived_canon = sanitize_project_slug(derived_name) if derived_name else None
    if declared and derived_name and declared_canon != derived_canon:
        out["checks"].append({
            "name": "project.consistency", "status": "fail",
            "detail": (
                f"$RELAY_PROJECT={declared!r} (canonical {declared_canon!r}) "
                f"vs git toplevel basename {derived_name!r} "
                f"(canonical {derived_canon!r}); pick one"
            ),
        })
    elif declared or derived_name:
        out["checks"].append({
            "name": "project.consistency", "status": "pass",
            "detail": f"project={declared_canon or derived_canon}",
        })
    else:
        out["checks"].append({
            "name": "project.consistency", "status": "warn",
            "detail": "no $RELAY_PROJECT and not in git repo",
        })

    if env.shared_root and env.shared_root.is_dir():
        out["checks"].append(_check_active_marker(env.shared_root))

    if env.shared_root and env.shared_root.is_dir():
        for r in run_probes(env.shared_root):
            out["checks"].append({
                "name": f"fs.{r.name}", "status": r.status,
                "detail": r.detail, "elapsed_ms": r.elapsed_ms,
            })
    else:
        out["checks"].append({
            "name": "fs.probes", "status": "fail",
            "detail": f"shared_root not accessible: {env.shared_root}",
        })

    out["exit_code"] = _preflight_exit_code(out["checks"])

    if args.json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
    else:
        print(f"relay preflight :: {env.shared_root or '(unset)'}")
        print()
        icon = {"pass": "[ok]  ", "warn": "[warn]", "fail": "[fail]"}
        for c in out["checks"]:
            el = f" ({c.get('elapsed_ms', 0):>4d}ms)" if "elapsed_ms" in c else ""
            print(f"  {icon[c['status']]} {c['name']:24s}{el}  {c['detail']}")
        print()
        cnt = {"pass": 0, "warn": 0, "fail": 0}
        for c in out["checks"]:
            cnt[c["status"]] += 1
        print(f"summary: {cnt['pass']} pass, {cnt['warn']} warn, {cnt['fail']} fail "
              f"(exit {out['exit_code']})")
        if out["exit_code"] != 0 and not all(out["env"].get(v, False) for v in required):
            _print_env_template()
    return out["exit_code"]


def _ensure_shared_root(root: Path) -> tuple[list[str], list[str]]:
    """Idempotently create RELAY_SHARED_ROOT + _relay/.sentinel. Returns (created, existed)."""
    created: list[str] = []
    existed: list[str] = []

    if not root.exists():
        root.mkdir(mode=0o700, parents=True)
        created.append(str(root))
    else:
        existed.append(str(root))

    relay_meta = root / "_relay"
    if not relay_meta.exists():
        relay_meta.mkdir(mode=0o700)
        created.append(str(relay_meta))
    else:
        existed.append(str(relay_meta))

    sentinel = relay_meta / ".sentinel"
    if not sentinel.exists():
        atomic_write_text(sentinel, f"relay mount sentinel\ncreated_at: {now_iso()}\n", mode=0o644)
        created.append(str(sentinel))
    else:
        existed.append(str(sentinel))

    return created, existed


def _hostname_short() -> str:
    """Match dispatcher .envrc's `$(hostname -s)` short hostname."""
    try:
        res = subprocess.run(["hostname", "-s"], capture_output=True, text=True, check=False)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except FileNotFoundError:
        pass
    return os.uname().nodename.split(".")[0]


def _copy_envrc_template(role: str, project_root: Path) -> tuple[Path, bool]:
    """Copy envrc.<role>.example to <project>/.envrc.<hostname>. Returns (target, created).

    v0.6: only `role == "same-host"` is supported. The legacy `host`/`remote`
    templates were removed; cmd_init handles those values with an explicit
    migration error before this helper is called.
    """
    if role != "same-host":
        raise SystemExit(
            f"relay init: --role {role!r} no longer maps to a template (legacy host/remote "
            "templates removed in v0.6; expected `same-host` here)"
        )
    template = RELAY_PACKAGE_DIR / "templates" / f"envrc.{role}.example"
    if not template.exists():
        raise SystemExit(f"relay init: template not found: {template}")
    target = project_root / f".envrc.{_hostname_short()}"
    if target.exists():
        return target, False
    target.write_text(template.read_text(encoding="utf-8"), encoding="utf-8")
    return target, True


def _copy_envrc_dispatcher(project_root: Path) -> tuple[Path, bool]:
    """Copy templates/envrc.dispatcher.example to <project>/.envrc.

    The dispatcher is the project-agnostic file that sources `.envrc.<hostname>`.
    It's committed in this repo but needs to be installed when adopting the relay
    skill in other projects. Returns (target, created)."""
    template = RELAY_PACKAGE_DIR / "templates" / "envrc.dispatcher.example"
    if not template.exists():
        raise SystemExit(f"relay init: template not found: {template}")
    target = project_root / ".envrc"
    if target.exists():
        return target, False
    target.write_text(template.read_text(encoding="utf-8"), encoding="utf-8")
    return target, True


def cmd_init(args) -> int:
    env = load_env()
    project_root = git_toplevel()
    root = env.shared_root
    if root is None:
        if project_root is None:
            print("relay init: RELAY_SHARED_ROOT not set; either export it or run inside a git repo",
                  file=sys.stderr)
            return 2
        root = project_root / ".shared"
        print(f"relay init: RELAY_SHARED_ROOT not set, defaulting to {root}", file=sys.stderr)

    created, existed = _ensure_shared_root(root)
    if created:
        print("relay init: created:")
        for p in created:
            print(f"  {p}")
    elif existed:
        print(f"relay init: shared root already initialized at {root}")

    role = getattr(args, "role", None)
    author = getattr(args, "author", None)
    peer = getattr(args, "peer", None)
    sync = getattr(args, "sync", None)

    # v0.6: --role host|remote removed. Catch the legacy invocation early
    # so users hit a clear migration message, not a "template not found".
    if role in ("host", "remote"):
        mapping = {"host": "rsync", "remote": "none"}
        print(
            f"relay init: --role {role!r} was removed in v0.6. "
            f"Use the explicit flags instead:\n"
            f"  relay init --author <name> --peer <name> --sync {mapping[role]}\n"
            f"or for two terminals on one machine:\n"
            f"  relay init --role same-host",
            file=sys.stderr,
        )
        return 2

    # --role same-host and the explicit flag set are mutually exclusive.
    explicit_flags = any(v is not None for v in (author, peer, sync))
    if role == "same-host" and explicit_flags:
        print(
            "relay init: --role same-host is mutually exclusive with "
            "--author/--peer/--sync. Pick one.",
            file=sys.stderr,
        )
        return 2

    envrc_just_created = False
    dispatcher_just_created = False
    if role == "same-host" and project_root:
        # Same-host setup: copy the template (handles per-terminal override).
        dispatcher_target, dispatcher_just_created = _copy_envrc_dispatcher(project_root)
        if dispatcher_just_created:
            print(f"relay init: created {dispatcher_target} (from envrc.dispatcher.example)")
        else:
            print(f"relay init: {dispatcher_target} already present")
        envrc_target, envrc_just_created = _copy_envrc_template("same-host", project_root)
        if envrc_just_created:
            print(f"relay init: created {envrc_target} (from envrc.same-host.example)")
        else:
            print(f"relay init: {envrc_target} already present")
    elif explicit_flags and project_root:
        # Explicit flag path: render the envrc body inline. No template copy.
        if not author:
            print("relay init: --author is required with --peer/--sync (or use --role same-host)",
                  file=sys.stderr)
            return 2
        if not peer:
            print("relay init: --peer is required with --author/--sync (or use --role same-host)",
                  file=sys.stderr)
            return 2
        # Finding 8: --author / --peer values land verbatim in a sourceable
        # shell file. Without validation, spaces break the resulting envrc
        # and shell metacharacters (;, $, `, newlines) can inject commands
        # into a file the user is about to `source`. Constrain to the same
        # slug grammar that artifact filenames use; reject everything else.
        for label, value in (("--author", author), ("--peer", peer)):
            if not SLUG_RE.match(value):
                print(
                    f"relay init: {label}={value!r} is not a valid identity slug. "
                    f"Allowed: lowercase letters, digits, hyphens; must start with "
                    f"a letter or digit; max 48 chars (regex {SLUG_RE.pattern}). "
                    f"Examples: claude, codex, gpt55.",
                    file=sys.stderr,
                )
                return 2
        if author == peer:
            print(
                f"relay init: --author and --peer cannot be the same identity "
                f"({author!r}).",
                file=sys.stderr,
            )
            return 2
        sync_value = sync if sync is not None else "none"
        if sync_value not in SYNC_VALUES:
            print(f"relay init: --sync={sync_value!r} invalid; expected one of "
                  f"{sorted(SYNC_VALUES)}", file=sys.stderr)
            return 2
        dispatcher_target, dispatcher_just_created = _copy_envrc_dispatcher(project_root)
        if dispatcher_just_created:
            print(f"relay init: created {dispatcher_target} (from envrc.dispatcher.example)")
        else:
            print(f"relay init: {dispatcher_target} already present")
        envrc_target = project_root / f".envrc.{_hostname_short()}"
        if envrc_target.exists():
            print(f"relay init: {envrc_target} already present (not overwriting)")
        else:
            envrc_target.write_text(_render_envrc_body(author, peer, sync_value),
                                     encoding="utf-8")
            envrc_just_created = True
            print(f"relay init: created {envrc_target} from --author/--peer/--sync flags")
        if sync_value == "rsync" and (not env.remote_ssh or not env.remote_path):
            print("relay init: note — --sync=rsync was set but RELAY_REMOTE_SSH/PATH "
                  "are not exported. Add them to your shell before `source .envrc` "
                  "or `relay sync` will refuse.", file=sys.stderr)

    if project_root and not role and not explicit_flags and not env.role and not env.sync_raw:
        # Nag only when no env is loaded yet AND .envrc.<hostname> is missing.
        hostname = _hostname_short()
        if not (project_root / f".envrc.{hostname}").exists():
            print(f"\nhint: .envrc.{hostname} not found.")
            print("  same-host (two agents on one machine):")
            print("    relay init --role same-host")
            print("  explicit per-side flags:")
            print("    relay init --author codex --peer claude --sync none   # local side")
            print("    relay init --author codex --peer claude --sync rsync  # rsync owner")

    if envrc_just_created and project_root:
        has_direnv = shutil.which("direnv") is not None
        print()
        if has_direnv:
            print(f"next: cd {project_root} && direnv allow")
        else:
            print(f"next: cd {project_root} && source .envrc")
            print("  (install direnv for auto-load on cd)")
        if role == "same-host":
            print("  in the OTHER terminal: export RELAY_AUTHOR=claude && source .envrc")
            print("  (defaults to RELAY_AUTHOR=codex; peer derived automatically)")

    return 0


def _render_envrc_body(author: str, peer: str, sync: str) -> str:
    """Render a per-host .envrc body from explicit identity + sync flags.

    Used by `relay init --author --peer --sync` (the v0.6+ path that doesn't
    go through a template file). Same shape as envrc.same-host.example but
    with the author/peer/sync pinned by the caller instead of derived.
    """
    body = [
        f"# Per-host relay config generated by `relay init --author {author} "
        f"--peer {peer} --sync {sync}`.",
        "# Gitignored. Edit freely; re-run init to regenerate from scratch.",
        "",
        f"export RELAY_AUTHOR={author}",
        f"export RELAY_PEER={peer}",
        f"export RELAY_SYNC={sync}",
        'export RELAY_SHARED_ROOT="$PWD/.shared"',
        "",
    ]
    if sync == "rsync":
        body += [
            "# RELAY_SYNC=rsync requires the remote-transport vars. Fill these in:",
            "# export RELAY_REMOTE_SSH=user@other-host",
            "# export RELAY_REMOTE_PATH=/path/on/other/agent-ledger",
        ]
    else:
        # Finding C3: explain the unconditional `unset` so users don't
        # wonder why their parent-shell exports were cleared after
        # `source .envrc`. Same-host setups commonly inherit rsync vars
        # from a sibling envrc; clearing them prevents `relay sync` from
        # mis-guessing it should run a real transport.
        body += [
            "# RELAY_SYNC=none: clear stale rsync transport vars so `relay sync`",
            "# refuses cleanly instead of attempting a half-configured push.",
            "unset RELAY_REMOTE_SSH RELAY_REMOTE_PATH",
        ]
    return "\n".join(body) + "\n"


def cmd_bootstrap(args) -> int:
    env = load_env()
    if not env.shared_root:
        print("relay bootstrap: RELAY_SHARED_ROOT not set", file=sys.stderr)
        return 2
    if not SLUG_RE.match(args.topic):
        print(f"relay bootstrap: topic must match {SLUG_RE.pattern}", file=sys.stderr)
        return 2

    proj = derive_project(env)
    if not proj:
        print("relay bootstrap: cannot determine project (set RELAY_PROJECT or run in a git repo)",
              file=sys.stderr)
        return 2
    if not SLUG_RE.match(proj):
        print(
            f"relay bootstrap: project {proj!r} is not a valid slug; "
            "set RELAY_PROJECT to a value matching ^[a-z0-9][a-z0-9-]{0,47}$ "
            "(lowercase + digits + hyphen, ≤48 chars).",
            file=sys.stderr,
        )
        return 2

    _ensure_shared_root(env.shared_root)

    date_prefix = datetime.now().strftime("%Y%m%d")
    session_slug = f"{date_prefix}-{args.topic}"
    session_dir = env.shared_root / session_slug
    if session_dir.exists():
        print(f"relay bootstrap: session dir already exists: {session_dir}", file=sys.stderr)
        return 2

    current_active = active_sessions(env.shared_root)
    if current_active and not getattr(args, "force", False):
        names = ", ".join(s.name for s in current_active)
        print(
            "relay bootstrap: active session already exists; close it or use "
            f"--force to create a parallel session: {names}",
            file=sys.stderr,
        )
        return 2

    # Explicitly 0700 (file-protocol §12): shared/session/.draft owner-only.
    session_dir.mkdir(mode=0o700)
    (session_dir / ".draft").mkdir(mode=0o700)

    participants = []
    if env.author:
        participants.append(env.author)
    if env.peer and env.peer not in participants:
        participants.append(env.peer)

    session_json = {
        "schema_version": SCHEMA_VERSION,
        "project": proj,
        "session_id": session_slug,
        "title": args.title or args.topic,
        "state": "active",
        "created_at": now_iso(),
        "closed_at": None,
        "close_reason": None,
        "participants": participants,
    }
    atomic_write_json(session_dir / "session.json", session_json)
    write_active_marker(env.shared_root, session_slug)

    readme = (
        f"# relay session: {session_slug}\n\n"
        f"Project: {proj}\n"
        f"Title: {session_json['title']}\n"
        f"Created: {session_json['created_at']}\n"
        f"Participants: {', '.join(participants) or '(none)'}\n\n"
        f"Use `relay status` to see current state, `relay claim` to start an artifact.\n"
    )
    atomic_write_text(session_dir / "README.md", readme, mode=0o644)

    print(f"created session: {session_dir}")
    print(f"  project:      {proj}")
    print(f"  session_id:   {session_slug}")
    print(f"  participants: {', '.join(participants) or '(none)'}")
    return 0


def cmd_status(args) -> int:
    env = load_env()
    session_id = getattr(args, "session_id", None)
    session = (resolve_session(env, session_id, project=getattr(args, "project", None))
               if session_id else resolve_active_session(env, getattr(args, "project", None)))
    _gc_heartbeat_orphans(session, env.author or "")
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    sj = json.loads((session / "session.json").read_text())

    pub = list_published(session)
    if args.last and args.last > 0:
        pub = pub[-args.last:]

    artifacts = []
    for f in pub:
        try:
            fm, body = parse_frontmatter(f.read_text(encoding="utf-8"))
        except ValueError:
            artifacts.append({"path": str(f.relative_to(session)), "error": "malformed frontmatter"})
            continue
        first_line = next((ln for ln in body.splitlines() if ln.strip()), "")
        artifacts.append({
            "seq": fm.get("seq"),
            "author": fm.get("author"),
            "peer": fm.get("peer"),
            "kind": fm.get("kind"),
            "status": fm.get("status"),
            "created": fm.get("created"),
            "in_reply_to": fm.get("in_reply_to"),
            "sync_needed": fm.get("sync_needed"),
            "corrects": fm.get("corrects"),
            "path": str(f.relative_to(session)),
            "first_line": first_line[:120],
        })

    drafts: list[str] = []
    draft_dir = session / ".draft"
    if draft_dir.is_dir():
        drafts = sorted(p.name for p in draft_dir.glob("*.md"))

    is_active = session_is_active(session)

    payload = {
        "session": sj,
        "session_dir": str(session),
        "is_active": is_active,
        "next_seq": latest_seq(session) + 1,
        "published": artifacts,
        "drafts": drafts,
        "closed_sentinel": (session / "CLOSED").exists(),
    }

    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return 0

    print(f"session: {sj['session_id']}  project={sj.get('project')}")
    print(f"  title:    {sj.get('title')}")
    print(f"  state:    {sj.get('state')}  (is_active={is_active})")
    print(f"  created:  {sj.get('created_at')}")
    if sj.get("closed_at"):
        print(f"  closed:   {sj['closed_at']}  reason={sj.get('close_reason')!r}")
    print(f"  next-seq: {payload['next_seq']}")
    print()
    if artifacts:
        print("published artifacts:")
        for a in artifacts:
            if "error" in a:
                print(f"  ! {a['path']}  ({a['error']})")
                continue
            print(f"  {a['seq']:>3}  [{a['status']:<10}]  {a['author']} -> {a['peer']:<8} "
                  f"{a['kind']:<11}  {a['path']}")
            if a["first_line"]:
                print(f"       | {a['first_line']}")
    else:
        print("(no published artifacts yet)")
    if drafts:
        print()
        print("drafts (hidden):")
        for d in drafts:
            print(f"  .draft/{d}")
    return 0


def cmd_next_seq(args) -> int:
    env = load_env()
    session = resolve_active_session(
        env,
        getattr(args, "project", None),
        getattr(args, "session_id", None),
    )
    print(latest_seq(session) + 1)
    return 0


def _scaffold_frontmatter(env: Env, seq: int, kind: str, in_reply_to: int | None,
                          corrects: int | None = None) -> dict:
    return {
        "seq": seq,
        "author": env.author or "unknown",
        "peer": env.peer or "unknown",
        "kind": kind,
        "status": "draft",
        "created": now_iso(),
        "in_reply_to": in_reply_to if in_reply_to is not None else (seq - 1 if seq > 1 else None),
        "prompt_for_next": "TODO: write actionable instructions for the peer\n",
        "sync_needed": False,
        "touched_paths": [],
        "corrects": corrects,
    }


def cmd_claim(args) -> int:
    env = load_env()
    if args.kind not in KINDS:
        print(f"relay claim: unknown kind {args.kind!r} (known: {sorted(KINDS)})",
              file=sys.stderr)
        return 2
    # Finding 6: --corrects was documented for kind=correction but not
    # actually present on the parser. Enforce it here.
    corrects = getattr(args, "corrects", None)
    if corrects is not None and corrects < 1:
        print(f"relay claim: --corrects must be a positive integer (got {corrects})",
              file=sys.stderr)
        return 2
    # Finding 3 (codex seq 2): reject --corrects on kinds that can't carry it,
    # so the nonsense never reaches a draft. publish re-validates as the hard gate.
    if corrects is not None and args.kind not in CORRECTS_KINDS:
        print(
            f"relay claim: --corrects is only valid for {sorted(CORRECTS_KINDS)}, "
            f"not --kind {args.kind!r}.",
            file=sys.stderr,
        )
        return 2
    if args.kind == "correction" and corrects is None:
        print(
            "relay claim: --corrects <seq> is required when --kind correction; "
            "the field points at the seq this correction supersedes.",
            file=sys.stderr,
        )
        return 2
    try:
        session = resolve_active_session(
            env,
            getattr(args, "project", None),
            getattr(args, "session_id", None),
        )
    except SystemExit as exc:
        msg = str(exc)
        hint = ""
        if "no active session" in msg or "not active" in msg:
            hint = " — run `relay sessions list` to see existing sessions, or `relay bootstrap --topic <slug>` to start a new one."
        elif "multiple active sessions" in msg:
            hint = " — pass `--session-id <id>` to disambiguate."
        print(f"relay claim: {msg}{hint}", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, env.author or "")
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    draft_dir = session / ".draft"
    draft_dir.mkdir(exist_ok=True)

    seq = latest_seq(session) + 1
    author = env.author or "unknown"
    for attempt in range(10):
        if attempt > 0:
            time.sleep(random.uniform(0.01, 0.05))
        draft_name = f"{seq:03d}-{author}-{args.kind}.md"
        draft_path = draft_dir / draft_name
        if draft_path.exists():
            seq += 1
            continue
        fm = _scaffold_frontmatter(env, seq, args.kind, args.in_reply_to,
                                   corrects=corrects)
        body = (
            f"\n# {args.kind} by {author}, seq {seq}\n\n"
            "<!-- write your substantive content here. delete this comment. -->\n"
        )
        try:
            text = dump_frontmatter(fm, body)
            data = text.encode("utf-8")
            tmp = draft_dir / f".{draft_name}.relay-{os.getpid()}-{uuid.uuid4().hex[:8]}.tmp"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                    f.flush()
                    os.fsync(f.fileno())
            except BaseException:
                try:
                    os.close(fd)
                except OSError:
                    pass
                tmp.unlink(missing_ok=True)
                raise
            try:
                os.link(tmp, draft_path)  # atomic O_EXCL via link
            except FileExistsError:
                tmp.unlink(missing_ok=True)
                seq += 1
                continue
            finally:
                tmp.unlink(missing_ok=True)
            _fsync_dir(draft_dir)
            print(draft_path)
            return 0
        except OSError as exc:
            print(f"relay claim: io error: {exc}", file=sys.stderr)
            return 2
    print(
        "relay claim: could not allocate sequence after 10 attempts; "
        "concurrent activity detected — wait briefly and retry, or run "
        "`relay doctor` to inspect for abandoned drafts.",
        file=sys.stderr,
    )
    return 2


_DRAFT_NAME_RE = re.compile(r"^(\d{3})-([a-z0-9-]+)-([a-z0-9-]+)\.md$")


def _validate_draft(draft_path: Path) -> tuple[dict, str]:
    if not draft_path.exists():
        raise ValueError(f"draft not found: {draft_path}")
    if draft_path.parent.name != ".draft":
        raise ValueError(f"draft not under .draft/: {draft_path}")
    try:
        fm, body = parse_frontmatter(draft_path.read_text(encoding="utf-8"))
    except ValueError as exc:
        raise ValueError(f"frontmatter parse error: {exc}") from exc
    required = ["seq", "author", "peer", "kind", "status", "prompt_for_next", "sync_needed"]
    missing = [k for k in required if k not in fm or fm[k] in (None, "")]
    if missing:
        raise ValueError(f"missing required frontmatter fields: {missing}")
    if fm["status"] != "draft":
        raise ValueError(f"draft status must be 'draft' before publish, got {fm['status']!r}")
    pfn = fm["prompt_for_next"]
    if not isinstance(pfn, str) or not pfn.strip():
        raise ValueError("prompt_for_next is empty or whitespace")
    if PLACEHOLDER_MARKER in pfn:
        raise ValueError(f"prompt_for_next still contains placeholder marker {PLACEHOLDER_MARKER!r}")
    if not body.strip():
        raise ValueError("body is empty or whitespace")
    if fm["kind"] not in KINDS:
        raise ValueError(f"unknown kind: {fm['kind']!r}")
    # filename ↔ frontmatter identity (file-protocol §2/§4): NNN-author-kind.md
    m = _DRAFT_NAME_RE.match(draft_path.name)
    if not m:
        raise ValueError(
            f"draft filename does not match NNN-author-kind.md pattern: {draft_path.name}"
        )
    file_seq, file_author, file_kind = int(m.group(1)), m.group(2), m.group(3)
    fm_seq = fm.get("seq")
    if not isinstance(fm_seq, int) or fm_seq != file_seq:
        raise ValueError(
            f"frontmatter/filename seq mismatch: filename={file_seq:03d} "
            f"frontmatter={fm_seq!r}"
        )
    if fm.get("author") != file_author:
        raise ValueError(
            f"frontmatter/filename author mismatch: filename={file_author!r} "
            f"frontmatter={fm.get('author')!r}"
        )
    if fm.get("kind") != file_kind:
        raise ValueError(
            f"frontmatter/filename kind mismatch: filename={file_kind!r} "
            f"frontmatter={fm.get('kind')!r}"
        )
    # Finding 6 (v0.8) + finding 3 (codex seq 2): validate `corrects` for
    # EVERY artifact, not just corrections.
    #   - correction MUST carry a corrects ref.
    #   - any non-null corrects (correction or addendum) must be a positive
    #     int strictly less than this artifact's seq (no self/future refs).
    #   - kinds outside CORRECTS_KINDS MUST NOT carry corrects at all —
    #     otherwise the correction graph accretes nonsense edges that
    #     consumers may treat as real (e.g. a `plan` with `corrects: 1`).
    kind = fm.get("kind")
    c = fm.get("corrects")
    if kind == "correction" and (not isinstance(c, int) or c < 1):
        raise ValueError(
            "kind=correction requires a positive int 'corrects' field "
            f"pointing at the seq being corrected (got {c!r}). "
            "Re-claim with `--corrects <seq>`."
        )
    if c is not None:
        if kind not in CORRECTS_KINDS:
            raise ValueError(
                f"kind={kind!r} must not set 'corrects' (got {c!r}); only "
                f"{sorted(CORRECTS_KINDS)} may carry a correction reference."
            )
        if not isinstance(c, int) or c < 1:
            raise ValueError(
                f"'corrects' must be a positive int (got {c!r})."
            )
        if c >= fm["seq"]:
            raise ValueError(
                f"corrects={c} must be less than this artifact's seq "
                f"({fm['seq']}); you cannot correct a self/future artifact."
            )
    return fm, body


def cmd_publish(args) -> int:
    draft_path = Path(args.draft_path).resolve()
    try:
        fm, body = _validate_draft(draft_path)
    except ValueError as exc:
        print(f"relay publish: {exc}", file=sys.stderr)
        return 2

    session = draft_path.parent.parent
    _env_pub = load_env()
    # Finding 3 (v0.8 audit) + finding 2 (codex seq 2): prevent author
    # forgery. _validate_draft only checks that filename and frontmatter
    # agree on author; it does NOT check the active RELAY_AUTHOR. Publish
    # is the integrity boundary and must FAIL CLOSED when identity is
    # missing — the earlier `if _env_pub.author and ...` form skipped the
    # guard entirely when RELAY_AUTHOR was unset, letting an env-less
    # publish forge any author.
    if not _env_pub.author:
        print(
            "relay publish: RELAY_AUTHOR is not set; refusing to publish "
            "without a known identity (publish is the authorship boundary).",
            file=sys.stderr,
        )
        return 2
    if fm.get("author") != _env_pub.author:
        print(
            f"relay publish: refusing to publish draft authored by "
            f"{fm.get('author')!r} from RELAY_AUTHOR={_env_pub.author!r} — "
            f"set RELAY_AUTHOR to match the draft, or re-claim under the "
            f"current author.",
            file=sys.stderr,
        )
        return 2
    _gc_heartbeat_orphans(session, _env_pub.author or "")
    _gc_renewal_orphans(session, _env_pub)
    _maybe_tick_renewal(session, _env_pub)
    base = draft_path.name[:-3]  # strip .md
    final_status = args.status if args.status else "ready"
    if final_status not in STATUSES or final_status == "draft":
        print(f"relay publish: invalid --status: {final_status!r}", file=sys.stderr)
        return 2
    if not session_is_active(session):
        if not getattr(args, "force", False):
            print(
                f"relay publish: refusing to publish into inactive session: {session} "
                "— session is closed/terminal; `relay bootstrap --topic <slug>` to "
                "start a new session, or pass `--force --force-reason <text> "
                "--status <closed|cancelled|failed|timed_out>` to record a terminal note.",
                file=sys.stderr,
            )
            return 2
        force_reason = getattr(args, "force_reason", None)
        if not force_reason:
            print("relay publish: --force requires --force-reason", file=sys.stderr)
            return 2
        if final_status not in TERMINAL_STATUSES:
            print(
                "relay publish: --force requires terminal --status "
                f"({', '.join(sorted(TERMINAL_STATUSES))})",
                file=sys.stderr,
            )
            return 2
        fm["force_reason"] = force_reason
    fm["status"] = final_status
    fm["created"] = now_iso()

    seq = int(fm["seq"])
    for attempt in range(10):
        if attempt > 0:
            time.sleep(random.uniform(0.05, 0.20))
        paths = published_paths(session, base)
        text = dump_frontmatter(fm, body)
        try:
            # Finding 2: O_CREAT|O_EXCL reserves the final path atomically;
            # truly concurrent publishers cannot both win the same seq.
            atomic_reserve_text(paths["md"], text, mode=0o600)
        except FileExistsError:
            old_seq = seq
            seq += 1
            base = f"{seq:03d}-{fm['author']}-{fm['kind']}"
            fm["seq"] = seq
            # Finding C1: surface the bump so concurrent publishing is
            # observable rather than silent.
            print(
                f"relay publish: seq {old_seq:03d} taken by concurrent "
                f"publisher, retrying as {seq:03d}",
                file=sys.stderr,
            )
            continue
        digest = sha256_of_file(paths["md"])
        atomic_write_text(paths["sha256"], f"{digest}  {paths['md'].name}\n", mode=0o644)
        atomic_write_bytes(paths["ready"], b"", mode=0o644)
        try:
            draft_path.unlink()
        except FileNotFoundError:
            pass
        _fsync_dir(session)
        # Best-effort: tear down any heartbeat the SKILL spawned for this draft.
        env_pub = load_env()
        try:
            cmd_heartbeat_stop(type("A", (), {
                "draft": str(draft_path), "force": True,
                "project": None, "session_id": None,
            })())
        except Exception as exc:
            print(f"relay publish: heartbeat stop warning: {exc}", file=sys.stderr)
        if final_status in TERMINAL_STATUSES:
            if env_pub.shared_root:
                clear_active_marker(env_pub.shared_root, session.name)
        print(paths["md"])
        return 0
    print(
        "relay publish: could not allocate published path after 10 attempts; "
        "concurrent activity detected — wait briefly and retry, or run "
        "`relay doctor` to inspect.",
        file=sys.stderr,
    )
    return 2


def _read_field_source(label: str, value: str | None) -> str | None:
    """Resolve --body-file / --prompt-for-next-file value.

    Returns the field's text, or None if the user did not pass the flag.
    Value is either a file path or '-' for stdin. The caller is responsible
    for ensuring at most one source reads stdin per invocation.
    """
    if value is None:
        return None
    if value == "-":
        return sys.stdin.read()
    try:
        return Path(value).read_text(encoding="utf-8")
    except OSError as exc:
        raise ValueError(f"--{label}-file: cannot read {value}: {exc}") from exc


def cmd_draft_set(args) -> int:
    """Fill a draft's body / prompt_for_next / sync_needed / touched_paths /
    corrects without going through the agent's native Write tool (finding 9).

    Preserves seq, author, peer, kind, created, in_reply_to, status. The
    atomic write goes through a tmp+rename within the .draft/ dir.
    """
    draft_path = Path(args.draft_path).resolve()
    if not draft_path.exists():
        print(f"relay draft set: draft not found: {draft_path}", file=sys.stderr)
        return 2
    if draft_path.parent.name != ".draft":
        print(f"relay draft set: not under .draft/: {draft_path}", file=sys.stderr)
        return 2

    # Finding 1 (codex seq 2): draft set is a write boundary just like
    # publish. Without an author-ownership check, a peer who discovers a
    # draft path (e.g. via `relay status`, which lists draft names) can
    # rewrite the other author's draft body/prompt while preserving its
    # author frontmatter — reopening the authorship-forgery class that the
    # publish guard closes. Enforce ownership before any read/parse.
    _env_ds = load_env()
    if not _env_ds.author:
        print(
            "relay draft set: RELAY_AUTHOR is not set; refusing to mutate a "
            "draft without a known identity.",
            file=sys.stderr,
        )
        return 2
    m_ds = _DRAFT_NAME_RE.match(draft_path.name)
    if not m_ds:
        print(
            f"relay draft set: draft filename does not match NNN-author-kind.md "
            f"pattern: {draft_path.name}",
            file=sys.stderr,
        )
        return 2
    draft_author = m_ds.group(2)
    if draft_author != _env_ds.author:
        print(
            f"relay draft set: refusing to mutate draft authored by "
            f"{draft_author!r} from RELAY_AUTHOR={_env_ds.author!r} — only the "
            f"draft's own author may fill it.",
            file=sys.stderr,
        )
        return 2

    stdin_sources = sum(1 for v in (args.body_file, args.prompt_for_next_file) if v == "-")
    if stdin_sources > 1:
        print(
            "relay draft set: at most one of --body-file / --prompt-for-next-file "
            "may be '-' per invocation (stdin can only be read once).",
            file=sys.stderr,
        )
        return 2

    try:
        body_new = _read_field_source("body", args.body_file)
        pfn_new = _read_field_source("prompt-for-next", args.prompt_for_next_file)
    except ValueError as exc:
        print(f"relay draft set: {exc}", file=sys.stderr)
        return 2

    try:
        text = draft_path.read_text(encoding="utf-8")
        fm, body = parse_frontmatter(text)
    except (OSError, ValueError) as exc:
        print(f"relay draft set: cannot parse draft: {exc}", file=sys.stderr)
        return 2

    if body_new is not None:
        body = body_new
    if pfn_new is not None:
        fm["prompt_for_next"] = pfn_new
    if args.sync_needed:
        fm["sync_needed"] = True
    if args.touched_path:
        # Append (don't replace) — multiple set invocations should accumulate.
        existing = fm.get("touched_paths") or []
        for tp in args.touched_path:
            if tp not in existing:
                existing.append(tp)
        fm["touched_paths"] = existing
    if args.corrects is not None:
        if args.corrects < 1:
            print(
                f"relay draft set: --corrects must be a positive integer "
                f"(got {args.corrects})",
                file=sys.stderr,
            )
            return 2
        # Finding 3 (codex seq 2): don't let draft set stamp corrects onto a
        # kind that can't carry it. publish re-validates regardless.
        if fm.get("kind") not in CORRECTS_KINDS:
            print(
                f"relay draft set: --corrects is only valid for "
                f"{sorted(CORRECTS_KINDS)}, not kind {fm.get('kind')!r}.",
                file=sys.stderr,
            )
            return 2
        fm["corrects"] = args.corrects

    new_text = dump_frontmatter(fm, body)
    try:
        atomic_write_text(draft_path, new_text, mode=0o600)
    except OSError as exc:
        print(f"relay draft set: write failed: {exc}", file=sys.stderr)
        return 2
    print(draft_path)
    return 0


# ---------------------------------------------------------------------------
# issue ledger — machine-global feedback channel
# ---------------------------------------------------------------------------
#
# A place for agents to record problems they hit *while using the relay tool
# itself*, so a developer can triage them in a later dev cycle. The store is
# user-local machine storage: deliberately NOT under .shared/ (per-session,
# gitignored, ephemeral) and NOT under the repo (issues are about the tool,
# accumulated across every project/session for this user on this machine).
# `relay sync` never moves issues — they stay on the host that filed them.
# Default ~/.agent-ledger/relay-issues/, override via RELAY_ISSUES_DIR.
# Issues are a mutable tracker (resolve edits them), not append-only
# ledger artifacts.

ISSUE_SEVERITIES = {"minor", "major"}
ISSUE_AREAS = {"cli", "hooks", "docs", "protocol", "tests", "build", "other"}
ISSUE_STATUSES = {"open", "resolved"}
# An issue id is `YYYYMMDDThhmmss-<8hex>`; a triage prefix is a leading slice
# of that. The alphabet is digits + letters + hyphen ONLY. This regex is the
# security gate for `show`/`resolve` (codex v0.10 review finding 1): it rejects
# `/`, `\`, `.` (so `..` and absolute/relative paths cannot form) and every
# glob metacharacter, BEFORE the value is ever composed into a path.
_ISSUE_REF_RE = re.compile(r"^[0-9A-Za-z-]+$")


def issues_dir() -> Path:
    override = os.environ.get("RELAY_ISSUES_DIR")
    if override:
        return Path(override).expanduser()
    return Path.home() / ".agent-ledger" / "relay-issues"


def _ensure_issues_dir() -> Path:
    d = issues_dir()
    d.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    return d


def _issue_id() -> str:
    stamp = datetime.now().astimezone().strftime("%Y%m%dT%H%M%S")
    return f"{stamp}-{uuid.uuid4().hex[:8]}"


def _read_issue(path: Path) -> Optional[tuple[dict, str]]:
    try:
        fm, body = parse_frontmatter(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return fm, body


def _resolve_issue(d: Path, ref: str) -> tuple[str, object]:
    """Resolve an issue reference (full id or leading prefix) to a file
    that lives DIRECTLY inside `d`.

    Returns one of:
      ("ok", Path)            unique match
      ("none", None)          no match
      ("ambiguous", [stems])  >1 prefix match — caller should disambiguate
      ("invalid", ref)        ref is not a safe id/prefix token

    Security (codex v0.10 finding 1): `ref` is validated against
    `_ISSUE_REF_RE` before any path composition, so `..`, `/`, absolute
    paths, and glob metacharacters can never reach the filesystem. As
    defense in depth we also confirm each candidate's resolved parent is
    exactly `d`, so even a symlink inside the store can't redirect us out.
    """
    if not ref or not _ISSUE_REF_RE.match(ref):
        return ("invalid", ref)
    if not d.is_dir():
        return ("none", None)
    d_resolved = d.resolve()
    matches: list[Path] = []
    for p in sorted(d.glob("*.md")):
        stem = p.stem
        if stem != ref and not stem.startswith(ref):
            continue
        try:
            if p.resolve().parent != d_resolved:
                continue  # symlink or odd entry pointing outside the store
        except OSError:
            continue
        matches.append(p)
    exact = [p for p in matches if p.stem == ref]
    if exact:
        return ("ok", exact[0])
    if len(matches) == 1:
        return ("ok", matches[0])
    if len(matches) > 1:
        return ("ambiguous", sorted(p.stem for p in matches))
    return ("none", None)


def _resolve_issue_or_report(cmd: str, d: Path, ref: str) -> Optional[Path]:
    """Shared show/resolve front-end: resolve `ref`, print the right error
    to stderr for the non-ok cases, and return the Path only on success."""
    status, value = _resolve_issue(d, ref)
    if status == "ok":
        return value  # type: ignore[return-value]
    if status == "invalid":
        print(f"relay issue {cmd}: invalid id {ref!r} — ids are "
              f"[0-9A-Za-z-] only (no path separators, '..', or globs).",
              file=sys.stderr)
    elif status == "ambiguous":
        cands = ", ".join(value)  # type: ignore[arg-type]
        print(f"relay issue {cmd}: ambiguous prefix {ref!r} matches "
              f"{len(value)} issues: {cands}. Use a longer prefix or the full id.",
              file=sys.stderr)
    else:  # none
        print(f"relay issue {cmd}: no issue matching {ref!r} in {d}",
              file=sys.stderr)
    return None


def cmd_issue_add(args) -> int:
    title = (getattr(args, "title", None) or "").strip()
    if not title:
        print("relay issue add: --title is required and must be non-empty",
              file=sys.stderr)
        return 2
    severity = getattr(args, "severity", None) or "minor"
    if severity not in ISSUE_SEVERITIES:
        print(f"relay issue add: --severity must be one of {sorted(ISSUE_SEVERITIES)}",
              file=sys.stderr)
        return 2
    area = getattr(args, "area", None) or "other"
    if area not in ISSUE_AREAS:
        print(f"relay issue add: --area must be one of {sorted(ISSUE_AREAS)}",
              file=sys.stderr)
        return 2

    body_inline = getattr(args, "body", None)
    body_file = getattr(args, "body_file", None)
    if body_inline is not None and body_file is not None:
        print("relay issue add: pass at most one of --body / --body-file",
              file=sys.stderr)
        return 2
    body = ""
    if body_inline is not None:
        body = body_inline
    elif body_file is not None:
        try:
            body = _read_field_source("body", body_file)
        except ValueError as exc:
            print(f"relay issue add: {exc}", file=sys.stderr)
            return 2

    env = load_env()
    # Best-effort session context — issues can be filed with no active session.
    session_id = None
    try:
        session_id = resolve_active_session(env).name
    except SystemExit:
        session_id = None

    d = _ensure_issues_dir()
    body_text = body.strip() or title
    created = now_iso()
    reporter = env.author or "unknown"
    project = derive_project(env) or "unknown"
    # Reserve the file exclusively (codex v0.10 design call): id collision is
    # astronomically unlikely (timestamp + uuid8), but the safe primitive
    # already exists, so use it and regenerate the id on the off chance.
    for _ in range(5):
        issue_id = _issue_id()
        fm = {
            "id": issue_id, "created": created, "reporter": reporter,
            "project": project, "session": session_id,
            "severity": severity, "area": area, "title": title,
            "status": "open", "resolved_at": None, "resolution": None,
        }
        path = d / f"{issue_id}.md"
        try:
            atomic_reserve_text(path, dump_frontmatter(fm, body_text + "\n"),
                                mode=0o600)
        except FileExistsError:
            continue
        print(path)
        return 0
    print("relay issue add: could not allocate a unique issue id after 5 "
          "attempts — retry in a moment.", file=sys.stderr)
    return 2


def _scan_issues(d: Path) -> tuple[list[dict], list[str]]:
    """Return (parsed frontmatters, names of unreadable/unparseable files).

    A feedback ledger must never silently drop entries (codex v0.10
    finding 2): a corrupt or hand-edited file is exactly the kind of thing
    triage needs to SEE, not have hidden.
    """
    rows: list[dict] = []
    bad: list[str] = []
    if not d.is_dir():
        return rows, bad
    for p in sorted(d.glob("*.md")):
        parsed = _read_issue(p)
        if parsed is None:
            bad.append(p.name)
        else:
            rows.append(parsed[0])
    return rows, bad


def cmd_issue_list(args) -> int:
    d = issues_dir()
    status = getattr(args, "status", None) or "open"
    allowed = ISSUE_STATUSES | {"all"}
    if status not in allowed:
        print(f"relay issue list: --status must be one of {sorted(allowed)}",
              file=sys.stderr)
        return 2
    area = getattr(args, "area", None)
    all_fm, unreadable = _scan_issues(d)
    rows = []
    for fm in all_fm:
        if status != "all" and fm.get("status") != status:
            continue
        if area and fm.get("area") != area:
            continue
        rows.append(fm)
    if getattr(args, "json", False):
        # Object (not bare array) so unreadable files are always visible to
        # machine consumers, not silently dropped.
        print(json.dumps({"issues": rows, "unreadable": unreadable},
                         indent=2, ensure_ascii=False))
        return 1 if unreadable else 0
    if rows:
        print(f"{status} issues in {d}:")
        for fm in rows:
            print(f"  [{fm.get('severity','?'):5}] {fm.get('area','?'):8} "
                  f"{fm.get('id')}  {fm.get('title','')}")
            if fm.get("status") == "resolved" and fm.get("resolution"):
                print(f"          resolved: {fm.get('resolution')}")
    else:
        print(f"no {status} issues in {d}")
    if unreadable:
        print(f"relay issue list: WARNING {len(unreadable)} unreadable issue "
              f"file(s) skipped (inspect/fix manually): {', '.join(unreadable)}",
              file=sys.stderr)
        return 1
    return 0


def cmd_issue_show(args) -> int:
    d = issues_dir()
    path = _resolve_issue_or_report("show", d, args.id)
    if path is None:
        return 2
    if getattr(args, "json", False):
        parsed = _read_issue(path)
        if parsed is None:
            print(f"relay issue show: cannot parse {path}", file=sys.stderr)
            return 2
        fm, body = parsed
        print(json.dumps({"path": str(path), "frontmatter": fm, "body": body},
                         indent=2, ensure_ascii=False))
        return 0
    print(path.read_text(encoding="utf-8"))
    return 0


def cmd_issue_resolve(args) -> int:
    d = issues_dir()
    path = _resolve_issue_or_report("resolve", d, args.id)
    if path is None:
        return 2
    parsed = _read_issue(path)
    if parsed is None:
        print(f"relay issue resolve: cannot parse {path}", file=sys.stderr)
        return 2
    fm, body = parsed
    fm["status"] = "resolved"
    fm["resolved_at"] = now_iso()
    if getattr(args, "note", None):
        fm["resolution"] = args.note
    atomic_write_text(path, dump_frontmatter(fm, body), mode=0o600)
    print(path)
    return 0


def cmd_close(args) -> int:
    env = load_env()
    try:
        session = resolve_active_session(
            env,
            getattr(args, "project", None),
            getattr(args, "session_id", None),
        )
    except SystemExit as exc:
        msg = str(exc)
        if "multiple active sessions" in msg:
            print(f"relay close: {msg}", file=sys.stderr)
            return 2
        # Surface "already closed" instead of the generic "no active session"
        # when a session in the project already has a CLOSED sentinel.
        if "no active session" in msg:
            try:
                root = session_root(env)
            except SystemExit:
                print(f"relay close: {msg}", file=sys.stderr)
                return 2
            for sd in iter_session_dirs(root):
                if (sd / "CLOSED").exists():
                    print(
                        f"relay close: already closed (sentinel at {sd / 'CLOSED'})",
                        file=sys.stderr,
                    )
                    return 2
        print(f"relay close: {msg}", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, env.author or "")
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)
    sentinel = session / "CLOSED"
    if sentinel.exists():
        print(f"relay close: already closed (sentinel exists at {sentinel})", file=sys.stderr)
        return 2
    close_meta = (
        f'reason = {json.dumps(args.reason)}\n'
        f'outcome = {json.dumps(args.outcome or "")}\n'
        f'closed_by = {json.dumps(env.author or "unknown")}\n'
        f'closed_at = {json.dumps(now_iso())}\n'
    )
    atomic_write_text(sentinel, close_meta, mode=0o644)

    sj_path = session / "session.json"
    data = json.loads(sj_path.read_text())
    data["state"] = "closed"
    data["closed_at"] = now_iso()
    data["close_reason"] = args.reason
    atomic_write_json(sj_path, data)
    if env.shared_root:
        clear_active_marker(env.shared_root, session.name)

    print(f"closed: {session}")
    print(f"  reason:   {args.reason}")
    print(f"  outcome:  {args.outcome or '(none)'}")
    return 0


def _session_list_payload(root: Path) -> list[dict]:
    marker = read_active_marker(root)
    items: list[dict] = []
    for sd in iter_session_dirs(root):
        try:
            sj = json.loads((sd / "session.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            sj = {}
        latest = latest_artifact_frontmatter(sd)
        items.append({
            "session_id": sd.name,
            "project": sj.get("project"),
            "title": sj.get("title"),
            "state": sj.get("state"),
            "category": session_category(sd),
            "is_active": session_is_active(sd),
            "active_marker": marker == sd.name,
            "closed_sentinel": (sd / "CLOSED").exists(),
            "next_seq": latest_seq(sd) + 1,
            "latest": latest,
            "path": str(sd),
        })
    return items


def cmd_sessions_list(args) -> int:
    env = load_env()
    try:
        root = session_root(env)
    except SystemExit as exc:
        print(f"relay sessions list: {exc}", file=sys.stderr)
        return 2
    payload = {
        "shared_root": str(root),
        "active_marker": read_active_marker(root),
        "sessions": _session_list_payload(root),
    }
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return 0
    print(f"sessions under {root}:")
    if not payload["sessions"]:
        print("  (none)")
        return 0
    for item in payload["sessions"]:
        marker = " marker" if item["active_marker"] else ""
        latest = item["latest"] or {}
        latest_desc = ""
        if latest:
            latest_desc = f" latest={latest.get('seq')}:{latest.get('status')}"
        print(
            f"  {item['session_id']}  {item['category']}{marker}"
            f" state={item.get('state')}{latest_desc}"
        )
    return 0


# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

def _is_fuse_mount(path: Path) -> bool:
    try:
        res = subprocess.run(
            ["stat", "-f", "-c", "%T", str(path)],
            capture_output=True, text=True, check=False,
        )
        if res.returncode == 0:
            t = res.stdout.strip()
            return t.startswith("fuse") or t == "fuseblk"
    except FileNotFoundError:
        pass
    return False


def _gitignore_has_negation(repo: Path) -> bool:
    gi = repo / ".gitignore"
    if not gi.exists():
        return False
    for ln in gi.read_text(errors="replace").splitlines():
        s = ln.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("!"):
            return True
    return False


def cmd_sync(args) -> int:
    env = load_env()
    top = git_toplevel()
    if not top:
        print("relay sync: not in a git repo (need project root)", file=sys.stderr)
        return 2
    project_root = top
    is_shape_a = _is_fuse_mount(project_root)
    sync_effective, sync_source = _resolve_sync(env, is_shape_a=is_shape_a)
    if sync_effective != "rsync":
        # Cover both "explicit none" and "could not resolve". Be specific about which.
        if sync_source == "env":
            reason = f"RELAY_SYNC={env.sync_raw!r}; this side does not own rsync transport"
        elif sync_source == "shape-a-infer":
            reason = (f"$PROJECT_ROOT={project_root} is a fuse mount (shape A); "
                      "no sync needed (edits land on the remote directly)")
        elif sync_source == "role-removed":
            # Shape-A carve-out: rsync is structurally inapplicable when the
            # project root IS the fuse mount, so don't suggest RELAY_SYNC=rsync
            # even if the legacy role was `host` — that'd contradict the
            # topology preflight surfaces in the same checkout.
            if is_shape_a:
                reason = (f"RELAY_ROLE={env.role!r} is no longer recognized "
                          "(removed in v0.6) and this is shape A (project root "
                          "is a fuse mount; rsync structurally inapplicable); "
                          "set RELAY_SYNC=none instead — no sync is needed here")
            else:
                mapping = "rsync" if env.role == "host" else "none"
                reason = (f"RELAY_ROLE={env.role!r} is no longer recognized "
                          f"(removed in v0.6); set RELAY_SYNC={mapping} instead")
        else:
            reason = ("RELAY_SYNC not set; "
                      "set RELAY_SYNC=rsync on the side that owns the rsync transport")
        print(f"relay sync: {reason}", file=sys.stderr)
        return 2
    if not env.remote_ssh or not env.remote_path:
        print(
            "relay sync: RELAY_REMOTE_SSH and RELAY_REMOTE_PATH must be set "
            "(only the rsync owner runs sync; same-host or RELAY_SYNC=none "
            "sides skip this step). Run `relay sync push --dry-run` first.",
            file=sys.stderr,
        )
        return 2
    if is_shape_a:
        # Contradiction: RELAY_SYNC=rsync was explicitly set, but the project
        # root is itself the shared mount. Refuse rather than do a destructive
        # rsync over the mount.
        print(f"relay sync: $PROJECT_ROOT={project_root} is a fuse mount but "
              "RELAY_SYNC=rsync; refusing (shape A: nothing to sync)", file=sys.stderr)
        return 2

    direction = args.direction
    rsync_cmd: list[str] = ["rsync", "-avh", "--progress"]
    if args.dry_run:
        rsync_cmd.append("-n")
    if args.delete:
        rsync_cmd.append("--delete")

    if args.strict_gitignore and direction == "pull":
        # v1 only builds the file list from LOCAL git ls-files, which on pull
        # misses remote-only files — exactly what pull must recover. Rather
        # than silently lose data, refuse. v1.1 backlog: run ls-files on the
        # remote via ssh in $RELAY_REMOTE_PATH for honest strict pull.
        print(
            "relay sync: --strict-gitignore is not supported for pull in v1 "
            "(would use LOCAL file list and miss remote-only files). Use the "
            "default mode `relay sync pull` instead, or wait for v1.1.",
            file=sys.stderr,
        )
        return 2

    if args.strict_gitignore:
        # build file list via git (push only — local is the source of truth)
        files_list = subprocess.run(
            ["git", "-C", str(project_root), "ls-files", "--cached", "--others",
             "--exclude-standard", "-z"],
            capture_output=True, check=False,
        )
        if files_list.returncode != 0:
            print(f"relay sync: git ls-files failed: {files_list.stderr.decode()}",
                  file=sys.stderr)
            return 2
        tmpfile = Path(f"/tmp/relay-sync-{os.getpid()}-{uuid.uuid4().hex[:8]}.lst")
        tmpfile.write_bytes(files_list.stdout)
        rsync_cmd += ["--files-from", str(tmpfile), "--from0",
                       "--exclude=.git", "--exclude=.shared"]
    else:
        # default mode: --filter=':- .gitignore'
        print("WARNING: --filter=':- .gitignore' does NOT honor reverse !path rules.", file=sys.stderr)
        if _gitignore_has_negation(project_root):
            print("  Your .gitignore contains !path rules — STRONGLY recommend "
                  "--strict-gitignore.", file=sys.stderr)
        if not args.dry_run:
            print("  First sync? Run with --dry-run first.", file=sys.stderr)
        rsync_cmd += [
            "--filter=:- .gitignore",
            "--exclude=.git",
            "--exclude=.shared",
        ]

    src = f"{project_root}/"
    dst = f"{env.remote_ssh}:{env.remote_path}/"
    if direction == "push":
        rsync_cmd += [src, dst]
    elif direction == "pull":
        rsync_cmd += [dst, src]
    else:
        print(f"relay sync: unknown direction {direction!r}", file=sys.stderr)
        return 2

    print(f"$ {shlex.join(rsync_cmd)}", file=sys.stderr)
    res = subprocess.run(rsync_cmd, check=False)
    if args.strict_gitignore:
        try:
            tmpfile.unlink()
        except FileNotFoundError:
            pass
    return res.returncode


# ---------------------------------------------------------------------------
# heartbeat infrastructure (Stage 2): owner-identity model + double-fork daemon
# + on-entry GC.
#
# Heartbeat sidecar lives next to the draft as `<draft>.heartbeat` and contains
# JSON metadata; its mtime is the liveness signal consumed by `relay wait`
# (Stage 2 exit code 11) and by on-entry GC.
#
# Owner kinds (see decision artifact 20260528-stage3-renewal-design seq 9
# §4.3):
#   agent / tool-process               pid-based; os.kill(pid, 0)
#   pidfile                            reads pid from a file, then os.kill
#   renewal-file                       mtime within RELAY_RENEWAL_STALE_THRESHOLD
#                                      (default 3600s, floor 60s). Stage 3 wires the tick that
#                                      keeps it fresh; in Stage 2 alone, this
#                                      kind has no live writer so don't use it
#                                      as a default.
#   none                               always alive (explicit timeout-only mode)
#
# tmux-pane was advertised in the locked spec but the impl was not wired to
# `tmux list-panes -t <pane>`. The kind is removed for now; reintroduce when
# the tmux verification strategy is implemented (would need a string pane id,
# not --owner-pid int).
# ---------------------------------------------------------------------------


def _heartbeat_sidecar_path(draft_path: Path) -> Path:
    return draft_path.parent / f"{draft_path.name}.heartbeat"


def _heartbeat_pidfile_path(session: Path, author: str) -> Path:
    return session / "_relay" / f"{author}.heartbeat.pid"


def _owner_alive(kind: str, *, owner_pid: Optional[int] = None,
                 owner_pidfile: Optional[str] = None,
                 owner_renewal_file: Optional[str] = None) -> bool:
    if kind == "none":
        return True
    if kind in {"agent", "tool-process"}:
        if owner_pid is None:
            return False
        try:
            os.kill(owner_pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True  # exists, not ours; still alive
        except OSError:
            return False
        return True
    if kind == "pidfile":
        if not owner_pidfile:
            return False
        try:
            pid_text = Path(owner_pidfile).read_text(encoding="utf-8").strip()
            pid = int(pid_text)
        except (OSError, ValueError):
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        except OSError:
            return False
        return True
    if kind == "renewal-file":
        if not owner_renewal_file:
            return False
        try:
            mtime = os.stat(owner_renewal_file).st_mtime
        except FileNotFoundError:
            return False
        except OSError:
            return False
        threshold = max(_wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60)
        return mtime >= time.time() - threshold
    return False


def _heartbeat_daemon_main(sidecar_path: Path, pidfile_path: Path,
                            owner_kind: str, owner_pid: Optional[int],
                            owner_pidfile: Optional[str],
                            owner_renewal_file: Optional[str],
                            interval: int) -> None:
    """Daemon main loop — runs in the detached grandchild."""
    # Close stdio to fully detach.
    for fd in (0, 1, 2):
        try:
            os.close(fd)
        except OSError:
            pass
    # Reopen to /dev/null so any stray prints don't EPIPE.
    try:
        devnull = os.open(os.devnull, os.O_RDWR)
        os.dup2(devnull, 0)
        os.dup2(devnull, 1)
        os.dup2(devnull, 2)
        if devnull > 2:
            os.close(devnull)
    except OSError:
        pass

    # Write pidfile.
    try:
        atomic_write_text(pidfile_path, f"{os.getpid()}\n", mode=0o600)
    except OSError:
        os._exit(1)

    interval = max(int(interval), 1)
    while True:
        try:
            time.sleep(interval)
            if not _owner_alive(owner_kind,
                                 owner_pid=owner_pid,
                                 owner_pidfile=owner_pidfile,
                                 owner_renewal_file=owner_renewal_file):
                os._exit(0)
            # Update mtime; the sidecar JSON is written once at start so the
            # waiter's stat-based stale check sees fresh mtime as the proof.
            try:
                os.utime(sidecar_path, None)
            except FileNotFoundError:
                # sidecar removed externally → caller must have stopped us
                os._exit(0)
        except KeyboardInterrupt:
            os._exit(0)
        except BaseException:
            os._exit(1)


def _spawn_heartbeat_daemon(sidecar_path: Path, pidfile_path: Path,
                             owner_kind: str, owner_pid: Optional[int],
                             owner_pidfile: Optional[str],
                             owner_renewal_file: Optional[str],
                             interval: int) -> int:
    """Double-fork; return the detached daemon's pid via pipe from grandchild."""
    r, w = os.pipe()
    first = os.fork()
    if first > 0:
        os.close(w)
        try:
            os.waitpid(first, 0)
            raw = os.read(r, 64)
        finally:
            os.close(r)
        try:
            return int(raw.decode().strip())
        except (ValueError, AttributeError):
            return -1
    # first child
    os.close(r)
    try:
        os.setsid()
    except OSError:
        pass
    second = os.fork()
    if second > 0:
        try:
            os.write(w, f"{second}\n".encode())
        finally:
            os.close(w)
        os._exit(0)
    # second child — the daemon
    os.close(w)
    _heartbeat_daemon_main(sidecar_path, pidfile_path,
                            owner_kind, owner_pid, owner_pidfile,
                            owner_renewal_file, interval)
    os._exit(0)


def _heartbeat_is_running(pidfile_path: Path) -> tuple[bool, Optional[int]]:
    if not pidfile_path.exists():
        return False, None
    try:
        pid = int(pidfile_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False, None
    try:
        os.kill(pid, 0)
        return True, pid
    except ProcessLookupError:
        return False, pid
    except PermissionError:
        return True, pid
    except OSError:
        return False, pid


def _heartbeat_drafts_for_author(session: Path, author: str) -> list[Path]:
    """Return draft .md files belonging to current author that have a heartbeat sidecar."""
    out: list[Path] = []
    draft_dir = session / ".draft"
    if not draft_dir.is_dir():
        return out
    prefix_re = re.compile(rf"^\d{{3}}-{re.escape(author)}-[a-z0-9-]+\.md$")
    for draft in draft_dir.glob("*.md"):
        if not prefix_re.match(draft.name):
            continue
        if _heartbeat_sidecar_path(draft).exists():
            out.append(draft)
    return out


def _gc_heartbeat_orphans(session: Path, author: str) -> None:
    """Kill orphan heartbeat daemons + remove their files.

    Decision matrix (per locked spec §4.4):
        daemon alive  | sidecar stale | owner alive | verdict
        ----------------------------------------------------------
        yes           | no            | yes         | live, leave alone
        yes           | no            | no          | orphan — kill daemon, clean
        yes           | yes           | any         | orphan — daemon hung, kill + clean
        yes           | n/a absent    | n/a         | pid reuse/sidecar loss — files-only clean
        no            | any           | any         | orphan — pidfile leak, clean

    Runs at the top of every session-scoped relay subcommand. Silent.
    """
    if not author:
        return
    pidfile = _heartbeat_pidfile_path(session, author)
    if not pidfile.exists():
        return
    running, pid = _heartbeat_is_running(pidfile)

    if not running:
        _heartbeat_purge(session, author, pidfile, pid=None)
        return

    # Daemon alive — inspect each of its sidecars. If any sidecar is stale or
    # its owner is dead, the daemon is no longer authoritative.
    interval = max(_wait_int_env("RELAY_HEARTBEAT_INTERVAL", 10), 1)
    factor = max(_wait_int_env("RELAY_HEARTBEAT_STALE_FACTOR", 3), 1)
    sidecar_stale_threshold = max(interval * factor, 60)
    cutoff = time.time() - sidecar_stale_threshold

    drafts = _heartbeat_drafts_for_author(session, author)
    if not drafts:
        # The pidfile points at a live PID, but relay has no heartbeat sidecar
        # proving that PID is ours. This is the PID-reuse/stale-pidfile shape:
        # clear only relay-owned files and never signal the unrelated process.
        time.sleep(0.1)
        drafts = _heartbeat_drafts_for_author(session, author)
        if not drafts:
            _heartbeat_purge_files_only(session, author, pidfile)
            return

    for draft in drafts:
        sidecar = _heartbeat_sidecar_path(draft)
        try:
            stat = sidecar.stat()
        except OSError:
            continue
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            data = {}
        sidecar_stale = stat.st_mtime < cutoff
        owner_kind = data.get("owner_kind") or "none"
        owner_alive = _owner_alive(
            owner_kind,
            owner_pid=data.get("owner_pid"),
            owner_pidfile=data.get("owner_pidfile"),
            owner_renewal_file=data.get("owner_renewal_file"),
        )
        if sidecar_stale or not owner_alive:
            _heartbeat_purge(session, author, pidfile, pid=pid)
            return  # purge clears every sidecar at once; one bad sidecar tears it all down


def _heartbeat_purge(session: Path, author: str, pidfile: Path,
                      pid: Optional[int]) -> None:
    """Kill daemon if alive, remove pidfile + sidecars."""
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.monotonic() + 1.0
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.05)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    _heartbeat_purge_files_only(session, author, pidfile)


def _heartbeat_purge_files_only(session: Path, author: str, pidfile: Path) -> None:
    """Remove relay-owned heartbeat files without signaling any PID."""
    try:
        pidfile.unlink()
    except OSError:
        pass
    for draft in _heartbeat_drafts_for_author(session, author):
        try:
            _heartbeat_sidecar_path(draft).unlink()
        except OSError:
            pass
    try:
        env = load_env()
        d = _renewal_dir_for(derive_project(env), session.name, author)
    except SystemExit:
        d = None
    if d is not None and d.is_dir():
        for renewal_file in d.glob("*.renewal"):
            try:
                renewal_file.unlink()
            except OSError:
                pass



def cmd_heartbeat_start(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat start: RELAY_AUTHOR not set", file=sys.stderr)
        return 2
    if args.owner_kind not in OWNER_KINDS:
        print(
            f"relay heartbeat start: --owner-kind must be one of "
            f"{sorted(OWNER_KINDS)}, got {args.owner_kind!r}",
            file=sys.stderr,
        )
        return 2

    draft_path = Path(args.draft).resolve()
    if not draft_path.is_file() or draft_path.parent.name != ".draft":
        print(f"relay heartbeat start: --draft must point to a .draft/ file: {draft_path}",
              file=sys.stderr)
        return 2
    # Draft filename must encode an author that matches RELAY_AUTHOR; otherwise
    # the heartbeat would attach to someone else's in-flight work.
    m = _DRAFT_NAME_RE.match(draft_path.name)
    if not m:
        print(f"relay heartbeat start: malformed draft name: {draft_path.name}",
              file=sys.stderr)
        return 2
    draft_author = m.group(2)
    if draft_author != env.author:
        print(
            f"relay heartbeat start: draft author {draft_author!r} does not match "
            f"RELAY_AUTHOR {env.author!r}",
            file=sys.stderr,
        )
        return 2
    session = draft_path.parent.parent

    # Validate owner combination.
    if args.owner_kind in {"agent", "tool-process"} and args.owner_pid is None:
        print(f"relay heartbeat start: --owner-kind {args.owner_kind} requires --owner-pid",
              file=sys.stderr)
        return 2
    if args.owner_kind == "pidfile" and not args.owner_pidfile:
        print("relay heartbeat start: --owner-kind pidfile requires --owner-pidfile",
              file=sys.stderr)
        return 2
    if args.owner_kind == "renewal-file":
        # Scoped renewal path is ALWAYS derived internally — callers cannot pass
        # one in (per spec, prevents cross-session false-alive bypass).
        derived = _renewal_path_for_draft(draft_path, session, env)
        if derived is None:
            print(
                "relay heartbeat start: cannot derive renewal path "
                "(RELAY_PROJECT or RELAY_AUTHOR unset); set RELAY_PROJECT "
                "or run inside a git repo with RELAY_AUTHOR set.",
                file=sys.stderr,
            )
            return 2
        derived.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        # Seed the renewal file so the daemon's first owner-alive check passes.
        if not derived.exists():
            derived.touch(mode=0o600)
        else:
            os.utime(derived, None)
        args.owner_renewal_file = str(derived)

    # Immediate owner-alive check; refuse if dead at start.
    if args.owner_kind != "none":
        alive = _owner_alive(
            args.owner_kind,
            owner_pid=args.owner_pid,
            owner_pidfile=args.owner_pidfile,
            owner_renewal_file=getattr(args, "owner_renewal_file", None),
        )
        if not alive:
            print(
                f"relay heartbeat start: owner not alive at start "
                f"(kind={args.owner_kind}, pid={args.owner_pid}, "
                f"pidfile={args.owner_pidfile}); verify --owner-pid / "
                "--owner-pidfile points at a live process, or rerun "
                "with --owner-kind renewal-file (recommended for SKILL usage).",
                file=sys.stderr,
            )
            return 2

    pidfile = _heartbeat_pidfile_path(session, env.author)
    pidfile.parent.mkdir(parents=True, exist_ok=True)
    running, _existing_pid = _heartbeat_is_running(pidfile)
    if running:
        print(
            f"relay heartbeat start: heartbeat already running for {env.author} "
            f"(pidfile {pidfile}); run `relay heartbeat stop --force` to "
            "clear it, or `relay doctor` to inspect.",
            file=sys.stderr,
        )
        return 3

    # Seed sidecar JSON.
    sidecar = _heartbeat_sidecar_path(draft_path)
    payload = {
        "heartbeat_pid": None,  # filled by daemon
        "owner_pid": args.owner_pid,
        "owner_kind": args.owner_kind,
        "owner_pidfile": args.owner_pidfile,
        "owner_renewal_file": getattr(args, "owner_renewal_file", None),
        "host": os.uname().nodename,
        "author": env.author,
        "draft": draft_path.name,
        "started_at": now_iso(),
        "last_beat": now_iso(),
    }
    atomic_write_text(sidecar, json.dumps(payload, indent=2) + "\n", mode=0o600)

    interval = args.interval if args.interval is not None else _wait_int_env(
        "RELAY_HEARTBEAT_INTERVAL", 10
    )
    pid = _spawn_heartbeat_daemon(
        sidecar, pidfile,
        args.owner_kind, args.owner_pid, args.owner_pidfile,
        getattr(args, "owner_renewal_file", None),
        interval,
    )
    if pid <= 0:
        sidecar.unlink(missing_ok=True)
        print("relay heartbeat start: failed to spawn daemon", file=sys.stderr)
        return 2

    # Wait briefly for the daemon to write its pidfile.
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if pidfile.exists():
            break
        time.sleep(0.05)

    # Patch sidecar with the actual daemon pid (best-effort).
    try:
        payload["heartbeat_pid"] = pid
        atomic_write_text(sidecar, json.dumps(payload, indent=2) + "\n", mode=0o600)
    except OSError:
        pass

    print(pid)
    return 0


def cmd_heartbeat_stop(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat stop: RELAY_AUTHOR not set", file=sys.stderr)
        return 2

    draft_arg = getattr(args, "draft", None)
    if draft_arg:
        draft_path = Path(draft_arg).resolve()
        if draft_path.parent.name != ".draft":
            print(f"relay heartbeat stop: --draft must point under .draft/: {draft_path}",
                  file=sys.stderr)
            return 2
        session = draft_path.parent.parent
    else:
        try:
            session = resolve_active_session(
                env,
                getattr(args, "project", None),
                getattr(args, "session_id", None),
            )
        except SystemExit as exc:
            print(f"relay heartbeat stop: {exc}", file=sys.stderr)
            return 2
        draft_path = None

    pidfile = _heartbeat_pidfile_path(session, env.author)
    if not pidfile.exists() and not args.force:
        # Nothing to do; considered success.
        return 0

    running, pid = _heartbeat_is_running(pidfile)
    if running and pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        # Wait briefly then SIGKILL if still alive.
        deadline = time.monotonic() + 2.0
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.1)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass

    # Remove pidfile.
    try:
        pidfile.unlink()
    except OSError:
        pass
    # Remove sidecar(s) and renewal file(s).
    if draft_path is not None:
        try:
            _heartbeat_sidecar_path(draft_path).unlink()
        except OSError:
            pass
        renewal = _renewal_path_for_draft(draft_path, session, env)
        if renewal is not None:
            try:
                renewal.unlink()
            except OSError:
                pass
    else:
        for draft in _heartbeat_drafts_for_author(session, env.author):
            try:
                _heartbeat_sidecar_path(draft).unlink()
            except OSError:
                pass
        d = _renewal_dir(session, env)
        if d is not None and d.is_dir():
            for f in d.glob("*.renewal"):
                try:
                    f.unlink()
                except OSError:
                    pass
    return 0


# ---------------------------------------------------------------------------
# Stage 3: renewal protocol
#
# Renewal files live locally on each side (not in .shared/, since sshfs
# attribute caching is exactly what mtime-based renewal must not depend on).
# Path scope: $XDG_RUNTIME_DIR/relay/<project>/<session>/<author>/<draft>.renewal
#
# Each session-scoped relay subcommand auto-ticks the renewal file(s) for the
# current author in the resolved session. As long as the SKILL keeps making
# relay calls, the renewal stays fresh; when the SKILL stops (e.g. user Ctrl-C
# mid-think), the renewal goes stale, the heartbeat daemon sees its owner is
# dead (via _owner_alive(renewal-file)), and stops touching the shared
# heartbeat sidecar. Peer's `wait` then detects the stale heartbeat → exit 11.
# ---------------------------------------------------------------------------

_tick_in_flight = False  # recursion guard for auto-tick at subcommand entries


def _renewal_dir_for(project: Optional[str], session_id: str, author: str) -> Optional[Path]:
    """Resolve the local renewal directory. Returns None if project/author is unknown."""
    if not project or not author or not session_id:
        return None
    base = (
        os.environ.get("XDG_RUNTIME_DIR")
        or os.environ.get("TMPDIR")
        or "/tmp"
    )
    return Path(base) / "relay" / project / session_id / author


def _renewal_dir(session: Path, env: Env) -> Optional[Path]:
    return _renewal_dir_for(derive_project(env), session.name, env.author or "")


def _renewal_path_for_draft(draft_path: Path, session: Path, env: Env) -> Optional[Path]:
    d = _renewal_dir(session, env)
    if d is None:
        return None
    # draft_path is like 001-claude-plan.md; strip .md for the renewal basename.
    return d / f"{draft_path.stem}.renewal"


def _maybe_tick_renewal(session: Path, env: Env) -> None:
    """Best-effort: refresh all renewal files in the current session/author scope."""
    global _tick_in_flight
    if _tick_in_flight:
        return
    d = _renewal_dir(session, env)
    if d is None or not d.is_dir():
        return
    _tick_in_flight = True
    try:
        for renewal_file in d.glob("*.renewal"):
            try:
                os.utime(renewal_file, None)
            except OSError:
                pass
    finally:
        _tick_in_flight = False


def _gc_renewal_orphans(session: Path, env: Env) -> None:
    """Remove renewal files whose corresponding heartbeat sidecar is gone."""
    d = _renewal_dir(session, env)
    if d is None or not d.is_dir():
        return
    active_basenames = {
        draft.stem for draft in _heartbeat_drafts_for_author(session, env.author or "")
    }
    for renewal_file in d.glob("*.renewal"):
        if renewal_file.stem not in active_basenames:
            try:
                renewal_file.unlink()
            except OSError:
                pass


def cmd_heartbeat_tick(args) -> int:
    env = load_env()
    if not env.author:
        print("relay heartbeat tick: RELAY_AUTHOR not set", file=sys.stderr)
        return 2
    try:
        session = resolve_active_session(
            env,
            getattr(args, "project", None),
            getattr(args, "session_id", None),
        )
    except SystemExit as exc:
        print(f"relay heartbeat tick: {exc}", file=sys.stderr)
        return 2
    _maybe_tick_renewal(session, env)
    return 0


# ---------------------------------------------------------------------------
# cmd_wait — block until peer publishes a new artifact targeting this author
# ---------------------------------------------------------------------------

# Exit codes (see decision artifact 20260528-stage3-renewal-design seq 9 §3.1):
#   0   new .ready targeted at me; stdout = absolute artifact path
#   10  timeout (RELAY_WAIT_TIMEOUT seconds elapsed)
#   11  peer heartbeat stale (Stage 2/3 only; never emitted in Stage 1)
#   12  session entered terminal state; stdout = one-line status
#   130 SIGINT (shell convention: 128 + 2)
#   2   protocol / mount / env / collision error; stderr = error message


def _wait_int_env(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw == "":
        return default
    try:
        v = int(raw)
    except ValueError:
        return default
    return v


_DURATION_RE = re.compile(r"^(\d+)([smhd])$")


def _parse_duration(s: str) -> Optional[int]:
    """Parse '1h', '30m', '1d', '7200s' -> seconds. Returns None on invalid."""
    m = _DURATION_RE.match(s.strip())
    if not m:
        return None
    n = int(m.group(1))
    mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
    return n * mult


def cmd_doctor(args) -> int:
    """Report stale relay state; optionally clean owner-safe junk + abandoned drafts.

    Exit codes:
      0 — no findings
      1 — findings reported (whether or not --fix ran)
      2 — protocol/env error
    """
    env = load_env()
    if not env.shared_root or not env.shared_root.is_dir():
        print("relay doctor: RELAY_SHARED_ROOT not set or missing", file=sys.stderr)
        return 2

    older_than_secs: Optional[int] = None
    if getattr(args, "older_than", None):
        older_than_secs = _parse_duration(args.older_than)
        if older_than_secs is None:
            print(
                f"relay doctor: invalid --older-than {args.older_than!r}; "
                "use '<n>s|m|h|d' (e.g. 1h, 30m, 1d).",
                file=sys.stderr,
            )
            return 2
        if not args.fix:
            print(
                "relay doctor: --older-than has no effect without --fix; "
                "drop --older-than for a report-only run.",
                file=sys.stderr,
            )
            return 2

    report = {
        "shared_root": str(env.shared_root),
        "author": env.author,
        "sessions": [],
        "actions": [],
        "findings_count": 0,
    }
    actions: list[str] = report["actions"]
    findings = 0

    for sd in iter_session_dirs(env.shared_root):
        entry = {
            "session_id": sd.name,
            "is_active": session_is_active(sd),
            "drafts": [],
            "heartbeat_pidfile": None,
            "heartbeat_sidecars": [],
        }
        # Drafts
        draft_dir = sd / ".draft"
        if draft_dir.is_dir():
            for d in sorted(draft_dir.glob("[0-9][0-9][0-9]-*.md")):
                try:
                    age = int(time.time() - d.stat().st_mtime)
                except OSError:
                    continue
                entry["drafts"].append({"name": d.name, "age_seconds": age})
                findings += 1
        # Heartbeat (only inspect current author's lane to avoid cross-author claims)
        if env.author:
            pidfile = _heartbeat_pidfile_path(sd, env.author)
            if pidfile.exists():
                running, pid = _heartbeat_is_running(pidfile)
                entry["heartbeat_pidfile"] = {
                    "path": str(pidfile),
                    "pid": pid,
                    "alive": running,
                }
                findings += 1
                if args.fix and not running:
                    pidfile.unlink(missing_ok=True)
                    actions.append(f"removed dead pidfile {pidfile}")
            if draft_dir.is_dir():
                for sc in sorted(draft_dir.glob("*.heartbeat")):
                    try:
                        data = json.loads(sc.read_text(encoding="utf-8"))
                        if data.get("author") != env.author:
                            continue
                        age = int(time.time() - sc.stat().st_mtime)
                    except (OSError, ValueError):
                        continue
                    entry["heartbeat_sidecars"].append(
                        {"name": sc.name, "age_seconds": age}
                    )
                    findings += 1
        # Draft GC (only with --fix + --older-than).
        # Two safety constraints (codex cross-review 2026-05-29):
        #   (a) Never delete a draft whose sibling .heartbeat sidecar is
        #       fresh — the draft is still being worked on, mtime alone
        #       can lag if the author is not touching the .md file.
        #   (b) When a draft IS deleted, also unlink its .heartbeat sidecar
        #       so `relay wait` does not later observe a stale peer
        #       heartbeat and return exit 11.
        if args.fix and older_than_secs is not None and draft_dir.is_dir():
            hb_fresh_threshold = max(
                _wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60
            )
            for d in sorted(draft_dir.glob("[0-9][0-9][0-9]-*.md")):
                try:
                    age = int(time.time() - d.stat().st_mtime)
                except OSError:
                    continue
                if age < older_than_secs:
                    continue
                sidecar = _heartbeat_sidecar_path(d)
                if sidecar.exists():
                    try:
                        hb_age = time.time() - sidecar.stat().st_mtime
                    except OSError:
                        hb_age = float("inf")
                    if hb_age < hb_fresh_threshold:
                        actions.append(
                            f"skipped {d}: heartbeat sidecar is fresh "
                            f"({int(hb_age)}s < {hb_fresh_threshold}s)"
                        )
                        continue
                try:
                    d.unlink()
                    actions.append(f"deleted abandoned draft {d}")
                except OSError as exc:
                    actions.append(f"failed to delete draft {d}: {exc}")
                    continue
                if sidecar.exists():
                    try:
                        sidecar.unlink()
                        actions.append(f"removed stale heartbeat sidecar {sidecar}")
                    except OSError as exc:
                        actions.append(
                            f"failed to remove heartbeat sidecar {sidecar}: {exc}"
                        )
        report["sessions"].append(entry)

    report["findings_count"] = findings

    if getattr(args, "json", False):
        print(json.dumps(report, indent=2))
    else:
        _print_doctor_text(report, fix=bool(args.fix))

    return 1 if findings > 0 else 0


def _print_doctor_text(report: dict, *, fix: bool) -> None:
    print(f"relay doctor :: {report['shared_root']}")
    print(f"  author: {report['author'] or '(unset)'}")
    if not report["sessions"]:
        print("  no sessions found.")
        return
    for s in report["sessions"]:
        marker = "[active]" if s["is_active"] else "[inactive]"
        print(f"\n  session {marker}: {s['session_id']}")
        if s["drafts"]:
            print("    drafts (.draft/):")
            for d in s["drafts"]:
                print(f"      - {d['name']}  age={d['age_seconds']}s")
        hp = s["heartbeat_pidfile"]
        if hp:
            tag = "alive" if hp["alive"] else "DEAD"
            print(f"    heartbeat pidfile: pid={hp['pid']} ({tag})  {hp['path']}")
        if s["heartbeat_sidecars"]:
            print("    heartbeat sidecars:")
            for sc in s["heartbeat_sidecars"]:
                print(f"      - {sc['name']}  age={sc['age_seconds']}s")
    if report["actions"]:
        print("\n  actions taken:")
        for a in report["actions"]:
            print(f"    - {a}")
    print(f"\nsummary: {report['findings_count']} findings"
          f"{' (fix applied)' if fix else ''}")


def cmd_wait(args) -> int:
    env = load_env()
    if not env.author:
        print("relay wait: RELAY_AUTHOR not set", file=sys.stderr)
        return 2

    try:
        session = resolve_active_session(
            env,
            getattr(args, "project", None),
            getattr(args, "session_id", None),
        )
    except SystemExit as exc:
        msg = str(exc)
        hint = ""
        if "no active session" in msg:
            hint = " — run `relay sessions list` to see existing sessions, or `relay bootstrap --topic <slug>` to start a new one."
        elif "multiple active sessions" in msg:
            hint = " — pass `--session-id <id>` to disambiguate."
        print(f"relay wait: {msg}{hint}", file=sys.stderr)
        return 2
    _gc_heartbeat_orphans(session, env.author)
    _gc_renewal_orphans(session, env)
    _maybe_tick_renewal(session, env)

    cli_timeout = getattr(args, "timeout", None)
    cli_no_timeout = bool(getattr(args, "no_timeout", False))
    cli_poll = getattr(args, "poll", None)
    if cli_no_timeout:
        timeout = None  # sentinel: skip nominal deadline; stale-heartbeat escape remains
    else:
        timeout = cli_timeout if cli_timeout is not None else _wait_int_env("RELAY_WAIT_TIMEOUT", 3600)
        if timeout < 0:
            timeout = 0
    poll = cli_poll if cli_poll is not None else _wait_int_env("RELAY_WAIT_POLL_INTERVAL", 2)
    if poll <= 0:
        poll = 1

    def _terminal_exit() -> int:
        fm = latest_artifact_frontmatter(session)
        status = (fm or {}).get("status") or "closed"
        print(status)
        return 12

    # Entry: if the latest artifact is already targeting me, return it immediately.
    pub_entry = list_published(session)
    if pub_entry:
        try:
            fm_last, _ = parse_frontmatter(pub_entry[-1].read_text(encoding="utf-8"))
        except (OSError, ValueError):
            fm_last = None
        if fm_last and fm_last.get("peer") == env.author:
            print(pub_entry[-1])
            return 0
    # Finding 1: baseline must exclude in-flight peer drafts, otherwise a
    # peer publishing the same seq they had open at wait entry is filtered.
    baseline_seq = latest_published_seq(session)

    if not session_is_active(session):
        return _terminal_exit()

    # Stage 3 wait policy:
    #   - No peer renewal-file heartbeat is visible → use nominal timeout
    #     (returns exit 10 if no peer artifact arrives in time).
    #   - Peer renewal-file heartbeat IS visible at any point during the loop →
    #     defer to its mtime as the liveness signal. Stale heartbeat → exit 11.
    #     Fresh heartbeat → keep polling (no nominal timeout while peer is alive).
    #
    # Detection must be DYNAMIC inside the loop: peer typically starts the
    # heartbeat after we already entered wait, so a once-only snapshot at entry
    # would miss it.
    stale_threshold = max(_wait_int_env("RELAY_RENEWAL_STALE_THRESHOLD", 3600), 60)
    nominal_deadline = None if timeout is None else time.monotonic() + timeout

    # Optional readiness sentinel for tests / supervisors that need to know
    # the poll loop has been reached (e.g. to send SIGINT reliably without
    # a `time.sleep()` race). Unset in normal operation.
    ready_sentinel = os.environ.get("RELAY_WAIT_READY_SENTINEL")
    if ready_sentinel:
        try:
            Path(ready_sentinel).touch()
        except OSError:
            pass  # best-effort signal; not protocol-critical

    try:
        while True:
            for pub in list_published(session):
                m = _DRAFT_NAME_RE.match(pub.name)
                if not m:
                    continue
                seq = int(m.group(1))
                if seq <= baseline_seq:
                    continue
                try:
                    fm, _body = parse_frontmatter(pub.read_text(encoding="utf-8"))
                except (OSError, ValueError):
                    continue
                if fm.get("peer") == env.author:
                    print(pub)
                    return 0
                baseline_seq = max(baseline_seq, seq)

            if not session_is_active(session):
                return _terminal_exit()

            # Dynamic peer-heartbeat detection: re-check every iteration.
            has_renewal_file_peer = _peer_has_renewal_file_heartbeat(
                session, env.peer or ""
            )
            if has_renewal_file_peer:
                if _peer_heartbeat_is_stale(session, env.peer or "", stale_threshold):
                    return 11
                # heartbeat is fresh → keep polling, ignore nominal timeout
            else:
                # No peer heartbeat seen yet → honor nominal timeout
                # unless --no-timeout was passed (nominal_deadline is None).
                if nominal_deadline is not None and time.monotonic() >= nominal_deadline:
                    return 10

            time.sleep(poll)
    except KeyboardInterrupt:
        return 130


def _peer_heartbeat_sidecars(session: Path, peer: str) -> list[Path]:
    """List heartbeat sidecars (`.draft/*.heartbeat`) belonging to peer."""
    if not peer:
        return []
    draft_dir = session / ".draft"
    if not draft_dir.is_dir():
        return []
    out: list[Path] = []
    for sidecar in draft_dir.glob("*.heartbeat"):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("author") == peer:
            out.append(sidecar)
    return out


def _peer_has_renewal_file_heartbeat(session: Path, peer: str) -> bool:
    for sidecar in _peer_heartbeat_sidecars(session, peer):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("owner_kind") == "renewal-file":
            return True
    return False


def _peer_heartbeat_is_stale(session: Path, peer: str, threshold: int) -> bool:
    """Stale-renewal detection: only renewal-file kind sidecars count.

    Spec restricts wait exit 11 to a stale peer owner_kind=renewal-file heartbeat;
    pid-based or `none` sidecars must not trigger it.
    """
    cutoff = time.time() - threshold
    for sidecar in _peer_heartbeat_sidecars(session, peer):
        try:
            data = json.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if data.get("owner_kind") != "renewal-file":
            continue
        try:
            mtime = sidecar.stat().st_mtime
        except OSError:
            continue
        if mtime < cutoff:
            return True
    return False


# ---------------------------------------------------------------------------
# hooks subcommand — install/manage cross-platform hook integration
# ---------------------------------------------------------------------------

HOOKS_DIR = RELAY_PACKAGE_DIR / "hooks"
HOOK_SCRIPT = HOOKS_DIR / "relay-hook.py"
HOOK_FRAGMENT_CLAUDE = HOOKS_DIR / "install-targets" / "claude-settings-fragment.json"
HOOK_FRAGMENT_CODEX = HOOKS_DIR / "install-targets" / "codex-hooks-fragment.json"
HOOK_MANAGED_MARKER = "_agent_relay_managed"
HOOK_EVENTS = ("SessionStart", "PreToolUse", "Stop")


def _hooks_target_path(target: str) -> Path:
    if target == "claude":
        return Path.home() / ".claude" / "settings.json"
    if target == "codex":
        return Path.home() / ".codex" / "hooks.json"
    raise ValueError(f"unknown hooks target: {target}")


def _hooks_render_command() -> str:
    """Render the hook command as `<python> <script>` with both args shell-quoted.

    Codex spawns hooks with a stripped PATH (no /usr/bin), so the `#!/usr/bin/env
    python3` shebang on relay-hook.py can't resolve `python3` and the host
    reports exit 127. Embedding `sys.executable` as an absolute path makes the
    command PATH-independent. The same form is fine for Claude Code.
    """
    return shlex.quote(sys.executable) + " " + shlex.quote(str(HOOK_SCRIPT))


def _hooks_load_fragment(target: str) -> dict:
    path = HOOK_FRAGMENT_CLAUDE if target == "claude" else HOOK_FRAGMENT_CODEX
    raw = path.read_text(encoding="utf-8")
    raw = raw.replace("{RELAY_HOOK_COMMAND}", _hooks_render_command())
    return json.loads(raw)


def _hooks_read_config(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"relay hooks: cannot parse {path}: {exc}")


def _hooks_strip_managed(config: dict) -> dict:
    """Return config with all `_agent_relay_managed` entries removed."""
    hooks = config.get("hooks")
    if not isinstance(hooks, dict):
        return config
    for event, entries in list(hooks.items()):
        if not isinstance(entries, list):
            continue
        kept = [e for e in entries if not (isinstance(e, dict) and e.get(HOOK_MANAGED_MARKER))]
        if kept:
            hooks[event] = kept
        else:
            del hooks[event]
    if not hooks:
        config.pop("hooks", None)
    return config


def _hooks_merge(config: dict, fragment: dict) -> tuple[dict, list[str]]:
    """Append-after merge: managed entries land at the END of each event array.

    Existing entries (oh-my-codex etc.) keep their position and trust key
    indices. Returns (new_config, summary_lines).
    """
    summary: list[str] = []
    config = _hooks_strip_managed(config)  # idempotent: drop previous-version managed
    target_hooks = config.setdefault("hooks", {})
    frag_hooks = fragment.get("hooks", {})
    for event in HOOK_EVENTS:
        new_entries = frag_hooks.get(event, [])
        if not new_entries:
            continue
        existing = target_hooks.get(event, [])
        if not isinstance(existing, list):
            existing = []
        merged = existing + new_entries  # append-after
        target_hooks[event] = merged
        summary.append(
            f"  {event}: appended at index {len(existing)} "
            f"(existing entries: {len(existing)})"
        )
    return config, summary


def _hooks_atomic_write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    atomic_write_text(path, text, mode=0o600)


def cmd_hooks_install(args) -> int:
    if not HOOK_SCRIPT.exists():
        print(f"relay hooks: dispatcher missing at {HOOK_SCRIPT}", file=sys.stderr)
        return 2
    if not os.access(HOOK_SCRIPT, os.X_OK):
        print(f"relay hooks: dispatcher is not executable: {HOOK_SCRIPT}\n"
              f"  fix: chmod +x {HOOK_SCRIPT}", file=sys.stderr)
        return 2

    targets = ["claude", "codex"] if args.target == "both" else [args.target]
    for target in targets:
        cfg_path = _hooks_target_path(target)
        fragment = _hooks_load_fragment(target)
        existing = _hooks_read_config(cfg_path)
        merged, summary = _hooks_merge(existing, fragment)

        print(f"target: {target}  ({cfg_path})")
        if args.dry_run:
            print("  (dry-run; no changes written)")
        else:
            _hooks_atomic_write_json(cfg_path, merged)
        for line in summary:
            print(line)

    print()
    print("Next steps:")
    print(f"  • dispatcher: {HOOK_SCRIPT}")
    print("  • Claude Code: hooks take effect at the next session start")
    if "codex" in targets:
        print("  • Codex CLI: run `codex`, then `/hooks` and trust the new")
        print("    `agent-relay` entries (each event needs trust once)")
    print("  • inspect: `relay hooks status`  /  `relay hooks doctor`")
    return 0


def cmd_hooks_uninstall(args) -> int:
    targets = ["claude", "codex"] if args.target == "both" else [args.target]
    for target in targets:
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"target: {target}  (no config at {cfg_path}; skipped)")
            continue
        cfg = _hooks_read_config(cfg_path)
        stripped = _hooks_strip_managed(cfg)
        if args.dry_run:
            print(f"target: {target}  ({cfg_path})  (dry-run)")
        else:
            _hooks_atomic_write_json(cfg_path, stripped)
            print(f"target: {target}  ({cfg_path})  removed managed entries")
    return 0


def _hooks_count_managed(config: dict) -> dict[str, int]:
    out: dict[str, int] = {}
    hooks = config.get("hooks", {})
    if not isinstance(hooks, dict):
        return out
    for event, entries in hooks.items():
        if not isinstance(entries, list):
            continue
        n = sum(1 for e in entries if isinstance(e, dict) and e.get(HOOK_MANAGED_MARKER))
        if n:
            out[event] = n
    return out


def cmd_hooks_doctor(args) -> int:
    findings = 0
    print(f"relay hooks doctor (dispatcher: {HOOK_SCRIPT})")
    if not HOOK_SCRIPT.exists():
        print("  [fail] dispatcher missing"); findings += 1
    elif not os.access(HOOK_SCRIPT, os.X_OK):
        print("  [fail] dispatcher not executable"); findings += 1
    else:
        print("  [ok]   dispatcher present + executable")

    for target in ("claude", "codex"):
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"  [--]   {target}: no config ({cfg_path})")
            continue
        cfg = _hooks_read_config(cfg_path)
        counts = _hooks_count_managed(cfg)
        if not counts:
            print(f"  [--]   {target}: no managed entries in {cfg_path}")
            continue
        missing = [e for e in HOOK_EVENTS if e not in counts]
        if missing:
            print(f"  [warn] {target}: managed entries present but missing events: "
                  f"{', '.join(missing)}")
            findings += 1
        else:
            print(f"  [ok]   {target}: managed entries for {', '.join(HOOK_EVENTS)}")
        # Codex trust hint
        if target == "codex":
            state = cfg.get("state", {})
            if isinstance(state, dict):
                trusted = sum(1 for k in state if "agent_relay" in k or HOOK_MANAGED_MARKER in k)
                if trusted == 0:
                    print(f"  [hint] codex: run `/hooks` in codex CLI to trust new entries")
    return 0 if findings == 0 else 1


def cmd_hooks_status(args) -> int:
    print(f"relay hooks status (dispatcher: {HOOK_SCRIPT})")
    print(f"  exists={HOOK_SCRIPT.exists()}  executable={os.access(HOOK_SCRIPT, os.X_OK)}")
    for target in ("claude", "codex"):
        cfg_path = _hooks_target_path(target)
        if not cfg_path.exists():
            print(f"  {target}: (no config)")
            continue
        cfg = _hooks_read_config(cfg_path)
        counts = _hooks_count_managed(cfg)
        print(f"  {target}: managed entries = {dict(counts) if counts else '{}'}")

    env = load_env()
    if env.shared_root:
        trail = env.shared_root / "_relay" / "hook-trail.log"
        if trail.exists():
            print()
            print(f"Recent hook activity ({trail}):")
            try:
                lines = trail.read_text(encoding="utf-8").splitlines()[-10:]
                for ln in lines:
                    print(f"  {ln}")
            except OSError:
                pass
    return 0


# ---------------------------------------------------------------------------
# CLI dispatch
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="relay",
        description="agent-relay file protocol CLI.")
    p.add_argument("--version", action="version", version=f"relay {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    pp = sub.add_parser("preflight", help="Check env, mount, project, FS probes.")
    pp.add_argument("--json", action="store_true")
    pp.set_defaults(func=cmd_preflight)

    pi = sub.add_parser("init", help="Idempotently create RELAY_SHARED_ROOT + sentinel.")
    pi.add_argument("--role", choices=["host", "remote", "same-host"], default=None,
                    help="`same-host` copies envrc.same-host.example to .envrc.<hostname>. "
                         "`host`/`remote` were removed in v0.6 — they now print a migration "
                         "hint and exit. Use --author/--peer/--sync for the explicit per-side "
                         "config.")
    pi.add_argument("--author", default=None,
                    help="Agent identity for this side (e.g. codex, claude). Renders "
                         ".envrc.<hostname> inline; mutually exclusive with --role same-host.")
    pi.add_argument("--peer", default=None,
                    help="Peer agent identity. Required with --author.")
    pi.add_argument("--sync", default=None, choices=["none", "rsync"],
                    help="Sync capability for this side. Defaults to 'none' when --author "
                         "is given without --sync.")
    pi.set_defaults(func=cmd_init)

    pb = sub.add_parser("bootstrap", help="Create a new session under .shared/.")
    pb.add_argument("--topic", required=True, help="Session topic slug.")
    pb.add_argument("--title", default=None, help="Human-readable title.")
    pb.add_argument("--force", action="store_true",
                    help="Allow creating a parallel active session.")
    pb.set_defaults(func=cmd_bootstrap)

    ps = sub.add_parser("status", help="Show active session status.")
    ps.add_argument("--project", default=None)
    ps.add_argument("--session-id", default=None,
                    help="Resolve a specific flat .shared/<session-id> session.")
    ps.add_argument("--last", type=int, default=0,
                     help="Show only last N published artifacts (0 = all).")
    ps.add_argument("--json", action="store_true")
    ps.set_defaults(func=cmd_status)

    pn = sub.add_parser("next-seq", help="Print next available NNN (advisory).")
    pn.add_argument("--project", default=None)
    pn.add_argument("--session-id", default=None)
    pn.set_defaults(func=cmd_next_seq)

    pc = sub.add_parser("claim", help="Scaffold a new draft artifact under .draft/.")
    pc.add_argument("--kind", required=True, choices=sorted(KINDS))
    pc.add_argument("--in-reply-to", type=int, default=None)
    pc.add_argument("--corrects", type=int, default=None,
                    help="Seq this draft supersedes; required when --kind correction. "
                         "Optional for addendum (an addendum adds info without retracting).")
    pc.add_argument("--project", default=None)
    pc.add_argument("--session-id", default=None)
    pc.set_defaults(func=cmd_claim)

    pds = sub.add_parser(
        "draft",
        help="Fill draft contents without the agent's native Write/Edit tools.",
    )
    ds_sub = pds.add_subparsers(dest="draft_cmd", required=True)
    pds_set = ds_sub.add_parser(
        "set",
        help="Update a draft's body / prompt_for_next / flags (finding 9).",
    )
    pds_set.add_argument("draft_path", help="Path to .draft/NNN-author-kind.md")
    pds_set.add_argument(
        "--body-file", default=None,
        help="Path to body content. Use '-' to read body from stdin.",
    )
    pds_set.add_argument(
        "--prompt-for-next-file", default=None,
        help="Path to prompt_for_next content. Use '-' to read from stdin.",
    )
    pds_set.add_argument(
        "--sync-needed", action="store_true",
        help="Set sync_needed: true on the draft.",
    )
    pds_set.add_argument(
        "--touched-path", action="append", default=[],
        help="Append a path to touched_paths. Repeatable; dedups.",
    )
    pds_set.add_argument(
        "--corrects", type=int, default=None,
        help="Set corrects: <seq>. Must be a positive int (validated at publish).",
    )
    pds_set.set_defaults(func=cmd_draft_set)

    pis = sub.add_parser(
        "issue",
        help="Machine-global feedback ledger for problems hit while using relay.",
    )
    is_sub = pis.add_subparsers(dest="issue_cmd", required=True)

    pia = is_sub.add_parser("add", help="Record a new issue.")
    pia.add_argument("--title", required=True, help="One-line summary.")
    pia.add_argument("--severity", default="minor", choices=sorted(ISSUE_SEVERITIES))
    pia.add_argument("--area", default="other", choices=sorted(ISSUE_AREAS))
    pia.add_argument("--body", default=None, help="Inline longer description.")
    pia.add_argument("--body-file", default=None,
                     help="Description from a file, or '-' for stdin.")
    pia.set_defaults(func=cmd_issue_add)

    pil = is_sub.add_parser("list", help="List recorded issues (default: open).")
    pil.add_argument("--status", default="open",
                     choices=sorted(ISSUE_STATUSES | {"all"}))
    pil.add_argument("--area", default=None, choices=sorted(ISSUE_AREAS))
    pil.add_argument("--json", action="store_true")
    pil.set_defaults(func=cmd_issue_list)

    pish = is_sub.add_parser("show", help="Print one issue by id (or unique prefix).")
    pish.add_argument("id")
    pish.add_argument("--json", action="store_true",
                      help="Emit {path, frontmatter, body} as JSON.")
    pish.set_defaults(func=cmd_issue_show)

    pir = is_sub.add_parser("resolve", help="Mark an issue resolved.")
    pir.add_argument("id")
    pir.add_argument("--note", default=None,
                     help="Resolution note, e.g. 'fixed in <sha>'.")
    pir.set_defaults(func=cmd_issue_resolve)

    ppub = sub.add_parser("publish", help="Validate + atomically promote a draft.")
    ppub.add_argument("draft_path", help="Path to .draft/NNN-author-kind.md")
    ppub.add_argument("--status", default=None, choices=sorted(STATUSES - {"draft"}),
                       help="Publish with this status (default: ready).")
    ppub.add_argument("--force", action="store_true",
                      help="Allow terminal publication into an inactive session.")
    ppub.add_argument("--force-reason", default=None)
    ppub.set_defaults(func=cmd_publish)

    pcl = sub.add_parser("close", help="Write CLOSED sentinel + update session.json.")
    pcl.add_argument("--reason", required=True)
    pcl.add_argument("--outcome", default=None)
    pcl.add_argument("--project", default=None)
    pcl.add_argument("--session-id", default=None)
    pcl.set_defaults(func=cmd_close)

    psessions = sub.add_parser("sessions", help="Session discovery helpers.")
    ss = psessions.add_subparsers(dest="sessions_cmd", required=True)
    psl = ss.add_parser("list", help="List all flat sessions without resolving active.")
    psl.add_argument("--json", action="store_true")
    psl.set_defaults(func=cmd_sessions_list)

    psync = sub.add_parser("sync", help="rsync wrapper (only the RELAY_SYNC=rsync side may run it).")
    psync.add_argument("direction", choices=["push", "pull"])
    psync.add_argument("--dry-run", action="store_true")
    psync.add_argument("--strict-gitignore", action="store_true",
                        help="Use git ls-files instead of rsync --filter (exact gitignore semantics).")
    psync.add_argument("--delete", action="store_true",
                        help="Pass --delete to rsync (off by default).")
    psync.set_defaults(func=cmd_sync)

    pdoc = sub.add_parser("doctor",
        help="Report stale relay state; optionally clean owner-safe junk.")
    pdoc.add_argument("--json", action="store_true",
                      help="Machine-readable report.")
    pdoc.add_argument("--fix", action="store_true",
                      help="Clean owner-safe junk (dead pidfiles). With --older-than, "
                           "also delete abandoned drafts older than the threshold.")
    pdoc.add_argument("--older-than", default=None,
                      help="Duration ('1h', '30m', '1d'). Required with --fix only "
                           "to delete drafts; ignored otherwise.")
    pdoc.set_defaults(func=cmd_doctor)

    pw = sub.add_parser("wait",
        help="Block until peer publishes a new artifact targeting this author.")
    pw.add_argument("--project", default=None)
    pw.add_argument("--session-id", default=None)
    pw_timeout = pw.add_mutually_exclusive_group()
    pw_timeout.add_argument("--timeout", type=int, default=None,
                    help="Override RELAY_WAIT_TIMEOUT (default 3600s).")
    pw_timeout.add_argument("--no-timeout", action="store_true",
                    help="Disable the nominal no-heartbeat deadline. "
                         "A stale peer renewal-file heartbeat still exits with 11.")
    pw.add_argument("--poll", type=int, default=None,
                    help="Override RELAY_WAIT_POLL_INTERVAL (default 2s).")
    pw.set_defaults(func=cmd_wait)

    phb = sub.add_parser("heartbeat", help="Owner-tied liveness daemon for a draft.")
    phs = phb.add_subparsers(dest="heartbeat_cmd", required=True)

    phb_start = phs.add_parser("start",
        help="Spawn a detached daemon that refreshes the draft heartbeat sidecar.")
    phb_start.add_argument("--draft", required=True,
        help="Path to .draft/NNN-<author>-<kind>.md")
    phb_start.add_argument("--owner-kind", required=True, choices=sorted(OWNER_KINDS),
        help="How to determine owner liveness.")
    phb_start.add_argument("--owner-pid", type=int, default=None)
    phb_start.add_argument("--owner-pidfile", default=None)
    phb_start.add_argument("--interval", type=int, default=None,
        help="Beat interval in seconds (default RELAY_HEARTBEAT_INTERVAL=10).")
    phb_start.set_defaults(func=cmd_heartbeat_start)

    phb_stop = phs.add_parser("stop",
        help="Terminate the heartbeat daemon and remove its files.")
    phb_stop.add_argument("--draft", default=None,
        help="Optional draft path; if omitted, all sidecars for current author are cleared.")
    phb_stop.add_argument("--project", default=None)
    phb_stop.add_argument("--session-id", default=None)
    phb_stop.add_argument("--force", action="store_true",
        help="Remove files even if no daemon is running.")
    phb_stop.set_defaults(func=cmd_heartbeat_stop)

    phb_tick = phs.add_parser("tick",
        help="Refresh the local renewal file mtime so the daemon sees the owner alive.")
    phb_tick.add_argument("--project", default=None)
    phb_tick.add_argument("--session-id", default=None)
    phb_tick.set_defaults(func=cmd_heartbeat_tick)

    pho = sub.add_parser("hooks",
        help="Install/manage cross-platform hook integration (Claude Code + Codex CLI).")
    phos = pho.add_subparsers(dest="hooks_cmd", required=True)

    pho_install = phos.add_parser("install",
        help="Append agent-relay hooks to Claude settings.json and/or Codex hooks.json.")
    pho_install.add_argument("--target", choices=("claude", "codex", "both"), default="both")
    pho_install.add_argument("--dry-run", action="store_true")
    pho_install.set_defaults(func=cmd_hooks_install)

    pho_uninstall = phos.add_parser("uninstall",
        help="Remove agent-relay managed hook entries.")
    pho_uninstall.add_argument("--target", choices=("claude", "codex", "both"), default="both")
    pho_uninstall.add_argument("--dry-run", action="store_true")
    pho_uninstall.set_defaults(func=cmd_hooks_uninstall)

    pho_doctor = phos.add_parser("doctor",
        help="Verify hook dispatcher + config wiring + trust state.")
    pho_doctor.set_defaults(func=cmd_hooks_doctor)

    pho_status = phos.add_parser("status",
        help="Show hook install state + recent activity from hook-trail.log.")
    pho_status.set_defaults(func=cmd_hooks_status)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    # Top-level SIGINT guard: codex seq 8 observed tracebacks when SIGINT
    # arrived during early CLI startup (argparse build) before any command
    # handler installed its own KeyboardInterrupt catcher. Exit cleanly with
    # 130 (128 + SIGINT) so the protocol contract holds anywhere in the
    # process lifetime, not just inside `cmd_wait`.
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
